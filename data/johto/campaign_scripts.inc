	goto_if_ne JOHTO_VAR_RESULT, PARTY_SIZE, Johto_SafariZoneGate_SafariZoneEntrance_SafariZoneGate_SafariZoneEntrance_EventScript_HasRoomForPokemon
	specialvar JOHTO_VAR_RESULT, ScriptCheckFreePokemonStorageSpace
	goto_if_eq JOHTO_VAR_RESULT, 1, Johto_SafariZoneGate_SafariZoneEntrance_SafariZoneGate_SafariZoneEntrance_EventScript_HasRoomForPokemon
	msgbox Route121_SafariZoneEntrance_Text_PCIsFull, MSGBOX_DEFAULT
	goto Johto_SafariZoneGate_SafariZoneEntrance_SafariZoneGate_SafariZoneEntrance_EventScript_MovePlayerBackFromCounter
	end

