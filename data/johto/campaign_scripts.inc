	call_if_eq JOHTO_VAR_NEWBARK_TOWN_STATE, 2, Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_SetMomStandingAtTable
	call_if_eq JOHTO_VAR_NEWBARK_TOWN_STATE, 3, Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_SetMomStandingAtTable
	end

Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_SetMomStandingAtTable::
	setobjectxyperm Johto_NewBarkTown_PlayersHouse_1F_LOCALID_MOM, 8, 4
	setobjectmovementtype Johto_NewBarkTown_PlayersHouse_1F_LOCALID_MOM, MOVEMENT_TYPE_FACE_LEFT

	@add to newgame later
	clearflag JOHTO_FLAG_HIDE_MOMS_FRIEND
	clearflag JOHTO_FLAG_MOM_VISITED
	return

Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_EventScript_Mom::
	lock
	faceplayer
	goto_if_set JOHTO_FLAG_MOM_VISITED, Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_EventScript_Mom_Regular
	goto_if_set JOHTO_FLAG_ADVENTURE_STARTED, Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_MomEventScript_GoodLuck
	msgbox Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_Text_MomHurryUpElmIsWaiting, MSGBOX_DEFAULT
	applymovement Johto_NewBarkTown_PlayersHouse_1F_LOCALID_MOM, Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_MovementFaceLeft
	waitmovement 0
	release
	end

Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_EventScript_MomsFriend::
	lock
	faceplayer
	msgbox Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_Text_MomsFriend, MSGBOX_DEFAULT
	applymovement Johto_NewBarkTown_PlayersHouse_1F_LOCALID_MOMS_FRIEND, Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_MovementFaceRight
	waitmovement 0
