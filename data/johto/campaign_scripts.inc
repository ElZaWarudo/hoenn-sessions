Johto_Route30_MrPokemonsHouse_MrPokemonHouse_EventScript_GiveEgg::
	lock
	playse SE_PIN
	applymovement Johto_Route30_MrPokemonsHouse_LOCALID_MRPOKEMON, Common_Movement_ExclamationMark
	delay 60
	turnobject Johto_Route30_MrPokemonsHouse_LOCALID_MRPOKEMON, DIR_SOUTH
	msgbox Johto_Route30_MrPokemonsHouse_MrPokemonHouse_Text_Intro1, MSGBOX_DEFAULT
	closemessage
	applymovement OBJ_EVENT_ID_PLAYER, Johto_Route30_MrPokemonsHouse_MrPokemonHouse_Movement_MeetMrPokemon
	waitmovement 0
	msgbox Johto_Route30_MrPokemonsHouse_MrPokemonHouse_Text_Intro2, MSGBOX_DEFAULT

	giveitem ITEM_MYSTERY_EGG

	msgbox Johto_Route30_MrPokemonsHouse_MrPokemonHouse_Text_Intro3, MSGBOX_DEFAULT
	msgbox Johto_Route30_MrPokemonsHouse_MrPokemonHouse_Text_Intro4, MSGBOX_DEFAULT
	turnobject Johto_Route30_MrPokemonsHouse_LOCALID_ROUTE30_OAK, DIR_WEST
	msgbox Johto_Route30_MrPokemonsHouse_MrPokemonHouse_Text_Intro5, MSGBOX_DEFAULT
	closemessage
	playbgm MUS_HG_OAK, TRUE
	applymovement Johto_Route30_MrPokemonsHouse_LOCALID_ROUTE30_OAK, Johto_Route30_MrPokemonsHouse_MrPokemonHouse_Movement_OakToPlayer
	waitmovement 0
	turnobject OBJ_EVENT_ID_PLAYER, DIR_EAST
	msgbox Johto_Route30_MrPokemonsHouse_MrPokemonHouse_Text_OakIntro, MSGBOX_DEFAULT


	playfanfare MUS_OBTAIN_ITEM
	message Johto_Route30_MrPokemonsHouse_MrPokemonHouse_Text_GetDex
	waitfanfare


	msgbox Johto_Route30_MrPokemonsHouse_MrPokemonHouse_Text_OakParting MSGBOX_DEFAULT
	closemessage
	applymovement Johto_Route30_MrPokemonsHouse_LOCALID_ROUTE30_OAK, Johto_Route30_MrPokemonsHouse_MrPokemonHouse_Movement_OakLeave
	waitmovement 0
	playse SE_EXIT
	removeobject Johto_Route30_MrPokemonsHouse_LOCALID_ROUTE30_OAK
	setflag JOHTO_FLAG_DELIVERED_EGG
	turnobject OBJ_EVENT_ID_PLAYER DIR_NORTH
	fadedefaultbgm
	msgbox Johto_Route30_MrPokemonsHouse_MrPokemonHouse_Text_Heal, MSGBOX_DEFAULT
	call Common_EventScript_OutOfCenterPartyHeal
	msgbox Johto_Route30_MrPokemonsHouse_MrPokemonHouse_Text_DependingOnYou, MSGBOX_DEFAULT
	closemessage
	applymovement Johto_Route30_MrPokemonsHouse_LOCALID_MRPOKEMON, Johto_Route30_MrPokemonsHouse_MrPokemonHouse_Movement_MrPokemon_Leave
	waitmovement 0
	removeobject Johto_Route30_MrPokemonsHouse_LOCALID_MRPOKEMON
	clearflag JOHTO_FLAG_HIDE_MRPOKEMON
	addobject Johto_Route30_MrPokemonsHouse_LOCALID_MRPOKEMON2

	setvar JOHTO_VAR_NEWBARKTOWN_LABSTATE, 4
	setflag JOHTO_FLAG_HIDE_SILVER_NEWBARKTOWN
	setflag JOHTO_FLAG_SYS_POKEDEX_GET
	setvar VAR_RESULT, FALSE

	call_if_eq JOHTO_VAR_RESULT, TRUE, Johto_Route30_MrPokemonsHouse_MrPokemonHouse_EventScript_GiveNatDexRandomizer
	clearflag JOHTO_FLAG_HIDE_LAB_POLICEMAN
	setvar JOHTO_VAR_CHERRYGROVE_CITY_STATE, 2
	setrespawn HEAL_LOCATION_CHERRYGROVE_CITY
	clearflag JOHTO_FLAG_HIDE_SILVER_CHERRYGROVE
	setflag JOHTO_FLAG_HIDE_GUIDE_GENT_CHERRYGROVE
	clearflag JOHTO_FLAG_HIDE_CHERRYGROVE_GUIDE_GENT_HOUSE
	release
	end

