Johto_Route34_DayCare_Route34_EventScript_DaycareMan::
	lock
	faceplayer
	special GetDaycareMonNicknames
	specialvar JOHTO_VAR_RESULT, GetDaycareState
	goto_if_eq JOHTO_VAR_RESULT, DAYCARE_EGG_WAITING, Johto_Route34_DayCare_Route34_EventScript_DaycareEggWaiting
	goto_if_eq JOHTO_VAR_RESULT, DAYCARE_ONE_MON, Johto_Route34_DayCare_Route34_EventScript_CheckOnOneMon
	goto_if_eq JOHTO_VAR_RESULT, DAYCARE_TWO_MONS, Johto_Route34_DayCare_Route34_EventScript_CheckOnTwoMons
	msgbox Johto_Route34_DayCare_Route34_Text_SeeWifeIfYoudLikeMeToRaiseMon, MSGBOX_DEFAULT
	release
	end

Johto_Route34_DayCare_Route34_EventScript_DaycareEggWaiting::
	msgbox Johto_Route34_DayCare_Route34_Text_DoYouWantEgg, MSGBOX_YESNO
	goto_if_eq JOHTO_VAR_RESULT, YES, Johto_Route34_DayCare_Route34_EventScript_DaycareAcceptEgg
	msgbox Johto_Route34_DayCare_Route34_Text_IWillKeepDoYouWantIt, MSGBOX_YESNO
	goto_if_eq JOHTO_VAR_RESULT, YES, Johto_Route34_DayCare_Route34_EventScript_DaycareAcceptEgg
	msgbox Johto_Route34_DayCare_Route34_Text_IllKeepIt, MSGBOX_DEFAULT
	clearflag JOHTO_FLAG_PENDING_DAYCARE_EGG
	special RejectEggFromDayCare
	release
	end

Johto_Route34_DayCare_Route34_EventScript_DaycareAcceptEgg::
	setvar VAR_0x8004, PARTY_SIZE
	specialvar JOHTO_VAR_RESULT, CalculatePlayerPartyCount
	goto_if_ne JOHTO_VAR_RESULT, VAR_0x8004, Johto_Route34_DayCare_Route34_EventScript_DaycareReceiveEgg
	msgbox Johto_Route34_DayCare_Route34_Text_YouHaveNoRoomForIt, MSGBOX_DEFAULT
	release
	end

Johto_Route34_DayCare_Route34_EventScript_DaycareReceiveEgg::
	message Johto_Route34_DayCare_Route34_Text_ReceivedEgg
	playfanfare MUS_LEVEL_UP
	waitfanfare
	waitbuttonpress
	msgbox Johto_Route34_DayCare_Route34_Text_TakeGoodCareOfIt, MSGBOX_DEFAULT
	special GiveEggFromDaycare
	clearflag JOHTO_FLAG_PENDING_DAYCARE_EGG
	release
	end

Johto_Route34_DayCare_Route34_EventScript_CheckMonReceivedMail::
