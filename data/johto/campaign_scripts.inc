	msgbox Johto_DragonsDen_Shrine_DragonsDen_Shrine_Text_PassedTest, MSGBOX_DEFAULT
	closemessage
	goto Johto_DragonsDen_Shrine_DragonsDen_Shrine_EventScript_ClairEnter


Johto_DragonsDen_Shrine_DragonsDen_Shrine_Text_ElderGreeting:
    .string "Hm… Good to see you here.\p"
    .string "No need to explain why you came.\n"
    .string "CLAIR sent you here, didn't she?\p"
    .string "That girl is a handful…\n"
    .string "I am sorry, but I must test you.\p"
    .string "Not to worry, you are to answer\n"
    .string "only a few questions.\l"
    .string "Ready?$"

Johto_DragonsDen_Shrine_DragonsDen_Shrine_Text_Question1:
    .string "What are POKéMON to you?$"

Johto_DragonsDen_Shrine_DragonsDen_Shrine_Text_Question2:
    .string "What helps you to win battles?$"

Johto_DragonsDen_Shrine_DragonsDen_Shrine_Text_Question3:
    .string "What kind of trainer do you wish\n"
    .string "to battle?$"

Johto_DragonsDen_Shrine_DragonsDen_Shrine_Text_Question4:
    .string "What is most important for\n"
    .string "raising POKéMON?$"

Johto_DragonsDen_Shrine_DragonsDen_Shrine_Text_Question5:
    .string "Strong POKéMON. Weak POKéMON.\n"
    .string "Which is more important?$"

Johto_DragonsDen_Shrine_DragonsDen_Shrine_Text_WrongAnswer1:
    .string "Hah? I didn't quite catch that…$"

Johto_DragonsDen_Shrine_DragonsDen_Shrine_Text_WrongAnswer2:
    .string "What was it you said?$"

Johto_DragonsDen_Shrine_DragonsDen_Shrine_Text_RightAnswer:
    .string "Oh, I understand…$"

Johto_DragonsDen_Shrine_DragonsDen_Shrine_Text_PassedTest:
    .string "Hm… I see…\p"
    .string "You care deeply for POKéMON.\p"
    .string "Very commendable.\p"
    .string "That conviction is what is\n"
    .string "important!\p"
    .string "{PLAYER}, don't lose that belief.\p"
    .string "It will see you through at the\n"
    .string "POKéMON LEAGUE.$"

Johto_DragonsDen_Shrine_DragonsDen_Shrine_EventScript_ClairEnter::
	clearflag JOHTO_FLAG_HIDE_DRAGONS_DEN_SHRINE_CLAIR
	addobject Johto_DragonsDen_Shrine_LOCALID_DRAGONSDEN3_CLAIR
	playse SE_DOOR
	delay 40
	playse SE_PIN
	johto_applymovement2 OBJ_EVENT_ID_PLAYER, Common_Movement_ExclamationMark
	turnobject OBJ_EVENT_ID_PLAYER, DIR_SOUTH
	delay 20
	turnobject OBJ_EVENT_ID_FOLLOWER, DIR_SOUTH
	johto_applymovement2 Johto_DragonsDen_Shrine_LOCALID_DRAGONSDEN3_CLAIR, Johto_DragonsDen_Shrine_DragonsDen_Shrine_Movement_ClairEnter
	waitmovement 0
	turnobject Johto_DragonsDen_Shrine_LOCALID_DRAGONSDEN3_ELDER, DIR_WEST
	turnobject OBJ_EVENT_ID_PLAYER, DIR_WEST
	turnobject OBJ_EVENT_ID_FOLLOWER, DIR_NORTH
	msgbox Johto_DragonsDen_Shrine_DragonsDen_Shrine_Text_ClairYouPassed, MSGBOX_DEFAULT
	johto_applymovement2 Johto_DragonsDen_Shrine_LOCALID_DRAGONSDEN3_CLAIR, Johto_DragonsDen_Shrine_DragonsDen_Shrine_Movement_ClairBackup1
	waitmovement 0
	msgbox Johto_DragonsDen_Shrine_DragonsDen_Shrine_Text_ClairThatCantBe, MSGBOX_DEFAULT
	johto_applymovement2 Johto_DragonsDen_Shrine_LOCALID_DRAGONSDEN3_CLAIR, Johto_DragonsDen_Shrine_DragonsDen_Shrine_Movement_ClairBackup2
	waitmovement 0
	msgbox Johto_DragonsDen_Shrine_DragonsDen_Shrine_Text_ClairYoureLying, MSGBOX_DEFAULT
	johto_applymovement2 Johto_DragonsDen_Shrine_LOCALID_DRAGONSDEN3_ELDER, Johto_DragonsDen_Shrine_DragonsDen_Shrine_Movement_ElderWalkToClair
	waitmovement 0
	turnobject Johto_DragonsDen_Shrine_LOCALID_DRAGONSDEN3_CLAIR, DIR_NORTH
	msgbox Johto_DragonsDen_Shrine_DragonsDen_Shrine_Text_MustIInformLance, MSGBOX_DEFAULT
	playse SE_PIN
	johto_applymovement2 Johto_DragonsDen_Shrine_LOCALID_DRAGONSDEN3_CLAIR, Common_Movement_ExclamationMark
	msgbox Johto_DragonsDen_Shrine_DragonsDen_Shrine_Text_IUnderstand, MSGBOX_DEFAULT
	johto_applymovement2 Johto_DragonsDen_Shrine_LOCALID_DRAGONSDEN3_CLAIR, Johto_DragonsDen_Shrine_DragonsDen_Shrine_Movement_ClairReturnToPlayer
	waitmovement 0
	msgbox Johto_DragonsDen_Shrine_DragonsDen_Shrine_Text_HereRisingBadge, MSGBOX_DEFAULT

	message Johto_DragonsDen_Shrine_DragonsDen_Shrine_Text_PlayerReceivedRisingBadge
	waitmessage
	call Common_EventScript_PlayGymBadgeFanfare
	msgbox Johto_DragonsDen_Shrine_DragonsDen_Shrine_Text_RisingBadgeExplanation, MSGBOX_DEFAULT
	setflag JOHTO_FLAG_BADGE08_GET
	setflag JOHTO_FLAG_DEFEATED_BLACKTHORN_GYM
	addvar JOHTO_VAR_NUM_BADGES, 1

	johto_applymovement2 Johto_DragonsDen_Shrine_LOCALID_DRAGONSDEN3_ELDER, Johto_DragonsDen_Shrine_DragonsDen_Shrine_Movement_ElderReturnToPlayer
	waitmovement 0
	turnobject OBJ_EVENT_ID_PLAYER, DIR_NORTH
	turnobject Johto_DragonsDen_Shrine_LOCALID_DRAGONSDEN3_CLAIR, DIR_NORTH
	msgbox Johto_DragonsDen_Shrine_DragonsDen_Shrine_Text_ElderScoldsClair, MSGBOX_DEFAULT
	closemessage
	delay 20
	msgbox Johto_DragonsDen_Shrine_DragonsDen_Shrine_Text_Speechless, MSGBOX_DEFAULT
	closemessage
	johto_applymovement2 Johto_DragonsDen_Shrine_LOCALID_DRAGONSDEN3_CLAIR, Johto_DragonsDen_Shrine_DragonsDen_Shrine_Movement_ClairLeave
	waitmovement 0
	playse SE_EXIT
	setflag JOHTO_FLAG_HIDE_DRAGONS_DEN_SHRINE_CLAIR
	removeobject Johto_DragonsDen_Shrine_LOCALID_DRAGONSDEN3_CLAIR
	clearflag JOHTO_FLAG_HIDE_DRAGONS_DEN_CAVERN_CLAIR
	setvar JOHTO_VAR_BLACKTHORN_CITY_STATE, 3
	release
	end

