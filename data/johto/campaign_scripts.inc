    end

Johto_SSAqua_RoomSSE_SSAqua_RoomSSE_EventScript_ReuinionScene::
	lock
    turnobject OBJ_EVENT_ID_PLAYER, DIR_NORTH
    turnobject Johto_SSAqua_RoomSSE_LOCALID_SSAQUA_ROOM_SSE_GRANDFATHER, DIR_SOUTH
    playse SE_PIN
    applymovement Johto_SSAqua_RoomSSE_LOCALID_SSAQUA_ROOM_SSE_GRANDFATHER, Common_Movement_ExclamationMark
    delay 60
	applymovement Johto_SSAqua_RoomSSE_LOCALID_SSAQUA_ROOM_SSE_GRANDDAUGTHER, Johto_SSAqua_RoomSSE_SSAqua_RoomSSE_Movement_GirlEnter
    waitmovement 0
    turnobject Johto_SSAqua_RoomSSE_LOCALID_SSAQUA_ROOM_SSE_GRANDFATHER, DIR_EAST
    msgbox Johto_SSAqua_RoomSSE_SSAqua_RoomSSE_Text_GranddaughterWasPlaying, MSGBOX_DEFAULT
    closemessage
    applymovement OBJ_EVENT_ID_PLAYER, Johto_SSAqua_RoomSSE_SSAqua_RoomSSE_Movement_PlayerEnter
    waitmovement 0
    turnobject Johto_SSAqua_RoomSSE_LOCALID_SSAQUA_ROOM_SSE_GRANDFATHER, DIR_SOUTH
    msgbox Johto_SSAqua_RoomSSE_SSAqua_RoomSSE_Text_EntertainedGranddaughter, MSGBOX_DEFAULT
    msgbox Johto_SSAqua_RoomSSE_SSAqua_RoomSSE_Text_GrandpaHaveThis, MSGBOX_DEFAULT
    giveitem ITEM_METAL_COAT
    closemessage
	setvar JOHTO_VAR_SSAQUA_STATE, 5
	release
	end

