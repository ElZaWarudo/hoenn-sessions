	closemessage
	release
	end
Johto_Route40_Rotue40_EventScript_MonicaCancel::
	closemessage
	release
	end
Johto_Route40_Rotue40_EventScript_MonicaCompleted::
	msgbox Johto_Route40_Route40_Text_MonicaMonday, MSGBOX_DEFAULT
	closemessage
	release
