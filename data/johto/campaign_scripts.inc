	map_script_2 JOHTO_VAR_VIOLET_CITY_STATE, 3, Johto_VioletCity_VioletCity_EventScript_ElmCall_Trigger
	.2byte 0

Johto_VioletCity_VioletCity_OnTransition::
@ Johto policy adaptation: donor option/time callback omitted; host policy applies.
	end

