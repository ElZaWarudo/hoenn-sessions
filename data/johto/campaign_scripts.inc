	case 3, Johto_RuinsOfAlph_Lab_RuinsOfAlph_Lab_EventScript_ChooseDomeFossil
	case 4, Johto_RuinsOfAlph_Lab_RuinsOfAlph_Lab_EventScript_ChooseOldAmber
	case 5, Johto_RuinsOfAlph_Lab_RuinsOfAlph_Lab_EventScript_CancelFossilSelect
	case MULTI_B_PRESSED, Johto_RuinsOfAlph_Lab_RuinsOfAlph_Lab_EventScript_CancelFossilSelect
	end

