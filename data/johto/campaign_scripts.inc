    getplayerxy JOHTO_VAR_TEMP_0, JOHTO_VAR_TEMP_1
    call_if_eq JOHTO_VAR_TEMP_1, 24, Johto_Route27_Route27_EventScript_FirstStepsWalkTop
    call_if_eq JOHTO_VAR_TEMP_1, 25, Johto_Route27_Route27_EventScript_FirstStepsWalkBot

