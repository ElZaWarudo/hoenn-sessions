KantoLater_SaffronCity_FightingDojo_SaffronCity_FightingDojo_Ability_CheckMoney:
	checkmoney 25000, 0
	compare JOHTO_VAR_RESULT, TRUE
	goto_if_eq KantoLater_SaffronCity_FightingDojo_SaffronCity_FightingDojo_Ability_Continue
	compare JOHTO_VAR_RESULT, FALSE
	goto_if_eq KantoLater_SaffronCity_FightingDojo_SaffronCity_FightingDojo_SetZeroNoMoney
	end

KantoLater_SaffronCity_FightingDojo_SaffronCity_FightingDojo_Ability_Continue:
	closemessage
	special ChoosePartyMon
	waitstate
	special SwitchMonAbility
	compare JOHTO_VAR_RESULT, TRUE
	goto_if_eq KantoLater_SaffronCity_FightingDojo_SaffronCity_FightingDojo_Ability_Finish
	compare JOHTO_VAR_RESULT, FALSE
	goto_if_eq KantoLater_SaffronCity_FightingDojo_SaffronCity_FightingDojo_Ability_Cant
	end

