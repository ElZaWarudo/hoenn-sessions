Johto_Route27_Route27_EventScript_FirstSteps::
    lock
    playse SE_PIN
    setflag JOHTO_FLAG_VISITED_KANTO
    johto_applymovement2 Johto_Route27_LOCALID_ROUTE27_FATMAN, Common_Movement_ExclamationMark
    turnobject Johto_Route27_LOCALID_ROUTE27_FATMAN, DIR_WEST
