@ reviewed campaign-owned runtime closure
Johto_EventScript_RockSmashHeartscale::
	giveitem ITEM_HEART_SCALE
	return

BugContest_EventScript_TimesUp::
	lockall
	special Johto_RequestBugContestTimeout
	playse SE_DING_DONG
	msgbox Johto_BugContest_Text_TimesUp, MSGBOX_DEFAULT
	closemessage
	waitse
	getpartysize
	goto_if_eq VAR_RESULT, 1, Johto_BugContest_EventScript_NoCatch
	setvar JOHTO_VAR_BUG_CONTEST_STATE, 3
	msgbox Johto_BugContest_Text_ChooseMon, MSGBOX_DEFAULT
Johto_BugContest_EventScript_ChooseMon::
	special ChoosePartyMon
	waitstate
	goto_if_eq VAR_0x8004, 0xFF, Johto_BugContest_EventScript_WrongMon
	goto_if_eq VAR_0x8004, 0, Johto_BugContest_EventScript_WrongMon
	special Johto_JudgeBugContestSelectedMon
	goto_if_eq VAR_RESULT, 0, Johto_BugContest_EventScript_WrongMon
	special Johto_PrepareBugContestSettlement
	goto_if_eq VAR_RESULT, FALSE, Johto_BugContest_EventScript_Abort
	fadescreen FADE_TO_BLACK
	warp MAP_NATIONAL_PARK_BUG_CONTEST, 5
	delay 90
	end

Johto_BugContest_EventScript_WrongMon::
	msgbox Johto_BugContest_Text_WrongMon, MSGBOX_DEFAULT
	goto Johto_BugContest_EventScript_ChooseMon

Johto_BugContest_EventScript_NoCatch::
	msgbox Johto_BugContest_Text_NoCatch, MSGBOX_DEFAULT
	goto Johto_BugContest_EventScript_Abort

Johto_BugContest_EventScript_Abort::
	special Johto_AbortBugContestAdmission
	setvar JOHTO_VAR_BUG_CONTEST_STATE, 0
	goto Johto_BugContest_EventScript_ReturnToGate

BugContestEventScript_Judging::
	lockall
	special Johto_ShowBugContestResult
	buffernumberstring STR_VAR_2, VAR_RESULT
	msgbox Johto_BugContest_Text_Result, MSGBOX_DEFAULT
Johto_BugContest_EventScript_RetryTransfer::
	special Johto_TransferBugContestSelectedMon
	goto_if_eq VAR_RESULT, TRUE, Johto_BugContest_EventScript_RetryReward
	msgbox Johto_BugContest_Text_TransferFailed, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, TRUE, Johto_BugContest_EventScript_RetryTransfer
	goto Johto_BugContest_EventScript_Abort

Johto_BugContest_EventScript_RetryReward::
	special Johto_ClaimBugContestReward
	goto_if_eq VAR_RESULT, TRUE, Johto_BugContest_EventScript_Complete
	msgbox Johto_BugContest_Text_RewardFailed, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, TRUE, Johto_BugContest_EventScript_RetryReward
	special Johto_ForfeitBugContestReward
	goto_if_eq VAR_RESULT, FALSE, Johto_BugContest_EventScript_RetryReward

Johto_BugContest_EventScript_Complete::
	special Johto_ExitBugContest
	goto_if_eq VAR_RESULT, FALSE, Johto_BugContest_EventScript_RetryReward
	setvar JOHTO_VAR_BUG_CONTEST_STATE, 0
	msgbox Johto_BugContest_Text_Complete, MSGBOX_DEFAULT
Johto_BugContest_EventScript_ReturnToGate::
	fadescreen FADE_TO_BLACK
	goto_if_eq VAR_TEMP_1, 1, Johto_BugContest_EventScript_ReturnSide
	warp MAP_GATE_NATIONAL_PARK, 7, 2
	releaseall
	end

Johto_BugContest_EventScript_ReturnSide::
	warp MAP_GATE_NATIONAL_PARK, 35, 7
	releaseall
	end

Johto_BugContest_Text_TimesUp::
	.string "Ding-dong! Time's up!$"
Johto_BugContest_Text_ChooseMon::
	.string "The contest has ended.\nChoose the caught POKéMON you want\lto keep and have judged.$"
Johto_BugContest_Text_WrongMon::
	.string "Choose one of the BUG POKéMON you\ncaught during the contest.$"
Johto_BugContest_Text_NoCatch::
	.string "You did not catch a POKéMON.\nYour original party will be returned.$"
Johto_BugContest_Text_Result::
	.string "Your {STR_VAR_1} placed number\n{STR_VAR_2}! It will be sent to your PC.$"
Johto_BugContest_Text_TransferFailed::
	.string "The PC is full, so the caught POKéMON\ncould not be transferred. Retry?\pChoosing NO ends the contest without\lkeeping it.$"
Johto_BugContest_Text_RewardFailed::
	.string "There is no room for the prize. Retry?\pChoosing NO explicitly forfeits the\lprize.$"
Johto_BugContest_Text_Complete::
	.string "Thank you for participating!$"


