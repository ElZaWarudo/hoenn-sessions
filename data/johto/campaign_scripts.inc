	end

Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_MomEventScript_GoodLuck::
	msgbox Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_Text_MomLeaving, MSGBOX_DEFAULT
	setflag JOHTO_FLAG_MOM_VISITED
