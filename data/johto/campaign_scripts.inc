	setvar JOHTO_VAR_MAHOGANY_TOWN_STATE, 14
	clearflag JOHTO_FLAG_HIDE_MAHOGANY_COP
	setflag JOHTO_FLAG_HIDE_MAHOGANY_TOWN_FATMAN
