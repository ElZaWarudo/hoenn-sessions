	special TeachMoveRelearnerMove
	waitstate
	goto_if_eq VAR_0x8004, 0, Johto_BlackthornCity_House3_BlackthornCity_MoveRelearnersHouse_EventScript_ChooseMon
	msgbox Johto_BlackthornCity_House3_BlackthornCity_MoveRelearnersHouse_Text_HandedOverHeartScale, MSGBOX_DEFAULT
	removeitem ITEM_HEART_SCALE
	goto Johto_BlackthornCity_House3_BlackthornCity_MoveRelearnersHouse_EventScript_ComeBackWithHeartScale
	end

