	map_script MAP_SCRIPT_ON_TRANSITION, Johto_NewBarkTown_NewBarkTown_OnTransition
	map_script MAP_SCRIPT_ON_FRAME_TABLE, Johto_NewBarkTown_NewBarkTown_OnFrame
