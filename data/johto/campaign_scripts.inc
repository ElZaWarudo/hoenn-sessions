KantoLater_Route10_Route10_EventScript_Zapdos::
	lock
	faceplayer
	playmoncry SPECIES_ZAPDOS, CRY_MODE_ENCOUNTER
	msgbox KantoLater_SeafoamIslands_B1F_SeafoamIslands_B1F_Text_ArticunoBattle
	delay 40
	waitmoncry
	seteventmon SPECIES_ZAPDOS, 50
	special BattleSetup_StartLegendaryBattle
waitstate
	specialvar JOHTO_VAR_RESULT, GetBattleOutcome
	goto_if_eq JOHTO_VAR_RESULT, B_OUTCOME_RAN, KantoLater_Route10_Route10_EventScript_ZapdosRan
	fadescreenswapbuffers FADE_TO_BLACK
	removeobject KantoLater_Route10_LOCALID_ROUTE10_ZAPDOS
	setflag JOHTO_FLAG_HIDE_ZAPDOS
	fadescreenswapbuffers FADE_FROM_BLACK
	release
