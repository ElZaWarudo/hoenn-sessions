Johto_VioletCity_VioletCity_EventScript_Earl::
	lock
	faceplayer
	applymovement Johto_VioletCity_LOCALID_VIOLETCITY_EARL, Johto_VioletCity_VioletCity_Movement_Earl_Spin
	waitmovement 0
	faceplayer
	msgbox Johto_VioletCity_VioletCity_Text_EarlAsksIfYouBeatFalkner MSGBOX_YESNO
	goto_if_eq JOHTO_VAR_RESULT, NO, Johto_VioletCity_VioletCity_EventScript_EarlTrainerSchool
	msgbox Johto_VioletCity_VioletCity_Text_VeryNiceIndeed, MSGBOX_DEFAULT
	closemessage
	release
	end

Johto_VioletCity_VioletCity_EventScript_EarlTrainerSchool::
	msgbox Johto_VioletCity_VioletCity_Text_FollowEarl, MSGBOX_DEFAULT
	closemessage
	playbgm MUS_HG_FOLLOW_ME_1, FALSE
	switch JOHTO_VAR_FACING
	case DIR_NORTH, Johto_VioletCity_VioletCity_EventScript_EarlTrainerSchoolSouth
	case DIR_WEST, Johto_VioletCity_VioletCity_EventScript_EarlTrainerSchoolEast
	release
	end

Johto_VioletCity_VioletCity_EventScript_EarlTrainerSchoolSouth::
	applymovement Johto_VioletCity_LOCALID_VIOLETCITY_EARL, Johto_VioletCity_VioletCity_Movement_Earl_South_Adjustment
	waitmovement 0
	applymovement Johto_VioletCity_LOCALID_VIOLETCITY_EARL, Johto_VioletCity_VioletCity_Movement_Earl_Spin
	applymovement OBJ_EVENT_ID_PLAYER, Johto_VioletCity_VioletCity_Movement_Player_South_Adjustment
	waitmovement 0
	waitmovement 0
	goto Johto_VioletCity_VioletCity_EventScript_EarlTrainerSchoolTransition
	release
	end

Johto_VioletCity_VioletCity_EventScript_EarlTrainerSchoolEast::
	applymovement Johto_VioletCity_LOCALID_VIOLETCITY_EARL, Johto_VioletCity_VioletCity_Movement_Earl_East_Adjustment
	applymovement OBJ_EVENT_ID_PLAYER, Johto_VioletCity_VioletCity_Movement_Player_East_Adjustment
	waitmovement 0
	waitmovement 0
	goto Johto_VioletCity_VioletCity_EventScript_EarlTrainerSchoolTransition
	release
	end

Johto_VioletCity_VioletCity_EventScript_EarlTrainerSchoolTransition:
	applymovement Johto_VioletCity_LOCALID_VIOLETCITY_EARL, Johto_VioletCity_VioletCity_Movement_Walk_To_School
	applymovement OBJ_EVENT_ID_PLAYER, Johto_VioletCity_VioletCity_Movement_Walk_To_School
	waitmovement 0
	waitmovement 0
	applymovement Johto_VioletCity_LOCALID_VIOLETCITY_EARL, Johto_VioletCity_VioletCity_Movement_Earl_Spin
	waitmovement 0
	turnobject Johto_VioletCity_LOCALID_VIOLETCITY_EARL, DIR_WEST
	msgbox Johto_VioletCity_VioletCity_Text_HereTeacherIAm, MSGBOX_DEFAULT
	closemessage
	applymovement Johto_VioletCity_LOCALID_VIOLETCITY_EARL, Johto_VioletCity_VioletCity_Movement_Earl_Walk_Inside
	delay 20
	opendoor 39, 36
	waitdooranim
	waitmovement 0
	setflag JOHTO_FLAG_HIDE_VIOLET_CITY_EARL
	removeobject Johto_VioletCity_LOCALID_VIOLETCITY_EARL
	closedoor 39, 36
	waitdooranim
	clearflag JOHTO_FLAG_HIDE_TRAINER_SCHOOL_EARL
	fadedefaultbgm
	release
	end

