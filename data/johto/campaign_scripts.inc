Johto_RocketHideout_B2F_RocketHideout_B2F_Trigger_Ariana::
	lock
	setobjectxyperm Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_LANCE, 6, 26
	setobjectxyperm Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_DRAGONITE, 5, 26
	clearflag JOHTO_FLAG_HIDE_ROCKETHIDEOUT2_ARIANA_AND_GRUNT
	addobject Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_ARIANA
	addobject Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_GRUNT
	delay 20
	msgbox Johto_RocketHideout_B2F_RocketHideout_B2F_Text_ArianaHoldIt, MSGBOX_AUTOCLOSE
	playse SE_PIN
	applymovement OBJ_EVENT_ID_PLAYER, Common_Movement_ExclamationMark
	delay 60
	getplayerxy JOHTO_VAR_TEMP_0, JOHTO_VAR_TEMP_1
	call_if_eq JOHTO_VAR_TEMP_0, 14, Johto_RocketHideout_B2F_RocketHideout_B2F_Trigger_PlayerMoveLeft
	call_if_eq JOHTO_VAR_TEMP_0, 16, 	Johto_RocketHideout_B2F_RocketHideout_B2F_Trigger_PlayerMoveRight
	applymovement OBJ_EVENT_ID_PLAYER, Johto_RocketHideout_B2F_RocketHideout_B2F_Movement_PlayerMeetAriana
	applymovement Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_ARIANA, Johto_RocketHideout_B2F_RocketHideout_B2F_Movement_Ariana
	delay 20
	applymovement Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_GRUNT, Johto_RocketHideout_B2F_RocketHideout_B2F_Movement_Ariana
	waitmovement Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_GRUNT
	msgbox Johto_RocketHideout_B2F_RocketHideout_B2F_Text_ArianaChallenge, MSGBOX_DEFAULT
	closemessage
	clearflag JOHTO_FLAG_HIDE_ROCKETHIDEOUT2_LANCE_DRAGONITE
	addobject Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_LANCE
	addobject Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_DRAGONITE
	applymovement Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_LANCE, Johto_RocketHideout_B2F_RocketHideout_B2F_Movement_Lance
	delay 20
	applymovement Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_DRAGONITE, Johto_RocketHideout_B2F_RocketHideout_B2F_Movement_Lance
	waitmovement 0
	msgbox Johto_RocketHideout_B2F_RocketHideout_B2F_Text_LanceInterrupt, MSGBOX_DEFAULT
	closemessage
	applymovement Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_ARIANA, Common_Movement_WalkInPlaceFasterUp
	msgbox Johto_RocketHideout_B2F_RocketHideout_B2F_Text_ArianaOutraged
	closemessage
	goto Johto_RocketHideout_B2F_RocketHideout_B2F_EventScript_ReadyForBattlePrompt
	end

