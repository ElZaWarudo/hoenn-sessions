Johto_Route40_Rotue40_EventScript_Monica::
	lock
	faceplayer
	goto_if_set JOHTO_FLAG_GOT_SHARP_BEAK, Johto_Route40_Rotue40_EventScript_MonicaCompleted
	msgbox Johto_Route40_Route40_Text_Monica, MSGBOX_DEFAULT
	closemessage
	multichoice 20, 0, MULTI_DAYS_OF_WEEK, FALSE
	switch JOHTO_VAR_RESULT
	case 0, Johto_Route40_Rotue40_EventScript_MonicaNope
	case 1, Johto_Route40_Rotue40_EventScript_MonicaYes
	case 2, Johto_Route40_Rotue40_EventScript_MonicaNope
	case 3, Johto_Route40_Rotue40_EventScript_MonicaNope
	case 4, Johto_Route40_Rotue40_EventScript_MonicaNope
	case 5, Johto_Route40_Rotue40_EventScript_MonicaNope
	case 6, Johto_Route40_Rotue40_EventScript_MonicaNope
	case 7 Johto_Route40_Rotue40_EventScript_MonicaCancel
	case MULTI_B_PRESSED, Johto_Route40_Rotue40_EventScript_MonicaCancel
	closemessage
	release
	end
Johto_Route40_Rotue40_EventScript_MonicaYes::
	msgbox Johto_Route40_Route40_Text_MonicaGivesGift, MSGBOX_DEFAULT
	giveitem ITEM_SHARP_BEAK
	goto_if_eq JOHTO_VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull
	setflag JOHTO_FLAG_GOT_SHARP_BEAK
	msgbox Johto_Route40_Route40_Text_MonicaGaveGift, MSGBOX_DEFAULT
	closemessage
	release
	end
