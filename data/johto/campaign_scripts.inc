	switch JOHTO_VAR_RESULT
	case 0, KantoLater_VermilionCity_PortInside_VermilionPort_EventScript_ChoseOlivine
	case 1, KantoLater_VermilionCity_PortInside_VermilionPort_EventScript_ChoseSouthernIsland
