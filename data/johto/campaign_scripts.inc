	multichoice 20, 0, MULTI_DAYS_OF_WEEK, FALSE
	switch JOHTO_VAR_RESULT
	case 0, Johto_LakeOfRage_LakeOfRage_EventScript_WesleyNope
	case 1, Johto_LakeOfRage_LakeOfRage_EventScript_WesleyNope
	case 2, Johto_LakeOfRage_LakeOfRage_EventScript_WesleyNope
	case 3, Johto_LakeOfRage_LakeOfRage_EventScript_WesleyYes
	case 4, Johto_LakeOfRage_LakeOfRage_EventScript_WesleyNope
	case 5, Johto_LakeOfRage_LakeOfRage_EventScript_WesleyNope
	case 6, Johto_LakeOfRage_LakeOfRage_EventScript_WesleyNope
	case 7 Johto_LakeOfRage_LakeOfRage_EventScript_WesleyCancel
	case MULTI_B_PRESSED, Johto_LakeOfRage_LakeOfRage_EventScript_WesleyCancel
	closemessage
	release
	end
