	closemessage
	delay 20
	applymovement Johto_OlivineCity_PortInside_LOCALID_OLIVINEPORT_SAILOR, Johto_OlivineCity_PortInside_OlivinePort_Movement_SailorEnterBoat
	waitmovement 0
	playse SE_EXIT
	applymovement OBJ_EVENT_ID_PLAYER, Johto_OlivineCity_PortInside_OlivinePort_Movement_PlayerEnterBoat
	waitmovement 0
	special SpawnCameraObject
	playse SE_EXIT
	removeobject OBJ_EVENT_ID_PLAYER
	delay 60
	applymovement Johto_OlivineCity_PortInside_LOCALID_OLIVINEPORT_SAILOR, Johto_OlivineCity_PortInside_OlivinePort_Movement_BoatLeave
	applymovement Johto_OlivineCity_PortInside_LOCALID_OLIVINEPORT_BOAT, Johto_OlivineCity_PortInside_OlivinePort_Movement_BoatLeave
	waitmovement Johto_OlivineCity_PortInside_LOCALID_OLIVINEPORT_BOAT
	setrespawn HEAL_LOCATION_OLIVINE_CITY
	return

