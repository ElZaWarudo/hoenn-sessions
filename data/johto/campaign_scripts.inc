	special DrawWholeMapView
	delay 55
	turnobject Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_LANCE DIR_WEST
	turnobject OBJ_EVENT_ID_PLAYER, DIR_EAST
	delay 30
	msgbox Johto_RocketHideout_B2F_RocketHideout_B2F_Text_LanceElectrodeDone, MSGBOX_DEFAULT
	giveitem ITEM_HM_WHIRLPOOL
	msgbox Johto_RocketHideout_B2F_RocketHideout_B2F_Text_LanceWhirlpool, MSGBOX_DEFAULT
	closemessage
	turnobject Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_LANCE, DIR_SOUTH
	delay 20
	msgbox Johto_RocketHideout_B2F_RocketHideout_B2F_Text_LanceMonMaster, MSGBOX_DEFAULT
	closemessage
	applymovement Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_LANCE, Johto_RocketHideout_B2F_RocketHideout_B2F_Movement_LanceFinalExit
	delay 20

	applymovement Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_DRAGONITE, Johto_RocketHideout_B2F_RocketHideout_B2F_Movement_DragoniteFinalExit
	waitmovement Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_DRAGONITE
	waitmovement Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_LANCE

	setflag JOHTO_FLAG_HIDE_ROCKETHIDEOUT2_LANCE_DRAGONITE
	removeobject Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_DRAGONITE
	removeobject Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_LANCE
