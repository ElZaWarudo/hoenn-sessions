KantoLater_ViridianCity_Gym_ViridianCity_Gym_EventScript_Blue::
	lock
	faceplayer
	goto_if_unset JOHTO_FLAG_HIDE_DOJO_BLUE, KantoLater_ViridianCity_Gym_ViridianCity_Gym_EventScript_BlueAtDojo
	goto_if_set JOHTO_FLAG_DEFEATED_VIRIDIAN_GYM, KantoLater_ViridianCity_Gym_ViridianCity_Gym_EventScript_BlueGotoDojo
	goto_if_set JOHTO_FLAG_DEFEATED_VIRIDIAN_GYM, KantoLater_ViridianCity_Gym_ViridianCity_Gym_EventScript_Blue_Defeated
	msgbox KantoLater_ViridianCity_Gym_ViridianCity_Gym_Text_LeaderBlue_Before, MSGBOX_DEFAULT
	trainerbattle_no_intro JOHTO_TRAINER_BLUE, KantoLater_ViridianCity_Gym_ViridianCity_Gym_Text_LeaderBlue_Win
	message KantoLater_ViridianCity_Gym_ViridianCity_Gym_Text_ReceivedEarthBadge
	waitmessage
	call Common_EventScript_PlayGymBadgeFanfare
	msgbox KantoLater_ViridianCity_Gym_ViridianCity_Gym_Text_LeaderBlue_After, MSGBOX_DEFAULT
	giveitem ITEM_TM_BULK_UP
	setflag JOHTO_FLAG_BADGE16_GET
	setflag JOHTO_FLAG_DEFEATED_VIRIDIAN_GYM
	addvar JOHTO_VAR_NUM_BADGES, 1
	setvar VAR_0x8008, 16
	call Johto_Closure_data_scripts_set_gym_trainers_inc_Common_EventScript_SetGymTrainers
	closemessage
	setflag JOHTO_FLAG_HIDE_LEAGUE_BLACKBELT
	setflag JOHTO_FLAG_HIDE_CERULEANCAVE_GUARD
	setflag JOHTO_FLAG_HIDE_SEAFOAM_BLAINE
