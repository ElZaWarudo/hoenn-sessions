Johto_Gate_NationalPark_Gate_NationalPark_EventScript_Attendant::
	lockall
	faceplayer
	goto_if_set JOHTO_FLAG_DAILY_BUG_CONTEST_COMPLETED, Johto_Gate_NationalPark_Gate_NationalPark_EventScript_AttendantAlreadyPlayed
	msgbox Johto_Gate_NationalPark_Route35NationalParkGate_Text_OfficerAskToParticipate, MSGBOX_YESNO
	goto_if_eq JOHTO_VAR_RESULT, TRUE, Johto_Gate_NationalPark_Gate_NationalPark_EventScript_AttendantStart
	msgbox Johto_Gate_NationalPark_Route35NationalParkGate_Text_TakePartInFuture, MSGBOX_DEFAULT
	releaseall
	end

Johto_Gate_NationalPark_Gate_NationalPark_EventScript_AttendantStart::
	msgbox Johto_Gate_NationalPark_Route35NationalParkGate_Text_OfficerAskToUseFirstMon, MSGBOX_YESNO
	goto_if_eq JOHTO_VAR_RESULT, FALSE, Johto_Gate_NationalPark_Gate_NationalPark_EventScript_AttendantCancel
	getpartysize
	call_if_eq JOHTO_VAR_RESULT, 1, Johto_Gate_NationalPark_Gate_NationalPark_EventScript_OnlyOneMon
	msgbox Johto_Gate_NationalPark_Route35NationalParkGate_Text_OfficerHoldYourMon, MSGBOX_DEFAULT
	closemessage
	special Johto_BeginBugContestAdmission
	goto_if_eq JOHTO_VAR_RESULT, MON_CANT_GIVE, Johto_Gate_NationalPark_Gate_NationalPark_EventScript_AttendantFaint
	playfanfare MUS_OBTAIN_ITEM
	message Johto_Gate_NationalPark_Route35NationalParkGate_Text_MonLeftWithHelper
	waitfanfare
	closemessage
	msgbox Johto_Gate_NationalPark_Route35NationalParkGate_Text_OfficerGiveParkBalls, MSGBOX_DEFAULT
	closemessage
	closemessage
	msgbox Johto_Gate_NationalPark_Route35NationalParkGate_Text_OfficerExplainRules, MSGBOX_DEFAULT
