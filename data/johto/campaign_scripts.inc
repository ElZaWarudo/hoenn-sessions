	setvar VAR_0x8008, INGAME_TRADE_ONIX
	copyvar VAR_0x8004, VAR_0x8008
	specialvar JOHTO_VAR_RESULT, GetInGameTradeSpeciesInfo
	copyvar VAR_0x8009, JOHTO_VAR_RESULT
	msgbox Johto_VioletCity_House1_VioletCity_House1_Text_YouWillTradeWontYou, MSGBOX_YESNO
	goto_if_eq JOHTO_VAR_RESULT, NO, Johto_VioletCity_House1_VioletCity_House1_EventScript_DeclineTrade
	special ChoosePartyMon
	waitstate
	copyvar VAR_0x800A, VAR_0x8004
	goto_if_eq VAR_0x8004, PARTY_NOTHING_CHOSEN, Johto_VioletCity_House1_VioletCity_House1_EventScript_DeclineTrade
	copyvar VAR_0x8005, VAR_0x800A
	specialvar JOHTO_VAR_RESULT, GetTradeSpecies
	copyvar VAR_0x800B, JOHTO_VAR_RESULT
	goto_if_ne JOHTO_VAR_RESULT, VAR_0x8009, Johto_VioletCity_House1_VioletCity_House1_EventScript_NotRequestedMon
	copyvar VAR_0x8004, VAR_0x8008
	copyvar VAR_0x8005, VAR_0x800A
	special CreateInGameTradePokemon
	special DoInGameTradeScene
	waitstate
	bufferspeciesname STR_VAR_1, VAR_0x8009
	msgbox Johto_VioletCity_House1_VioletCity_House1_Text_MonYouTakeCare, MSGBOX_DEFAULT
	closemessage
