Johto_EcruteakCity_EcruteakCity_Trigger_Silver::
	lockall
	opendoor 39, 40
	waitdooranim
	delay 10
	clearflag JOHTO_FLAG_HIDE_ECRUTEAK_SILVER
	addobject Johto_EcruteakCity_LOCALID_ECRUTEK_SILVER
	playbgm MUS_HG_ENCOUNTER_RIVAL, TRUE
	playse SE_BANG
	applymovement Johto_EcruteakCity_LOCALID_ECRUTEK_SILVER, Johto_EcruteakCity_EcruteakCity_Movement_Silver1
	applymovement OBJ_EVENT_ID_PLAYER, Johto_EcruteakCity_EcruteakCity_Movement_Silver1
	message Johto_EcruteakCity_EcruteakCity_Text_Silver1

	waitmovement OBJ_EVENT_ID_PLAYER
	waitmovement Johto_EcruteakCity_LOCALID_ECRUTEK_SILVER
	turnobject OBJ_EVENT_ID_PLAYER, DIR_NORTH
	closedoor 39, 40
	waitdooranim
	msgbox Johto_EcruteakCity_EcruteakCity_Text_Silver2, MSGBOX_DEFAULT
	closemessage
	playse SE_PIN
	applymovement Johto_EcruteakCity_LOCALID_ECRUTEK_SILVER, Common_Movement_ExclamationMark
	delay 60
	turnobject Johto_EcruteakCity_LOCALID_ECRUTEK_SILVER, DIR_SOUTH
	msgbox Johto_EcruteakCity_EcruteakCity_Text_Silver3, MSGBOX_DEFAULT
	closemessage

	applymovement Johto_EcruteakCity_LOCALID_ECRUTEK_SILVER, Johto_EcruteakCity_EcruteakCity_Movement_Silver2
	waitmovement Johto_EcruteakCity_LOCALID_ECRUTEK_SILVER


	setflag JOHTO_FLAG_HIDE_ECRUTEAK_SILVER
	removeobject Johto_EcruteakCity_LOCALID_ECRUTEK_SILVER
	fadedefaultbgm

	setvar JOHTO_VAR_ECRUTEAK_CITY_THEATER, 5
	releaseall
	end

