	.2byte 0

Johto_NewBarkTown_NewBarkTown_EventScript_ElmCallAfterLeague::
	lock
	pokenavcall Johto_BlackthornCity_BlackthornCity_Text_ElmCall
	waitmessage
	delay 30
	setvar JOHTO_VAR_NEWBARK_TOWN_STATE, 7
	setvar JOHTO_VAR_NEWBARKTOWN_LABSTATE, 10
	release
