	closemessage
	setflag JOHTO_FLAG_RECEIVED_RUNNING_SHOES
	setflag JOHTO_FLAG_SYS_B_DASH
	msgbox Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_Text_ExplainRunningShoes, MSGBOX_DEFAULT
	closemessage
	delay 30
	return

