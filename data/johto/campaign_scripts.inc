Johto_TinTower_RoofDay_TinTower_RoofDay_EventScript_HoOh::
	lockall
	goto_if_eq JOHTO_VAR_COMPLETED_HO_OH, 4, Johto_TinTower_RoofDay_TinTower_RoofDay_EventScript_HoOhPostgame
	waitse
	playmoncry SPECIES_HO_OH, CRY_MODE_ENCOUNTER
	delay 30
	waitmoncry
	playbgm MUS_HG_VS_HO_OH, 0
	seteventmon SPECIES_HO_OH, 50
	setflag JOHTO_FLAG_SYS_CTRL_OBJ_DELETE
	special BattleSetup_StartLegendaryBattle
	waitstate
	clearflag JOHTO_FLAG_SYS_CTRL_OBJ_DELETE
	setvar JOHTO_VAR_LAST_TALKED, Johto_TinTower_RoofDay_LOCALID_HO_OH
	specialvar JOHTO_VAR_RESULT, GetBattleOutcome
	goto_if_eq JOHTO_VAR_RESULT, B_OUTCOME_RAN, Johto_TinTower_RoofDay_TinTower_RoofDay_EventScript_RanFromHoOh
	goto_if_eq JOHTO_VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, Johto_TinTower_RoofDay_TinTower_RoofDay_EventScript_RanFromHoOh
	call_if_eq JOHTO_VAR_RESULT, B_OUTCOME_WON, Johto_TinTower_RoofDay_TinTower_RoofDay_EventScript_HoohFlewAway
	call_if_eq JOHTO_VAR_RESULT, B_OUTCOME_CAUGHT, Johto_TinTower_RoofDay_TinTower_RoofDay_EventScript_CaughtHooh
	setflag JOHTO_FLAG_HIDE_TIN_TOWER_KIMONO_GIRLS
	applymovement Johto_TinTower_RoofDay_LOCALID_KIMONO_MID, Johto_TinTower_RoofDay_TinTower_RoofDay_Movement_Kimono_Dance_Shift_Right2
	waitmovement 0
	clearflag JOHTO_FLAG_HIDE_ECRUTEAK_CITY_THEATER_KIMONOS
	clearflag JOHTO_FLAG_HIDE_ECRUTEAK_CITY_THEATER_ZUKI
	clearflag JOHTO_FLAG_HIDE_ECRUTEAK_CITY_THEATER_NPCS
	setvar JOHTO_VAR_ECRUTEAK_CITY_THEATER, 8
	setvar JOHTO_VAR_COMPLETED_HO_OH, 3
	releaseall
	end

