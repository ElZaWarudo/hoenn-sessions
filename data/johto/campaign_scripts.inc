KantoLater_SaffronCity_TrainStation_SaffronStation_EventScript_BoardTrain::
	special Johto_ChooseJohto
	goto_if_eq JOHTO_VAR_RESULT, FALSE, KantoLater_SaffronCity_TrainStation_SaffronStation_EventScript_BoardTrain_TravelFailed
	special Johto_RecordCurrentHeal
	goto_if_eq JOHTO_VAR_RESULT, FALSE, KantoLater_SaffronCity_TrainStation_SaffronStation_EventScript_BoardTrain_TravelFailed
	special Johto_PrepareKantoTravel
	goto_if_eq JOHTO_VAR_RESULT, FALSE, KantoLater_SaffronCity_TrainStation_SaffronStation_EventScript_BoardTrain_TravelFailed
	msgbox KantoLater_SaffronCity_TrainStation_SaffronMagnetTrainStation_Text_OfficerRightThisWay, MSGBOX_DEFAULT
	closemessage
	applymovement KantoLater_SaffronCity_TrainStation_LOCALID_SAFFRON_STATION_ATTENDANT, KantoLater_SaffronCity_TrainStation_SaffronStation_Movement_Attendant_Move_Up
	waitmovement 0
	applymovement OBJ_EVENT_ID_PLAYER, KantoLater_SaffronCity_TrainStation_SaffronStation_Movement_WalktoTrain
	waitmovement 0
	special SpawnCameraObject
	applymovement OBJ_EVENT_ID_PLAYER, Common_Movement_WalkUp
	waitmovement 0
	playse SE_EXIT
	waitse
	fadescreen FADE_TO_BLACK

	applymovement OBJ_EVENT_ID_CAMERA, KantoLater_SaffronCity_TrainStation_SaffronStation_Movement_CameraPanUp
	waitmovement 0
	applymovement OBJ_EVENT_ID_CAMERA, KantoLater_SaffronCity_TrainStation_SaffronStation_Movement_CameraPanRight
	waitmovement 0
	delay 60

	applymovement KantoLater_SaffronCity_TrainStation_LOCALID_SAFFRON_STATION_TRAIN KantoLater_SaffronCity_TrainStation_SaffronStation_Movement_SlideLeft
	applymovement OBJ_EVENT_ID_CAMERA, KantoLater_SaffronCity_TrainStation_SaffronStation_Movement_SlideLeft
	fadescreen FADE_FROM_BLACK
	playse SE_TRUCK_MOVE
	delay 220
	playse SE_TRUCK_STOP
	applymovement KantoLater_SaffronCity_TrainStation_LOCALID_SAFFRON_STATION_TRAIN KantoLater_SaffronCity_TrainStation_SaffronStation_Movement_SlideLeft
	applymovement OBJ_EVENT_ID_CAMERA, KantoLater_SaffronCity_TrainStation_SaffronStation_Movement_SlideLeft
	fadescreen FADE_TO_BLACK
	waitse
	special RemoveCameraObject
	setvar JOHTO_VAR_TRAIN, 1
	delay 60
	warp MAP_GOLDENROD_CITY_TRAIN_STATION, 19, 16
	delay 60
	end

