	applymovement OBJ_EVENT_ID_PLAYER, Johto_Route42_Route42_Movement_Player
	playse SE_LEDGE
	delay 60
	playse SE_LEDGE
	delay 30
	playse SE_LEDGE
	delay 30
	playse SE_LEDGE
	delay 30
	playse SE_LEDGE
	delay 30
	playse SE_LEDGE
	waitmovement Johto_Route42_LOCALID_ROUTE42_SUICUNE
	waitmovement 0
	delay 60
	removeobject Johto_Route42_LOCALID_ROUTE42_SUICUNE
	setflag JOHTO_FLAG_HIDE_ROUTE42_SUICUNE
	clearflag JOHTO_FLAG_HIDE_ROUTE42_EUSINE
	addobject Johto_Route42_LOCALID_ROUTE42_EUSINE
	playse SE_EXIT
	turnobject OBJ_EVENT_ID_PLAYER, DIR_EAST
