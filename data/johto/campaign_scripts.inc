	checkitem ITEM_SS_TICKET
	bufferitemname STR_VAR_1, ITEM_SS_TICKET
	goto_if_eq JOHTO_VAR_RESULT, FALSE, KantoLater_VermilionCity_PortInside_VermilionPort_EventScript_Sailor_NoCredentials
	special Johto_ChooseJohto
	goto_if_eq JOHTO_VAR_RESULT, FALSE, KantoLater_VermilionCity_PortInside_VermilionPort_EventScript_ChoseOlivine_TravelFailed
