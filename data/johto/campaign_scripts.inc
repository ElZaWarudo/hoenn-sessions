	closemessage
	fadescreenswapbuffers FADE_TO_BLACK
	applymovement Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_LANCE, Common_Movement_WalkUp
	applymovement Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_DRAGONITE, Common_Movement_WalkUp
	waitmovement 0
	applymovement Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_LANCE, Common_Movement_WalkRight
