	goto_if_eq VAR_0x8005, MAX_MON_MOVES, Johto_BlackthornCity_House3_BlackthornCity_MoveDeletersHouse_EventScript_ChooseMonAndMoveToForget
	special BufferMoveDeleterNicknameAndMove
	msgbox Johto_BlackthornCity_House3_BlackthornCity_MoveDeletersHouse_Text_MonsMoveShouldBeForgotten, MSGBOX_YESNO
	switch JOHTO_VAR_RESULT
	case YES, Johto_BlackthornCity_House3_BlackthornCity_MoveDeletersHouse_EventScript_TryForgetMove
