	setobjectxyperm Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_DRAGONITE, 20, 16
	setobjectxyperm Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_LANCE, 19, 16
