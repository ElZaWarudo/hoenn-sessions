Johto_SafariZoneGate_SafariZoneEntrance_SafariZoneGate_SafariZoneEntrance_EventScript_EntranceCounterTrigger::
	lockall
	turnobject OBJ_EVENT_ID_PLAYER, DIR_EAST
	showmoneybox 0, 0
	msgbox Route121_SafariZoneEntrance_Text_WouldYouLikeToPlay, MSGBOX_YESNO
	goto_if_eq JOHTO_VAR_RESULT, YES, Johto_SafariZoneGate_SafariZoneEntrance_SafariZoneGate_SafariZoneEntrance_EventScript_TryEnterSafariZone
	msgbox Route121_SafariZoneEntrance_Text_PlayAnotherTime, MSGBOX_DEFAULT
	goto Johto_SafariZoneGate_SafariZoneEntrance_SafariZoneGate_SafariZoneEntrance_EventScript_MovePlayerBackFromCounter
	end

Johto_SafariZoneGate_SafariZoneEntrance_SafariZoneGate_SafariZoneEntrance_EventScript_TryEnterSafariZone::
	checkitem ITEM_POKEBLOCK_CASE
	goto_if_eq JOHTO_VAR_RESULT, 0, Johto_SafariZoneGate_SafariZoneEntrance_SafariZoneGate_SafariZoneEntrance_EventScript_NoPokeblockCase
	call Johto_SafariZoneGate_SafariZoneEntrance_SafariZoneGate_SafariZoneEntrance_EventScript_CheckHasRoomForPokemon
	checkmoney 500
	goto_if_eq JOHTO_VAR_RESULT, 0, Johto_SafariZoneGate_SafariZoneEntrance_SafariZoneGate_SafariZoneEntrance_EventScript_NotEnoughMoney
	msgbox Route121_SafariZoneEntrance_Text_ThatWillBe500Please, MSGBOX_DEFAULT
	removemoney 500
	playse SE_SHOP
	updatemoneybox
	msgbox Route121_SafariZoneEntrance_Text_HereAreYourSafariBalls, MSGBOX_DEFAULT
	playfanfare MUS_OBTAIN_ITEM
	message Route121_SafariZoneEntrance_Text_Received30SafariBalls
	waitfanfare
	msgbox Route121_SafariZoneEntrance_Text_PleaseEnjoyYourself, MSGBOX_DEFAULT
	closemessage
	hidemoneybox
	applymovement OBJ_EVENT_ID_PLAYER, Johto_SafariZoneGate_SafariZoneEntrance_SafariZoneGate_SafariZoneEntrance_Movement_EnterSafariZone
	waitmovement 0
	special EnterSafariMode
	setvar JOHTO_VAR_SAFARI_ZONE_STATE, 2
	clearflag JOHTO_FLAG_GOOD_LUCK_SAFARI_ZONE
	warp MAP_SAFARI_ZONE_ENTERANCE, 0
	waitstate
	end

Johto_SafariZoneGate_SafariZoneEntrance_SafariZoneGate_SafariZoneEntrance_EventScript_CheckHasRoomForPokemon::
