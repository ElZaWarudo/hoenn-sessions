	closemessage
	setvar JOHTO_VAR_SHUCKIE, 3
	release
	end

Johto_CianwoodHouse3_CianwoodCity_EventScript_KirkReturnedShuckie::
	msgbox Johto_CianwoodHouse3_CianwoodCity_Text_ManiacHappinessSpeech, MSGBOX_DEFAULT
	closemessage
	end

Johto_CianwoodHouse3_CianwoodCity_Text_ManiacAskShuckle:
	.string "I, I'm in shock!\p"
	.string "A guy about your age with piercing\n"
	.string "eyes and long hair came in.\p"
	.string "He scared me into giving him my\n"
	.string "prized POKéMON!\p"
	.string "I still have one left, but what if\n"
	.string "he comes back?\p"
	.string "You look strong. Could you look\n"
	.string "after my POKéMON for a while?$"

Johto_CianwoodHouse3_CianwoodCity_Text_ManiacTakeCareShuckle:
	.string "Oh, thank you!\p"
	.string "Take good care of it, please!$"

Johto_CianwoodHouse3_CianwoodCity_Text_ManiacGotShuckle:
