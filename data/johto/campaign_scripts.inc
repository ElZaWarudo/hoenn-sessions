KantoLater_Route25_Route25_EventScript_Suicune::
	lock
	faceplayer
	playmoncry SPECIES_SUICUNE, CRY_MODE_NORMAL
	applymovement KantoLater_Route25_LOCALID_ROUTE25_SUICUNE, KantoLater_Route25_Route25_Movement_Suicune1
	playse SE_LEDGE
	waitse
	waitmovement 0
	playmoncry SPECIES_SUICUNE, CRY_MODE_ENCOUNTER
	delay 40
	waitmoncry
	seteventmon SPECIES_SUICUNE, 50
	special BattleSetup_StartLegendaryBattle
	waitstate
	specialvar JOHTO_VAR_RESULT, GetBattleOutcome
	goto_if_eq JOHTO_VAR_RESULT, B_OUTCOME_RAN, KantoLater_Route25_Route25_EventScript_SuicuneRan
	fadescreenswapbuffers FADE_TO_BLACK
	removeobject KantoLater_Route25_LOCALID_ROUTE25_SUICUNE
	setflag JOHTO_FLAG_HIDE_ROUTE25_SUICUNE
	fadescreenswapbuffers FADE_FROM_BLACK
	goto_if_ge JOHTO_VAR_SUICUNE_ENCOUNTERS, 8, KantoLater_Route25_Route25_EventScript_SuicunePostGame
	getplayerxy JOHTO_VAR_TEMP_0, JOHTO_VAR_TEMP_1
	call_if_eq JOHTO_VAR_TEMP_0, 66, KantoLater_Route25_Route25_AdjustPlayer
	turnobject OBJ_EVENT_ID_PLAYER, DIR_SOUTH
	turnobject KantoLater_Route25_LOCALID_ROUTE25_EUSINE, DIR_NORTH
	msgbox KantoLater_Route25_Route25_Text_Eusine3, MSGBOX_DEFAULT
	closemessage
	johto_applymovement2 KantoLater_Route25_LOCALID_ROUTE25_EUSINE, KantoLater_Route25_Route25_Movement_EusineLeave
	waitmovement 0
	removeobject KantoLater_Route25_LOCALID_ROUTE25_EUSINE
	setflag JOHTO_FLAG_HIDE_ROUTE25_EUSINE
	clearflag JOHTO_FLAG_HIDE_CELADON_EUSINE
	setvar JOHTO_VAR_SUICUNE_ENCOUNTERS, 8
	release
	end

