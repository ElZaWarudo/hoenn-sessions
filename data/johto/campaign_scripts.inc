Johto_VioletCity_VioletCity_MapScripts::
	map_script MAP_SCRIPT_ON_FRAME_TABLE, Johto_VioletCity_VioletCity_OnFrame
	map_script MAP_SCRIPT_ON_TRANSITION, Johto_VioletCity_VioletCity_OnTransition
