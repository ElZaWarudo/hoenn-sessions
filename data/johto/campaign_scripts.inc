	msgbox Johto_Gate_GoldenrodCity_Route35_Route35GoldenrodGate_Text_RandyThanks, MSGBOX_DEFAULT

	@HnS named gift pokemon setup
	setvar JOHTO_VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_SPEAROW
