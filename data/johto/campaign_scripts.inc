Johto_CianwoodGym_CianwoodGym_EventScript_Chuck::
	lock
	faceplayer
	goto_if_unset JOHTO_FLAG_HIDE_DOJO_CHUCK, Johto_CianwoodGym_CianwoodGym_EventScript_ChuckAtDojo
	goto_if_set JOHTO_FLAG_VISITED_VERMILION_CITY, Johto_CianwoodGym_CianwoodGym_EventScript_ChuckGotoDojo
	goto_if_set JOHTO_FLAG_DEFEATED_CIANWOOD_GYM, Johto_CianwoodGym_CianwoodGym_EventScript_Chuck_Defeated
	msgbox Johto_CianwoodGym_CianwoodGym_Text_ChuckIntro1, MSGBOX_DEFAULT
	applymovement Johto_CianwoodGym_LOCALID_CIANWOOD_CHUCK, Johto_CianwoodGym_CianwoodGym_Movement_ChuckLeft
	waitmovement 0
	message Johto_CianwoodGym_CianwoodGym_Text_ChuckIntro2
	applymovement Johto_CianwoodGym_LOCALID_CIANWOOD_CHUCK_ROCK_LEFT, Movement_SmashRock
	playse SE_M_ROCK_THROW
	waitmovement 0

	delay 20

	applymovement Johto_CianwoodGym_LOCALID_CIANWOOD_CHUCK, Johto_CianwoodGym_CianwoodGym_Movement_ChuckRight
	waitmovement 0
	applymovement Johto_CianwoodGym_LOCALID_CIANWOOD_CHUCK_ROCK_RIGHT, Movement_SmashRock
	playse SE_M_ROCK_THROW
	waitmovement 0
	waitmessage
	turnobject Johto_CianwoodGym_LOCALID_CIANWOOD_CHUCK, DIR_SOUTH
	msgbox Johto_CianwoodGym_CianwoodGym_Text_ChuckIntro3, MSGBOX_DEFAULT
	goto_if_set JOHTO_FLAG_DEFEATED_OLIVINE_CITY_GYM, Johto_CianwoodGym_CianwoodGym_EventScript_OlivineCheckMahog
	goto_if_set JOHTO_FLAG_DEFEATED_MAHOGANY_TOWN_GYM, Johto_CianwoodGym_CianwoodGym_EventScript_MahogCheckOlivine
	goto Johto_CianwoodGym_CianwoodGym_EventScript_Chuck_Battle1

