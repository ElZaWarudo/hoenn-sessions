	goto_if_eq JOHTO_VAR_KENYA, 3, Johto_Gate_GoldenrodCity_Route35_Gate_GoldenrodCity_Route35_EventScript_RandyPostKenya
	goto_if_eq JOHTO_VAR_KENYA, 2, Johto_Gate_GoldenrodCity_Route35_Gate_GoldenrodCity_Route35_EventScript_RandyDeliveredKenya
	goto_if_eq JOHTO_VAR_KENYA, 1, Johto_Gate_GoldenrodCity_Route35_Gate_GoldenrodCity_Route35_EventScript_RandyHaveKenya
	msgbox Johto_Gate_GoldenrodCity_Route35_Route35GoldenrodGate_Text_RandyAskFavor, MSGBOX_YESNO
