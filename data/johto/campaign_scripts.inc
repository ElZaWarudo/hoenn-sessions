@ source map: CianwoodHouse3
Johto_CianwoodHouse3_CianwoodHouse3_MapScripts::
	.byte 0

Johto_CianwoodHouse3_CianwoodCity_EventScript_Kirk::
	lock
	faceplayer
	goto_if_eq JOHTO_VAR_SHUCKIE, 1, Johto_CianwoodHouse3_CianwoodCity_EventScript_KirkGivenShuckie
	goto_if_eq JOHTO_VAR_SHUCKIE, 3, Johto_CianwoodHouse3_CianwoodCity_EventScript_KirkReturnedShuckie
	msgbox Johto_CianwoodHouse3_CianwoodCity_Text_ManiacAskShuckle, MSGBOX_YESNO
	goto_if_eq JOHTO_VAR_RESULT, FALSE, Johto_CianwoodHouse3_CianwoodCity_EventScript_KirkDeclined

	@HnS named gift pokemon setup
	setvar JOHTO_VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_SHUCKLE
	bufferspeciesname STR_VAR_1, SPECIES_SHUCKLE
	johto_givenamedmon 2
	call Johto_Closure_data_event_scripts_s_Common_EventScript_GiftMonNamed

	setvar JOHTO_VAR_SHUCKIE, 1
	release
	end

Johto_CianwoodHouse3_CianwoodCity_EventScript_KirkDeclined::
	msgbox Johto_CianwoodHouse3_CianwoodCity_Text_ManiacIfHeComesBack, MSGBOX_DEFAULT
	closemessage
	end

Johto_CianwoodHouse3_CianwoodCity_EventScript_KirkGivenShuckie::
	goto_if_set JOHTO_FLAG_BADGE01_GET, Johto_CianwoodHouse3_CianwoodCity_EventScript_KirkReturnShuckie
	msgbox Johto_CianwoodHouse3_CianwoodCity_Text_ManiacHowsdoing, MSGBOX_DEFAULT
	closemessage
	end

Johto_CianwoodHouse3_CianwoodCity_EventScript_KirkReturnShuckie::
	msgbox Johto_CianwoodHouse3_CianwoodCity_Text_ManiacAskReturn, MSGBOX_YESNO
	goto_if_eq JOHTO_VAR_RESULT, FALSE, Johto_CianwoodHouse3_CianwoodCity_EventScript_KirkDeclineReturnShuckie
	johto_removenamedmon 2
	goto_if_eq JOHTO_VAR_RESULT, MON_CANT_GIVE, Johto_CianwoodHouse3_CianwoodCity_EventScript_KirkNotRight
	goto_if_eq JOHTO_VAR_RESULT, 3, Johto_CianwoodHouse3_CianwoodCity_EventScript_KirkKeepShuckie
	playse MUS_OBTAIN_ITEM
	callnative UpdateFollowingPokemon
	msgbox Johto_CianwoodHouse3_CianwoodCity_Text_ManiacReturnedMon, MSGBOX_DEFAULT
	waitse
	msgbox Johto_CianwoodHouse3_CianwoodCity_Text_ManiacThankYou, MSGBOX_DEFAULT
	setvar JOHTO_VAR_SHUCKIE, 3
	release
	end

Johto_CianwoodHouse3_CianwoodCity_EventScript_KirkDeclineReturnShuckie::
	msgbox Johto_CianwoodHouse3_CianwoodCity_Text_ManiacRobbed2, MSGBOX_DEFAULT
	closemessage
	release
	end

Johto_CianwoodHouse3_CianwoodCity_EventScript_KirkNotRight::
	msgbox Johto_CianwoodHouse3_CianwoodCity_Text_ManiacRobbed, MSGBOX_DEFAULT
	closemessage
	release
	end

