Johto_OlivineCity_PortInside_OlivinePort_EventScript_Sailor_AfterKanto::
	message Johto_OlivineCity_PortInside_OlivinePort_Text_WhereSail
	multichoice 20, 0, MULTI_OLIVINE_HARBOR, FALSE
	switch JOHTO_VAR_RESULT
	case 0, Johto_OlivineCity_PortInside_OlivinePort_EventScript_ChoseVermilion
	case 1, Johto_OlivineCity_PortInside_OlivinePort_EventScript_ChoseSouthernIsland
	case 2, Johto_OlivineCity_PortInside_OlivinePort_EventScript_ChoseBirthIsland
	case 3, Johto_OlivineCity_PortInside_OlivinePort_EventScript_ChoseFarawayIsland
	case 4, Johto_OlivineCity_PortInside_OlivinePort_EventScript_ChoseBattleFrontier
	case 5, Johto_OlivineCity_PortInside_OlivinePort_EventScript_Sailor_Refused
	case MULTI_B_PRESSED, Johto_OlivineCity_PortInside_OlivinePort_EventScript_Sailor_Refused
	release
	end

Johto_OlivineCity_PortInside_OlivinePort_EventScript_ChoseVermilion::
	closemessage
	delay 20
	checkitem ITEM_SS_TICKET
	bufferitemname STR_VAR_1, ITEM_SS_TICKET
	goto_if_eq JOHTO_VAR_RESULT, FALSE, Johto_OlivineCity_PortInside_OlivinePort_EventScript_Sailor_NoCredentials
	call EventScript_ChooseKantoEra
	goto_if_eq JOHTO_VAR_RESULT, 0, Johto_OlivineCity_PortInside_OlivinePort_EventScript_Sailor_Refused
	special Johto_RecordCurrentHeal
	goto_if_eq JOHTO_VAR_RESULT, FALSE, Johto_OlivineCity_PortInside_OlivinePort_EventScript_ChoseVermilion_TravelFailed
	special Johto_PrepareKantoTravel
	goto_if_eq JOHTO_VAR_RESULT, FALSE, Johto_OlivineCity_PortInside_OlivinePort_EventScript_ChoseVermilion_TravelFailed
	goto Johto_OlivineCity_PortInside_OlivinePort_EventScript_ChoseVermilion_BeginTravel

Johto_OlivineCity_PortInside_OlivinePort_EventScript_ChoseVermilion_BeginTravel::
	call Johto_OlivineCity_PortInside_OlivinePort_EventScript_EnterShip
	switch JOHTO_VAR_PENDING_KANTO_DESTINATION
	case 2, Johto_OlivineCity_PortInside_OlivinePort_EventScript_ChoseVermilion_WarpOriginal
	case 3, Johto_OlivineCity_PortInside_OlivinePort_EventScript_ChoseVermilion_WarpLater
	goto Johto_OlivineCity_PortInside_OlivinePort_EventScript_ChoseVermilion_TravelFailed

Johto_OlivineCity_PortInside_OlivinePort_EventScript_ChoseVermilion_WarpOriginal::
	warpsilent MAP_KANTO_ORIGINAL_VERMILION_CITY_PORT_INSIDE, 8, 9
	release
	end

