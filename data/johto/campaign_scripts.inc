Johto_BurnedTower_1F_BurnedTower_1F_EventScript_Silver::
	lock
	playse SE_PIN
	applymovement Johto_BurnedTower_1F_LOCALID_BURNED_TOWER_SILVER, Common_Movement_ExclamationMark
	delay 60
	applymovement OBJ_EVENT_ID_PLAYER, Common_Movement_WalkRight
	applymovement Johto_BurnedTower_1F_LOCALID_BURNED_TOWER_SILVER, Common_Movement_WalkLeft
	waitmovement 0
	waitmovement 0
	msgbox Johto_BurnedTower_1F_BurnedTowerSilver_BeforeText, MSGBOX_DEFAULT
	call_if_eq JOHTO_VAR_STARTER_MON, 0, Johto_BurnedTower_1F_BurnedTower_1F_Silver_Battle_Cyndaquil
	call_if_eq JOHTO_VAR_STARTER_MON, 1, Johto_BurnedTower_1F_BurnedTower_1F_Silver_Battle_Totodile
	call_if_eq JOHTO_VAR_STARTER_MON, 2, Johto_BurnedTower_1F_BurnedTower_1F_Silver_Battle_Chikorita
	playbgm MUS_HG_RIVAL_EXIT, TRUE
	msgbox Johto_BurnedTower_1F_BurnedTowerSilver_AfterText1, MSGBOX_DEFAULT
	closemessage
	setvar VAR_0x8004, 1  @ vertical pan
	setvar VAR_0x8005, 1  @ horizontal pan
	setvar VAR_0x8006, 20  @ num shakes
	setvar VAR_0x8007, 6  @ shake delay
	special ShakeCamera
	waitstate
	playse SE_CLICK
	setmetatile 16, 12, 0x37E, FALSE
	special DrawWholeMapView
	waitse
	delay 60
	special SpawnCameraObject
	removeobject OBJ_EVENT_ID_PLAYER
	playse SE_FALL
	delay 60
	msgbox Johto_BurnedTower_1F_BurnedTowerSilver_AfterText2, MSGBOX_AUTOCLOSE
	waitmessage
	warphole MAP_BURNED_TOWER_B1F
	setvar JOHTO_VAR_ECRUTEAK_CITY_STATE, 3
	release
	end

