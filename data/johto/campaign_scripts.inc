Johto_Route34_DayCare_Route34_DayCare_EventScript_Clerk_GaveEgg::
	msgbox Johto_Route34_DayCare_Route34_DayCare_Text_TakeCare, MSGBOX_DEFAULT
	closemessage
	delay 30
	setflag JOHTO_FLAG_RECEIVED_ODD_EGG
	playfanfare MUS_OBTAIN_ITEM
