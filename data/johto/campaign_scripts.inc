	delay 55
	applymovement OBJ_EVENT_ID_PLAYER, Johto_RocketHideout_B2F_RocketHideout_B2F_Movement_LanceWalkToGenerator
	waitmovement 0

	applymovement Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_DRAGONITE, Johto_RocketHideout_B2F_RocketHideout_B2F_Movement_DragoniteInvestigateGenerator
	applymovement Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_LANCE, Johto_RocketHideout_B2F_RocketHideout_B2F_Movement_LanceInvestigateGenerator
	delay 165
	playmoncry SPECIES_DRAGONITE, CRY_MODE_NORMAL
	waitmovement Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_DRAGONITE
	waitmovement Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_LANCE
	msgbox Johto_RocketHideout_B2F_RocketHideout_B2F_Text_LanceElectrodeFaint, MSGBOX_DEFAULT
