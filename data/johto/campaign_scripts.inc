Johto_OlivineCity_Lighthouse_OlivineLighthouse_EventScript_JasmineDeliverPotion::
	msgbox Johto_OlivineCity_Lighthouse_OlivineLighthouse_Text_JasmineCureAmphy, MSGBOX_YESNO
	goto_if_eq JOHTO_VAR_RESULT, FALSE, Johto_OlivineCity_Lighthouse_OlivineLighthouse_EventScript_JasmineRefuse
	playse SE_USE_ITEM
	removeitem ITEM_SECRET_POTION
	msgbox Johto_OlivineCity_Lighthouse_OlivineLighthouse_Text_PlayerHandedSecretpotion, MSGBOX_DEFAULT
	waitse
	msgbox Johto_OlivineCity_Lighthouse_OlivineLighthouse_Text_JasmineDontBeOffended, MSGBOX_DEFAULT
	closemessage
	turnobject Johto_OlivineCity_Lighthouse_LOCALID_LIGHTHOUSE_JASMINE, DIR_NORTH
	delay 20
	turnobject Johto_OlivineCity_Lighthouse_LOCALID_LIGHTHOUSE_AMPHAROS, DIR_SOUTH
	playse MUS_HEAL
	waitse
	msgbox Johto_OlivineCity_Lighthouse_OlivineLighthouse_Text_JasmineAmphyHowFeeling, MSGBOX_DEFAULT
	fadescreen FADE_TO_WHITE
	playse SE_M_THUNDERBOLT2
	waitse
	fadescreen FADE_FROM_WHITE
	playmoncry SPECIES_AMPHAROS, CRY_MODE_NORMAL
	msgbox Johto_OlivineCity_Lighthouse_OlivineLighthouse_Text_AmphyPaluPalulu, MSGBOX_DEFAULT
	waitmoncry
	closemessage
	applymovement Johto_OlivineCity_Lighthouse_LOCALID_LIGHTHOUSE_AMPHAROS, Johto_OlivineCity_Lighthouse_OlivineLighthouse_Movement_Amphy
	waitmovement 0
	applymovement Johto_OlivineCity_Lighthouse_LOCALID_LIGHTHOUSE_JASMINE, Johto_OlivineCity_Lighthouse_OlivineLighthouse_Movement_Jasmine
	msgbox Johto_OlivineCity_Lighthouse_OlivineLighthouse_Text_JasmineThankYou, MSGBOX_DEFAULT
	closemessage

	fadescreen FADE_TO_BLACK
	playse SE_EXIT
	setflag JOHTO_FLAG_HIDE_LIGHTHOUSE_JASMINE
	removeobject Johto_OlivineCity_Lighthouse_LOCALID_LIGHTHOUSE_JASMINE
	waitse
	delay 50
	fadescreen FADE_FROM_BLACK
	setvar JOHTO_VAR_SAFARI_ZONE_GATE_STATE, 1
	setvar JOHTO_VAR_OLIVINE_CITY_STATE, 5
	setflag JOHTO_FLAG_AMPHAROS_HEALED
	clearflag JOHTO_FLAG_HIDE_OLIVINE_CITY_GYM_JASMINE
	release
	end

