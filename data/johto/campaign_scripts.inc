	goto_if_eq JOHTO_VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull
	setflag JOHTO_FLAG_GOT_HARD_STONE
	msgbox Johto_Route36_Route36_Text_ArthurGaveGift, MSGBOX_DEFAULT
