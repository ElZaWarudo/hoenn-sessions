Johto_OlivineCity_PortInside_OlivinePort_EventScript_Sailor::
	lock
	faceplayer
	goto_if_ge JOHTO_VAR_SSAQUA_STATE, 7, Johto_OlivineCity_PortInside_OlivinePort_EventScript_Sailor_AfterKanto
	msgbox Johto_OlivineCity_PortInside_OlivinePort_Text_AskBoard, MSGBOX_YESNO
	goto_if_eq JOHTO_VAR_RESULT, FALSE, Johto_OlivineCity_PortInside_OlivinePort_EventScript_Sailor_Refused
	checkitem ITEM_SS_TICKET
	goto_if_eq JOHTO_VAR_RESULT, TRUE, Johto_OlivineCity_PortInside_OlivinePort_EventScript_Sailor_MaidenVoyage
	msgbox Johto_OlivineCity_PortInside_OlivinePort_Text_NoTicket, MSGBOX_DEFAULT
	closemessage
