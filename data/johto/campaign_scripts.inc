	checkitem ITEM_HEART_SCALE
	goto_if_eq JOHTO_VAR_RESULT, FALSE, Johto_BlackthornCity_House3_BlackthornCity_MoveRelearnersHouse_EventScript_ComeBackWithHeartScale
	msgbox Johto_BlackthornCity_House3_BlackthornCity_MoveRelearnersHouse_Text_ThatsAHeartScaleWantMeToTeachMove, MSGBOX_YESNO
	switch JOHTO_VAR_RESULT
	case NO, Johto_BlackthornCity_House3_BlackthornCity_MoveRelearnersHouse_EventScript_ComeBackWithHeartScale
	goto Johto_BlackthornCity_House3_BlackthornCity_MoveRelearnersHouse_EventScript_ChooseMon
	end

Johto_BlackthornCity_House3_BlackthornCity_MoveRelearnersHouse_EventScript_ChooseMon::
	msgbox Johto_BlackthornCity_House3_BlackthornCity_MoveRelearnersHouse_Text_TutorWhichMon, MSGBOX_DEFAULT
	special ChooseMonForMoveRelearner
	waitstate
	goto_if_eq VAR_0x8004, PARTY_NOTHING_CHOSEN, Johto_BlackthornCity_House3_BlackthornCity_MoveRelearnersHouse_EventScript_ComeBackWithHeartScale
	special IsSelectedMonEgg
	goto_if_eq JOHTO_VAR_RESULT, TRUE, Johto_BlackthornCity_House3_BlackthornCity_MoveRelearnersHouse_EventScript_CantTeachEgg
	goto_if_eq VAR_0x8005, 0, Johto_BlackthornCity_House3_BlackthornCity_MoveRelearnersHouse_EventScript_NoMoveToTeachMon
	goto Johto_BlackthornCity_House3_BlackthornCity_MoveRelearnersHouse_EventScript_ChooseMove
	end

Johto_BlackthornCity_House3_BlackthornCity_MoveRelearnersHouse_EventScript_ChooseMove::
