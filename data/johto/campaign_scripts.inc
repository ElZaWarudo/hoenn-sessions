	playfanfare MUS_OBTAIN_ITEM
	message LavaridgeTown_Text_ReceivedTheEgg
	waitfanfare
	msgbox Johto_VioletCity_PokemonCenter_VioletCity_PokeCenter_Text_ElmsAideGiveEgg, MSGBOX_DEFAULT
