Johto_Route36_Route36_EventScript_Arthur::
	lock
	faceplayer
	goto_if_set JOHTO_FLAG_GOT_HARD_STONE, Johto_Route36_Route36_EventScript_ArthurCompleted
	msgbox Johto_Route36_Route36_Text_MeetArthur, MSGBOX_DEFAULT
	closemessage
	multichoice 20, 0, MULTI_DAYS_OF_WEEK, FALSE
	switch JOHTO_VAR_RESULT
	case 0, Johto_Route36_Route36_EventScript_ArthurNope
	case 1, Johto_Route36_Route36_EventScript_ArthurNope
	case 2, Johto_Route36_Route36_EventScript_ArthurNope
	case 3, Johto_Route36_Route36_EventScript_ArthurNope
	case 4, Johto_Route36_Route36_EventScript_ArthurYes
	case 5, Johto_Route36_Route36_EventScript_ArthurNope
	case 6, Johto_Route36_Route36_EventScript_ArthurNope
	case 7, Johto_Route36_Route36_EventScript_ArthurCancel
	case MULTI_B_PRESSED, Johto_Route36_Route36_EventScript_ArthurCancel
	closemessage
	release
	end
