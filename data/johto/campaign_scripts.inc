Johto_OlivineCity_OlivineCity_EventScript_BaobaCall::
	lock
	pokenavcall Johto_OlivineCity_OlivineCity_Text_Baoba
	waitmessage
	delay 30
	setvar JOHTO_VAR_SAFARI_ZONE_GATE_STATE, 2
	release
	end

Johto_OlivineCity_OlivineCity_Text_Baoba:
	.string "{PLAYER}!\p"
	.string "This is WARDEN BAOBA.\p"
	.string "Sorry to have kept you waiting.\n"
	.string "We've finally opened the\l"
	.string "SAFARI ZONE!\p"
	.string "Do you know where it is?\p"
	.string "You know the GATE inside the cavern\n"
	.string "in CIANWOOD CITY?\p"
	.string "If you go through there and walk for\n"
	.string "a short while, you should soon see\l"
	.string "the SAFARI ZONE!\p"
	.string "We're a little out of the way, but\n"
	.string "please come visit!$"

Johto_OlivineCity_OlivineCity_EventScript_CityTrigger:: @FLAGHEAP
	setflag JOHTO_FLAG_HIDE_OLIVINE_CITY_GYM_JASMINE
	setflag JOHTO_FLAG_HIDE_OLIVINE_SILVER
	setflag JOHTO_FLAG_VISITED_OLIVINE_CITY
	clearflag JOHTO_FLAG_SAFARI_ZONE_WEST_EXPANSION
	clearflag JOHTO_FLAG_SAFARI_ZONE_EAST_EXPANSION
	clearflag JOHTO_FLAG_HIDE_BATTLEFRONTIER_ENGINEER
	clearflag JOHTO_FLAG_HIDE_LIGHTHOUSE_JASMINE
	clearflag JOHTO_FLAG_HIDE_WHIRL_ISLANDS_TENTACRUEL
	setvar JOHTO_VAR_GETFLY, 0

	setvar JOHTO_VAR_OLIVINE_CITY_STATE, 1

	@cianwood flags
	setvar JOHTO_VAR_SUICUNE_ENCOUNTERS, 1
	clearflag JOHTO_FLAG_HIDE_CIANWOOD_SUICUNE
	setflag JOHTO_FLAG_HIDE_CIANWOOD_EUSINE
	setvar JOHTO_VAR_CIANWOOD_CITY_STATE, 1
	end

Johto_OlivineCity_OlivineCity_EventScript_SilverTrigger::
	lock
	clearflag JOHTO_FLAG_HIDE_OLIVINE_SILVER
	opendoor 11, 27
	addobject Johto_OlivineCity_LOCALID_OLIVINE_SILVER
	playbgm MUS_HG_ENCOUNTER_RIVAL, TRUE
	delay 20
	closedoor 11, 27
	getplayerxy JOHTO_VAR_TEMP_0, JOHTO_VAR_TEMP_1
	call_if_eq JOHTO_VAR_TEMP_1, 28, Johto_OlivineCity_OlivineCity_EventScript_SilverWalkToPlayer1
	call_if_eq JOHTO_VAR_TEMP_1, 29, Johto_OlivineCity_OlivineCity_EventScript_SilverWalkToPlayer2
	call_if_eq JOHTO_VAR_TEMP_1, 30, Johto_OlivineCity_OlivineCity_EventScript_SilverWalkToPlayer3
	msgbox Johto_OlivineCity_OlivineCity_Text_SilverEncounter, MSGBOX_DEFAULT
	closemessage
	call_if_eq JOHTO_VAR_TEMP_1, 28, Johto_OlivineCity_OlivineCity_EventScript_SilverLeaveAdjust1
	call_if_eq JOHTO_VAR_TEMP_1, 29, Johto_OlivineCity_OlivineCity_EventScript_SilverLeaveAdjust2
	call_if_eq JOHTO_VAR_TEMP_1, 30, Johto_OlivineCity_OlivineCity_EventScript_SilverLeaveAdjust2
	applymovement Johto_OlivineCity_LOCALID_OLIVINE_SILVER, Johto_OlivineCity_OlivineCity_Movement_SilverLeave
	waitmovement 0
	setvar JOHTO_VAR_OLIVINE_CITY_STATE, 2
	setflag JOHTO_FLAG_HIDE_OLIVINE_SILVER
	removeobject Johto_OlivineCity_LOCALID_OLIVINE_SILVER
	fadedefaultbgm
	release
	end

Johto_OlivineCity_OlivineCity_EventScript_SilverWalkToPlayer1::
	applymovement Johto_OlivineCity_LOCALID_OLIVINE_SILVER Johto_OlivineCity_OlivineCity_Movement_SilverWalkToPlayer1
	waitmovement 0
	return

Johto_OlivineCity_OlivineCity_EventScript_SilverWalkToPlayer2::
