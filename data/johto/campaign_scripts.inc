Johto_CianwoodCity_CianwoodCity_EventScript_Flytrigger::
	lock
	playse SE_PIN
	applymovement Johto_CianwoodCity_LOCALID_CIANWOOD_CHUCKSWIFE, Common_Movement_ExclamationMark
	delay 60
	applymovement Johto_CianwoodCity_LOCALID_CIANWOOD_CHUCKSWIFE, Johto_CianwoodCity_CianwoodCity_Movement_ChucksWife
	waitmovement 0
	msgbox Johto_CianwoodCity_CianwoodCity_Text_ChucksWifeGiveHM, MSGBOX_DEFAULT
	giveitem ITEM_HM_FLY
	msgbox Johto_CianwoodCity_CianwoodCity_Text_ChucksWifeFlySpeech, MSGBOX_DEFAULT
