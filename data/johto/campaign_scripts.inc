Johto_Route34_DayCare_Route34_DayCare_EventScript_Clerk::
	lock
	faceplayer
	goto_if_set JOHTO_FLAG_RECEIVED_ODD_EGG, Johto_Route34_DayCare_Route34_DayCare_EventScript_ClerkAfter
	msgbox Johto_Route34_DayCare_Route34_DayCare_Text_ClerkBefore, MSGBOX_DEFAULT
	getpartysize
	goto_if_eq JOHTO_VAR_RESULT, PARTY_SIZE, Johto_Route34_DayCare_Route34_DayCare_EventScript_ClerkPartyFull
	msgbox Johto_Route34_DayCare_Route34_DayCare_Text_ClerkQuestion, MSGBOX_DEFAULT
	closemessage
	setvar VAR_0x8004, EASY_CHAT_TYPE_INTERVIEW
	setvar VAR_0x8005, 0
	call Common_ShowEasyChatScreen
	lock
	faceplayer
	switch JOHTO_VAR_RESULT
	case 0, Johto_Route34_DayCare_Route34_DayCare_EventScript_ClerkRejection
	case 1, Johto_Route34_DayCare_Route34_DayCare_EventScript_GivePichu
	case 2, Johto_Route34_DayCare_Route34_DayCare_EventScript_GiveCleffa
	case 3, Johto_Route34_DayCare_Route34_DayCare_EventScript_GiveIgglybuff
	case 4, Johto_Route34_DayCare_Route34_DayCare_EventScript_GiveTyrogue
	case 5, Johto_Route34_DayCare_Route34_DayCare_EventScript_GiveSmoochum
	case 6, Johto_Route34_DayCare_Route34_DayCare_EventScript_GiveElekid
	case 7, Johto_Route34_DayCare_Route34_DayCare_EventScript_GiveMagby
	closemessage
	release
	end

Johto_Route34_DayCare_Route34_DayCare_EventScript_GivePichu::
	johto_giveoddegg 1
	goto Johto_Route34_DayCare_Route34_DayCare_EventScript_Clerk_GaveEgg

Johto_Route34_DayCare_Route34_DayCare_EventScript_GiveCleffa::
	johto_giveoddegg 2
	goto Johto_Route34_DayCare_Route34_DayCare_EventScript_Clerk_GaveEgg

Johto_Route34_DayCare_Route34_DayCare_EventScript_GiveIgglybuff::
