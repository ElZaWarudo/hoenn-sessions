	message Johto_CianwoodGym_CianwoodGym_Text_GetStormBadge
	waitmessage
	call Common_EventScript_PlayGymBadgeFanfare
	msgbox Johto_CianwoodGym_CianwoodGym_Text_ChuckBadgeSpeech, MSGBOX_DEFAULT
	setflag JOHTO_FLAG_BADGE05_GET
	setflag JOHTO_FLAG_DEFEATED_CIANWOOD_GYM
	addvar JOHTO_VAR_NUM_BADGES, 1
	setvar VAR_0x8008, 5
	call Johto_Closure_data_scripts_set_gym_trainers_inc_Common_EventScript_SetGymTrainers
	giveitem ITEM_TM_FOCUS_PUNCH
	msgbox Johto_CianwoodGym_CianwoodGym_Text_ChuckTMSpeech, MSGBOX_DEFAULT
	setvar JOHTO_VAR_GETFLY, 1
	setrespawn HEAL_LOCATION_CIANWOOD_CITY
	closemessage
	release
	end

