Johto_RuinsOfAlph_Lab_RuinsOfAlph_Lab_EventScript_ChooseFossil::
	message Johto_RuinsOfAlph_Lab_RuinsOfAlph_Lab_Text_TwoFossilsPickOne
	waitmessage
	multichoice 17, 0, MULTI_FOSSIL, FALSE
	switch JOHTO_VAR_RESULT
	case 0, Johto_RuinsOfAlph_Lab_RuinsOfAlph_Lab_EventScript_ChooseClawFossil
	case 1, Johto_RuinsOfAlph_Lab_RuinsOfAlph_Lab_EventScript_ChooseRootFossil
