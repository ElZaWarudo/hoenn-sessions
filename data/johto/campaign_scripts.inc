.set Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_LANCE, 3
.set Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_DRAGONITE,4
.set Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_ROCKET, 2

Johto_MahoganyTown_Shop_MahoganyTown_Shop_MapScripts::
	map_script MAP_SCRIPT_ON_LOAD, Johto_MahoganyTown_Shop_MahoganyTown_Shop_OnLoad
	map_script MAP_SCRIPT_ON_FRAME_TABLE, Johto_MahoganyTown_Shop_MahoganyTown_Shop_OnFrame
	.byte 0

Johto_MahoganyTown_Shop_MahoganyTown_Shop_OnLoad:
	goto_if_ge JOHTO_VAR_MAHOGANY_TOWN_STATE, 5, Johto_MahoganyTown_Shop_MahoganyTown_Shop_SetStairs
	end

Johto_MahoganyTown_Shop_MahoganyTown_Shop_SetStairs::
	setmetatile 8, 4, 0x28D, FALSE
	end

Johto_MahoganyTown_Shop_MahoganyTown_Shop_OnFrame::
	map_script_2 JOHTO_VAR_MAHOGANY_TOWN_STATE, 4, Johto_MahoganyTown_Shop_MahoganyTown_Shop_EventScript_Raid
	.2byte 0

Johto_MahoganyTown_Shop_MahoganyTown_Shop_EventScript_Raid::
	playbgm MUS_HG_TEAM_ROCKET_HQ, TRUE
	lock
	playse SE_PIN
	applymovement OBJ_EVENT_ID_PLAYER, Common_Movement_ExclamationMark
	delay 60
	msgbox Johto_MahoganyTown_Shop_MahoganyMart1F_Text_Lance_HyperBeam, MSGBOX_DEFAULT
	closemessage
	playse SE_M_HYPER_BEAM
	applymovement Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_DRAGONITE, Johto_MahoganyTown_Shop_MahoganyTown_Shop_Movement_Dragonite1
	delay 10
	applymovement Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_ROCKET, Johto_MahoganyTown_Shop_MahoganyTown_Shop_Movement_Rocket1
	waitmovement Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_ROCKET
	waitse
	setvar VAR_0x8004, 1  @ vertical pan
	setvar VAR_0x8005, 1  @ horizontal pan
	setvar VAR_0x8006, 5  @ num shakes
	setvar VAR_0x8007, 6  @ shake delay
	special ShakeCamera
	waitmovement Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_DRAGONITE
	waitse
	delay 10
	turnobject Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_LANCE, DIR_SOUTH
	delay 50
	applymovement Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_LANCE, Johto_MahoganyTown_Shop_MahoganyTown_Shop_Movement_LanceGreetPlayer
	waitmovement 0
	msgbox Johto_MahoganyTown_Shop_MahoganyMart1F_Text_Lance_Radio, MSGBOX_DEFAULT
	closemessage
	playse SE_PIN
	applymovement Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_DRAGONITE, Common_Movement_QuestionMark
	delay 10
	applymovement Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_DRAGONITE, Johto_MahoganyTown_Shop_MahoganyTown_Shop_Movement_DragoniteGotoBox
	waitmovement 0
	playmoncry SPECIES_DRAGONITE, CRY_MODE_NORMAL
	waitmovement 0
	applymovement Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_LANCE, Johto_MahoganyTown_Shop_MahoganyTown_Shop_Movement_LanceGotoBox
	applymovement OBJ_EVENT_ID_PLAYER, Johto_MahoganyTown_Shop_MahoganyTown_Shop_Movement_PlayerGotoBox
	waitmovement Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_LANCE
	waitmovement OBJ_EVENT_ID_PLAYER

	playse SE_M_HYPER_BEAM
	applymovement Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_DRAGONITE, Johto_MahoganyTown_Shop_MahoganyTown_Shop_Movement_Dragonite2
	delay 20
	waitse
	setvar VAR_0x8004, 1  @ vertical pan
	setvar VAR_0x8005, 1  @ horizontal pan
	setvar VAR_0x8006, 5  @ num shakes
	setvar VAR_0x8007, 6  @ shake delay
	special ShakeCamera

	waitmovement 0

	setmetatile 8, 4, 0x28D, FALSE
	special DrawWholeMapView
	delay 40
	msgbox Johto_MahoganyTown_Shop_MahoganyMart1F_Text_Lance_Stairs, MSGBOX_DEFAULT
	turnobject Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_DRAGONITE, DIR_WEST
	playmoncry SPECIES_DRAGONITE, CRY_MODE_NORMAL
	waitmoncry
	turnobject Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_DRAGONITE, DIR_EAST

	turnobject Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_LANCE, DIR_SOUTH
	msgbox Johto_MahoganyTown_Shop_MahoganyMart1F_Text_Lance_SplitUp, MSGBOX_DEFAULT
	closemessage
	applymovement Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_DRAGONITE, Common_Movement_WalkRight
	waitmovement 0
	removeobject Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_DRAGONITE
	playse SE_EXIT
	applymovement Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_LANCE, Common_Movement_WalkRight
	waitmovement 0
	applymovement Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_LANCE, Common_Movement_WalkRight
	waitmovement 0
	removeobject Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_LANCE
	playse SE_EXIT
	delay 50

	playse SE_PIN
	applymovement Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_ROCKET Common_Movement_ExclamationMark
	delay 20
	applymovement Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_ROCKET Johto_MahoganyTown_Shop_MahoganyTown_Shop_Movement_RocketLeave
	waitmovement 0
	removeobject Johto_MahoganyTown_Shop_LOCALID_MAHOGANYSHOP_ROCKET
	playse SE_EXIT
	setflag JOHTO_FLAG_HIDE_MAHOGANY_TOWN_SHOP_NPCS


	setvar JOHTO_VAR_MAHOGANY_TOWN_STATE, 5
	release
	end

Johto_MahoganyTown_Shop_MahoganyTown_Shop_Movement_RocketLeave:
	walk_faster_left
	walk_faster_left
	walk_faster_up
	walk_faster_up
	walk_faster_up
	walk_faster_up
	walk_faster_right
	walk_faster_right
	step_end

Johto_MahoganyTown_Shop_MahoganyTown_Shop_Movement_Dragonite1:
	lock_facing_direction
	walk_fast_right
	walk_fast_right
	walk_fast_left
	walk_fast_left
	unlock_facing_direction
	step_end

Johto_MahoganyTown_Shop_MahoganyTown_Shop_Movement_Dragonite2:
	lock_facing_direction
	walk_fast_right
	walk_fast_left
