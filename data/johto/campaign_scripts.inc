	message Route121_SafariZoneEntrance_Text_Received30SafariBalls
	waitfanfare
	msgbox Route121_SafariZoneEntrance_Text_PleaseEnjoyYourself, MSGBOX_DEFAULT
	closemessage
	hidemoneybox
	getplayerxy JOHTO_VAR_TEMP_0, JOHTO_VAR_TEMP_1
	call_if_eq JOHTO_VAR_TEMP_0, 4, KantoLater_FuchsiaCity_SafariZoneEntrance_FuchsiaCity_SafariZoneEntrance_EventScript_CorrectionLeft
	call_if_eq JOHTO_VAR_TEMP_0, 6, KantoLater_FuchsiaCity_SafariZoneEntrance_FuchsiaCity_SafariZoneEntrance_EventScript_CorrectionRight
	applymovement OBJ_EVENT_ID_PLAYER, KantoLater_FuchsiaCity_SafariZoneEntrance_FuchsiaCity_SafariZoneEntrance_Movement_EnterSafariZone
	waitmovement 0
	setflag JOHTO_FLAG_IN_KANTO_SAFARI_ZONE
	special EnterSafariMode
	setvar JOHTO_VAR_SAFARI_ZONE_STATE, 2
	clearflag JOHTO_FLAG_GOOD_LUCK_SAFARI_ZONE
	warp MAP_KANTO_LATER_FUCHSIA_CITY_SAFARI_ZONE_BEACH, 1
	waitstate
	end

