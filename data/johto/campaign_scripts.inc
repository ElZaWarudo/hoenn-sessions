	switch JOHTO_VAR_RESULT
	case 0, Johto_Route32_Route32_EventScript_FriedaNope
	case 1, Johto_Route32_Route32_EventScript_FriedaNope
	case 2, Johto_Route32_Route32_EventScript_FriedaNope
	case 3, Johto_Route32_Route32_EventScript_FriedaNope
	case 4, Johto_Route32_Route32_EventScript_FriedaNope
	case 5, Johto_Route32_Route32_EventScript_FriedaYes
	case 6, Johto_Route32_Route32_EventScript_FriedaNope
	case 7, Johto_Route32_Route32_EventScript_FriedaCancel
	case MULTI_B_PRESSED, Johto_Route32_Route32_EventScript_FriedaCancel
	closemessage
	release
	end
