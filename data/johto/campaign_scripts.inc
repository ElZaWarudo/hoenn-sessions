	removeobject Johto_RocketHideout_B2F_LOCALID_LANCEELECTRODE1
	removeobject Johto_RocketHideout_B2F_LOCALID_LANCEELECTRODE2
	removeobject Johto_RocketHideout_B2F_LOCALID_LANCEELECTRODE3
	waitse
	getplayerxy JOHTO_VAR_TEMP_0, JOHTO_VAR_TEMP_1
	call_if_eq JOHTO_VAR_TEMP_1, 16, Johto_RocketHideout_B2F_RocketHideout_B2F_Movement_PlayerMeetLanceTop
	call_if_eq JOHTO_VAR_TEMP_1, 18, Johto_RocketHideout_B2F_RocketHideout_B2F_Movement_PlayerMeetLanceBot
	turnobject OBJ_EVENT_ID_PLAYER, DIR_EAST
	applymovement Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_LANCE, Johto_RocketHideout_B2F_RocketHideout_B2F_Movement_LanceMeetPlayerAfterElectrode
	applymovement Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_DRAGONITE, Johto_RocketHideout_B2F_RocketHideout_B2F_Movement_LanceMeetPlayerAfterElectrode
	waitmovement Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_DRAGONITE

	playse SE_CLICK
	turnobject OBJ_EVENT_ID_PLAYER, DIR_NORTH
	turnobject Johto_RocketHideout_B2F_LOCALID_ROCKETHIDEOUT2_LANCE, DIR_NORTH
