Johto_GoldenrodCity_RadioTower_5F_GoldenrodCity_RadioTower_5F_EventScript_Archer::
	lock
	faceplayer
	msgbox Johto_GoldenrodCity_RadioTower_5F_GoldenrodCity_RadioTower_5F_Text_RocketBossSeen, MSGBOX_DEFAULT
	trainerbattle_no_intro JOHTO_TRAINER_ARCHER, Johto_GoldenrodCity_RadioTower_5F_GoldenrodCity_RadioTower_5F_Text_RocketBossBeaten
	msgbox Johto_GoldenrodCity_RadioTower_5F_GoldenrodCity_RadioTower_5F_Text_RocketBossAfter, MSGBOX_DEFAULT
	delay 55
	closemessage
	fadescreen FADE_TO_BLACK
	setflag JOHTO_FLAG_HIDE_GOLDENROD_ROCKETS
	playse SE_EXIT
	setvar JOHTO_VAR_GOLDENROD_CITY_STATE, 10
	removeobject Johto_GoldenrodCity_RadioTower_5F_LOCALID_GOLDENROD_ARCHER
	removeobject Johto_GoldenrodCity_RadioTower_5F_LOCALID_GOLDENROD_ARIANA
	setflag JOHTO_FLAG_HIDE_GOLDENROD_RADIOTOWER_PETREL
	clearflag JOHTO_FLAG_HIDE_GOLDENROD_RADIOTOWER_DIRECTOR
	removeobject Johto_GoldenrodCity_RadioTower_5F_LOCALID_PETREL_OFFICE
	addobject Johto_GoldenrodCity_RadioTower_5F_LOCALID_DIRECTOR_STUDIO
	playbgm MUS_HG_GOLDENROD, TRUE
	delay 120
	fadescreen FADE_FROM_BLACK
	goto_if_eq JOHTO_VAR_FACING, DIR_SOUTH, Johto_GoldenrodCity_RadioTower_5F_GoldenrodCity_RadioTower_5F_EventScript_WingTop
	goto_if_eq JOHTO_VAR_FACING, DIR_WEST, Johto_GoldenrodCity_RadioTower_5F_GoldenrodCity_RadioTower_5F_EventScript_WingMid
	goto_if_eq JOHTO_VAR_FACING, DIR_NORTH, Johto_GoldenrodCity_RadioTower_5F_GoldenrodCity_RadioTower_5F_EventScript_WingBot
	release
	end

