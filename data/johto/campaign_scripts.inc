	release
	end

Johto_Route34_DayCare_Route34_DayCare_EventScript_YourMonHasGrownXLevels::
	msgbox Johto_Route34_DayCare_Route34_DayCare_Text_YourMonHasGrownXLevels, MSGBOX_DEFAULT
	return

Johto_Route34_DayCare_Route34_DayCare_EventScript_DisplayLevelsGained::
	specialvar JOHTO_VAR_RESULT, GetNumLevelsGainedFromDaycare
	call_if_ne JOHTO_VAR_RESULT, 0, Johto_Route34_DayCare_Route34_DayCare_EventScript_YourMonHasGrownXLevels
	return

Johto_Route34_DayCare_Route34_DayCare_EventScript_OneMonInDaycare::
	msgbox Johto_Route34_DayCare_Route34_DayCare_Text_GoodToSeeYou, MSGBOX_DEFAULT
	setvar VAR_0x8004, 0
	call Johto_Route34_DayCare_Route34_DayCare_EventScript_DisplayLevelsGained
	msgbox Johto_Route34_DayCare_Route34_DayCare_Text_WeCanRaiseOneMore, MSGBOX_YESNO
	goto_if_eq JOHTO_VAR_RESULT, YES, Johto_Route34_DayCare_Route34_DayCare_EventScript_GiveMonToRaise
	msgbox Johto_Route34_DayCare_Route34_DayCare_Text_TakeYourMonBack, MSGBOX_YESNO
	goto_if_eq JOHTO_VAR_RESULT, YES, Johto_Route34_DayCare_Route34_DayCare_EventScript_TryRetrieveMon
	goto Johto_Route34_DayCare_Route34_DayCare_EventScript_ComeAgain
	end

Johto_Route34_DayCare_Route34_DayCare_EventScript_TryRetrieveMon::
	setvar VAR_0x8004, PARTY_SIZE
	specialvar JOHTO_VAR_RESULT, CalculatePlayerPartyCount
	goto_if_eq JOHTO_VAR_RESULT, VAR_0x8004, Johto_Route34_DayCare_Route34_DayCare_EventScript_NoRoom
	specialvar JOHTO_VAR_RESULT, GetDaycareState
	setvar VAR_0x8004, 0
	goto_if_eq JOHTO_VAR_RESULT, DAYCARE_ONE_MON, Johto_Route34_DayCare_Route34_DayCare_EventScript_CostPrompt
	special ShowDaycareLevelMenu
	waitstate
	copyvar VAR_0x8004, JOHTO_VAR_RESULT
	goto_if_eq JOHTO_VAR_RESULT, DAYCARE_EXITED_LEVEL_MENU, Johto_Route34_DayCare_Route34_DayCare_EventScript_ComeAgain
	goto Johto_Route34_DayCare_Route34_DayCare_EventScript_CostPrompt
	end

Johto_Route34_DayCare_Route34_DayCare_EventScript_CostPrompt::
	special GetDaycareCost
	msgbox Johto_Route34_DayCare_Route34_DayCare_Text_ItWillCostX, MSGBOX_YESNO
	goto_if_eq JOHTO_VAR_RESULT, YES, Johto_Route34_DayCare_Route34_DayCare_EventScript_CheckEnoughMoney
	goto Johto_Route34_DayCare_Route34_DayCare_EventScript_ComeAgain
	end

Johto_Route34_DayCare_Route34_DayCare_EventScript_CheckEnoughMoney::
	specialvar JOHTO_VAR_RESULT, IsEnoughForCostInVar0x8005
	goto_if_eq JOHTO_VAR_RESULT, 1, Johto_Route34_DayCare_Route34_DayCare_EventScript_RetrieveMon
	msgbox Johto_Route34_DayCare_Route34_DayCare_Text_NotEnoughMoney, MSGBOX_DEFAULT
	release
	end

Johto_Route34_DayCare_Route34_DayCare_EventScript_RetrieveMon::
	@applymovement LOCALID_DAYCARE_LADY, Route34_DayCare_Movement_RetrieveDaycareMon
	@waitmovement 0
	specialvar JOHTO_VAR_RESULT, TakePokemonFromDaycare
	special SubtractMoneyFromVar0x8005
	playse SE_SHOP
	msgbox Johto_Route34_DayCare_Route34_DayCare_Text_HeresYourMon, MSGBOX_DEFAULT
	waitse
	playmoncry JOHTO_VAR_RESULT, CRY_MODE_NORMAL
	msgbox Johto_Route34_DayCare_Route34_DayCare_Text_TookBackMon, MSGBOX_DEFAULT
	waitmoncry
	specialvar JOHTO_VAR_RESULT, GetDaycareState
	goto_if_eq JOHTO_VAR_RESULT, DAYCARE_ONE_MON, Johto_Route34_DayCare_Route34_DayCare_EventScript_AskRetrieveOtherMon
	goto Johto_Route34_DayCare_Route34_DayCare_EventScript_ComeAgain
	end

Johto_Route34_DayCare_Route34_DayCare_EventScript_AskRetrieveOtherMon::
	msgbox Johto_Route34_DayCare_Route34_DayCare_Text_TakeOtherOneBackToo, MSGBOX_YESNO
	goto_if_eq JOHTO_VAR_RESULT, YES, Johto_Route34_DayCare_Route34_DayCare_EventScript_TryRetrieveMon
	goto Johto_Route34_DayCare_Route34_DayCare_EventScript_ComeAgain
	end

Johto_Route34_DayCare_Route34_DayCare_EventScript_NoRoom::
	msgbox Johto_Route34_DayCare_Route34_DayCare_Text_YourTeamIsFull, MSGBOX_DEFAULT
	release
	end

