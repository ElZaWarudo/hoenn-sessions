	applymovement OBJ_EVENT_ID_PLAYER, Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_PlayerIntroMovement2
	waitmovement 0
	goto Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_EventScript_MomsIntro
	end


Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_EventScript_MomsIntro::
	playse SE_PIN
	applymovement Johto_NewBarkTown_PlayersHouse_1F_LOCALID_MOM, Common_Movement_ExclamationMark
	delay 60
	applymovement Johto_NewBarkTown_PlayersHouse_1F_LOCALID_MOM, Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_MomMovement_1
	waitmovement 0
	msgbox Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_Text_ElmsLookingForYou, MSGBOX_DEFAULT
	call Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_EventScript_GivePokeGear
	call Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_EventScript_GiveRunningShoes
	applymovement Johto_NewBarkTown_PlayersHouse_1F_LOCALID_MOM, Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_MomMovement_2
	waitmovement 0
	setvar JOHTO_VAR_NEWBARK_TOWN_STATE, 2
	setvar JOHTO_VAR_NEWBARKTOWN_LABSTATE, 0
	setflag JOHTO_FLAG_HIDE_LAB_POLICEMAN
	setflag JOHTO_FLAG_VISITED_NEWBARK_TOWN

	@former flagheap location

	releaseall
	end



Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_EventScript_GivePokeGear::
	playfanfare MUS_OBTAIN_ITEM
	message Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_Text_ObtainedPokeGear
	waitfanfare
	setflag JOHTO_FLAG_SYS_POKENAV_GET
	setflag JOHTO_FLAG_RECEIVED_POKENAV
	setflag JOHTO_FLAG_ADDED_MATCH_CALL_TO_POKENAV
	setflag JOHTO_FLAG_REGISTER_RIVAL_POKENAV
	msgbox Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_Text_ExplainPokeGear, MSGBOX_DEFAULT
	closemessage
	delay 30
	return

Johto_NewBarkTown_PlayersHouse_1F_NewBarkTown_PlayersHouse_1F_EventScript_GiveRunningShoes::
