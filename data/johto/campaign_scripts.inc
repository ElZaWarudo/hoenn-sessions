KantoLater_Route13_Route13_Text_PokefanmAlexSeen:
	.string "Bow down before my regal POKéMON!$"

KantoLater_Route13_Route13_Text_PokefanmAlexBeaten:
	.string "How… How dare you mock royalty!$"

KantoLater_Route13_Route13_Text_PokefanmAlexAfterBattle:
	.string "Doesn't everyone wish to someday\n"
	.string "be a king?$"

KantoLater_Route13_Route13_Text_PokefanmJoshuaSeen:
	.string "Nihihi! Would you like to battle\n"
	.string "my PIKACHU gang?$"

KantoLater_Route13_Route13_Text_PokefanmJoshuaBeaten:
	.string "PI-PIKACHU!$"

KantoLater_Route13_Route13_Text_PokefanmJoshuaAfterBattle:
