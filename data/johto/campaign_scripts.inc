Johto_OlivineCity_PortInside_OlivineCity_PortInside_EventScript_Oak::
	lock
	playbgm MUS_HG_OAK, TRUE
	playse SE_PIN
	johto_applymovement2 Johto_OlivineCity_PortInside_LOCALID_OLIVINEPORT_OAK, Common_Movement_ExclamationMark
	delay 60
	turnobject Johto_OlivineCity_PortInside_LOCALID_OLIVINEPORT_OAK, DIR_NORTH
	msgbox Johto_OlivineCity_PortInside_OlivineCity_PortInside_Text_Nationaldex1, MSGBOX_DEFAULT
	closemessage
	johto_applymovement2 Johto_OlivineCity_PortInside_LOCALID_OLIVINEPORT_OAK, Johto_OlivineCity_PortInside_OlivineCity_PortInside_Movement_OakFixDex
	waitmovement 0
	delay 30
	setflag JOHTO_FLAG_SYS_NATIONAL_DEX
	special EnableNationalPokedex
	playfanfare MUS_OBTAIN_ITEM
	message Johto_OlivineCity_PortInside_OlivineCity_PortInside_Text_Nationaldex2
	waitfanfare
	delay 50
	msgbox Johto_OlivineCity_PortInside_OlivineCity_PortInside_Text_Nationaldex3, MSGBOX_DEFAULT
	closemessage
	playse SE_PIN
	johto_applymovement2 Johto_OlivineCity_PortInside_LOCALID_OLIVINEPORT_OAK, Common_Movement_ExclamationMark
	delay 60
	msgbox Johto_OlivineCity_PortInside_OlivineCity_PortInside_Text_Nationaldex4, MSGBOX_DEFAULT
	closemessage
	applymovement OBJ_EVENT_ID_PLAYER, Johto_OlivineCity_PortInside_OlivineCity_PortInside_Movement_PlayerMoveOver
	waitmovement 0
	applymovement Johto_OlivineCity_PortInside_LOCALID_OLIVINEPORT_OAK, Johto_OlivineCity_PortInside_OlivineCity_PortInside_Movement_OakLeave
	waitmovement 0
	setflag JOHTO_FLAG_HIDE_OLIVINE_PORT_OAK
	playse SE_EXIT
	removeobject Johto_OlivineCity_PortInside_LOCALID_OLIVINEPORT_OAK
	fadedefaultbgm
	waitse
	release
	end

