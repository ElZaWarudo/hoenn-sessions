Johto_Route34_DayCare_Route34_DayCare_EventScript_DaycareWoman::
	lock
	faceplayer
	specialvar JOHTO_VAR_RESULT, GetDaycareState
	goto_if_eq JOHTO_VAR_RESULT, DAYCARE_EGG_WAITING, Johto_Route34_DayCare_Route34_DayCare_EventScript_EggWaiting
	goto_if_eq JOHTO_VAR_RESULT, DAYCARE_ONE_MON, Johto_Route34_DayCare_Route34_DayCare_EventScript_OneMonInDaycare
	goto_if_eq JOHTO_VAR_RESULT, DAYCARE_TWO_MONS, Johto_Route34_DayCare_Route34_DayCare_EventScript_TwoMonsInDaycare
	msgbox Johto_Route34_DayCare_Route34_DayCare_Text_WouldYouLikeUsToRaiseAMon, MSGBOX_YESNO
	goto_if_eq JOHTO_VAR_RESULT, YES, Johto_Route34_DayCare_Route34_DayCare_EventScript_GiveMonToRaise
	msgbox Johto_Route34_DayCare_Route34_DayCare_Text_FineThenComeAgain, MSGBOX_DEFAULT
	release
	end

Johto_Route34_DayCare_Route34_DayCare_EventScript_GiveMonToRaise::
	specialvar JOHTO_VAR_RESULT, CountPartyNonEggMons
	goto_if_eq JOHTO_VAR_RESULT, 1, Johto_Route34_DayCare_Route34_DayCare_EventScript_OnlyOneMon
	specialvar JOHTO_VAR_RESULT, CountPartyAliveNonEggMons
	goto_if_eq JOHTO_VAR_RESULT, 2, Johto_Route34_DayCare_Route34_DayCare_EventScript_OnlyTwoAliveMons
	msgbox Johto_Route34_DayCare_Route34_DayCare_Text_WhichMonShouldWeRaise, MSGBOX_DEFAULT
	fadescreen FADE_TO_BLACK
	special ChooseSendDaycareMon
	waitstate
	goto_if_eq VAR_0x8004, PARTY_NOTHING_CHOSEN, Johto_Route34_DayCare_Route34_DayCare_EventScript_ComeAgain
	specialvar JOHTO_VAR_RESULT, CountPartyAliveNonEggMons_IgnoreVar0x8004Slot
	goto_if_eq JOHTO_VAR_RESULT, 0, Johto_Route34_DayCare_Route34_DayCare_EventScript_OnlyOneAliveMon
	specialvar VAR_0x8005, GetSelectedMonNicknameAndSpecies
	waitse
	playmoncry VAR_0x8005, CRY_MODE_NORMAL
	msgbox Johto_Route34_DayCare_Route34_DayCare_Text_WellRaiseYourMon, MSGBOX_DEFAULT
	waitmoncry
	special StoreSelectedPokemonInDaycare
	callnative UpdateFollowingPokemon
	incrementgamestat GAME_STAT_USED_DAYCARE
	specialvar JOHTO_VAR_RESULT, GetDaycareState
	goto_if_eq JOHTO_VAR_RESULT, DAYCARE_ONE_MON, Johto_Route34_DayCare_Route34_DayCare_EventScript_CanRaiseOneMore
	release
	end

Johto_Route34_DayCare_Route34_DayCare_EventScript_ComeAgain::
	msgbox Johto_Route34_DayCare_Route34_DayCare_Text_ComeAgain, MSGBOX_DEFAULT
	release
	end

Johto_Route34_DayCare_Route34_DayCare_EventScript_CanRaiseOneMore::
	msgbox Johto_Route34_DayCare_Route34_DayCare_Text_WeCanRaiseOneMore, MSGBOX_YESNO
	goto_if_eq JOHTO_VAR_RESULT, YES, Johto_Route34_DayCare_Route34_DayCare_EventScript_GiveMonToRaise
	goto Johto_Route34_DayCare_Route34_DayCare_EventScript_ComeAgain
	end

Johto_Route34_DayCare_Route34_DayCare_EventScript_OnlyOneMon::
