	delay 40
	waitmoncry
	setwildbattle SPECIES_ELECTRODE, 30
	dowildbattle
	specialvar JOHTO_VAR_RESULT, GetBattleOutcome
	goto_if_eq JOHTO_VAR_RESULT, B_OUTCOME_RAN, Johto_RocketHideout_B2F_RocketHideout_B2F_EventScript_Ran_Electrode
	goto_if_eq JOHTO_VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, Johto_RocketHideout_B2F_RocketHideout_B2F_EventScript_Ran_Electrode
	removeobject JOHTO_VAR_LAST_TALKED
	addvar JOHTO_VAR_ELECTRODES_FAINTED, 1
	release
	end

