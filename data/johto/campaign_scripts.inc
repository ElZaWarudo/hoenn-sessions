Johto_GoldenrodCity_TrainStation_GoldenrodCity_TrainStation_EventScript_BoardTrain::
	call EventScript_ChooseKantoEra
	goto_if_eq JOHTO_VAR_RESULT, 0, Johto_GoldenrodCity_TrainStation_GoldenrodCity_TrainStation_EventScript_BoardTrain_Cancel
	special Johto_RecordCurrentHeal
	goto_if_eq JOHTO_VAR_RESULT, FALSE, Johto_GoldenrodCity_TrainStation_GoldenrodCity_TrainStation_EventScript_BoardTrain_TravelFailed
	special Johto_PrepareKantoTravel
	goto_if_eq JOHTO_VAR_RESULT, FALSE, Johto_GoldenrodCity_TrainStation_GoldenrodCity_TrainStation_EventScript_BoardTrain_TravelFailed
	goto Johto_GoldenrodCity_TrainStation_GoldenrodCity_TrainStation_EventScript_BoardTrain_BeginTravel

Johto_GoldenrodCity_TrainStation_GoldenrodCity_TrainStation_EventScript_BoardTrain_BeginTravel::
	msgbox Johto_GoldenrodCity_TrainStation_GoldenrodMagnetTrainStation_Text_OfficerRightThisWay, MSGBOX_DEFAULT
	closemessage
	applymovement Johto_GoldenrodCity_TrainStation_LOCALID_GOLDENROD_CITY_TRAIN_STATION_ATTENDANT, Johto_GoldenrodCity_TrainStation_GoldenrodCity_TrainStation_Movement_Attendant_Move_Up
	waitmovement 0
	applymovement OBJ_EVENT_ID_PLAYER, Johto_GoldenrodCity_TrainStation_GoldenrodCity_TrainStation_Movement_WalktoTrain
	waitmovement 0
	special SpawnCameraObject
	applymovement OBJ_EVENT_ID_PLAYER, Common_Movement_WalkUp
	waitmovement 0
	playse SE_EXIT
	waitse
	fadescreen FADE_TO_BLACK

	applymovement OBJ_EVENT_ID_CAMERA, Johto_GoldenrodCity_TrainStation_GoldenrodCity_TrainStation_Movement_CameraPanUp
	waitmovement 0
	applymovement OBJ_EVENT_ID_CAMERA, Johto_GoldenrodCity_TrainStation_GoldenrodCity_TrainStation_Movement_CameraPanLeft
	waitmovement 0
	delay 60

	applymovement Johto_GoldenrodCity_TrainStation_LOCALID_GOLDENROD_CITY_TRAIN_STATION_TRAIN Johto_GoldenrodCity_TrainStation_GoldenrodCity_TrainStation_Movement_SlideRight
	applymovement OBJ_EVENT_ID_CAMERA, Johto_GoldenrodCity_TrainStation_GoldenrodCity_TrainStation_Movement_SlideRight
	fadescreen FADE_FROM_BLACK
	playse SE_TRUCK_MOVE
	delay 220
	playse SE_TRUCK_STOP
	applymovement Johto_GoldenrodCity_TrainStation_LOCALID_GOLDENROD_CITY_TRAIN_STATION_TRAIN Johto_GoldenrodCity_TrainStation_GoldenrodCity_TrainStation_Movement_SlideRight
	applymovement OBJ_EVENT_ID_CAMERA, Johto_GoldenrodCity_TrainStation_GoldenrodCity_TrainStation_Movement_SlideRight
	fadescreen FADE_TO_BLACK
	waitse
	special RemoveCameraObject
	setvar JOHTO_VAR_TRAIN, 1
	delay 60
