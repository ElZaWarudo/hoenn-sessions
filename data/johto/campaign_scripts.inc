	turnobject OBJ_EVENT_ID_PLAYER, DIR_EAST
	msgbox Johto_GoldenrodCity_RadioTower_5F_GoldenrodCity_RadioTower_5F_Text_DirectorThanks, MSGBOX_DEFAULT
	closemessage
	call_if_eq JOHTO_VAR_LUGIA_OR_HOOH, 1,  Johto_GoldenrodCity_RadioTower_5F_GoldenrodCity_RadioTower_5F_EventScript_GiveTidalWing
