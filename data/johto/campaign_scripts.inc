	end
Johto_Route36_Route36_EventScript_SudoWoodoWater::
	msgbox Johto_Route36_Route36_Text_UsedSquirtbottle, MSGBOX_DEFAULT
	playse SE_DOWNPOUR
	waitse
	closemessage
	playse SE_SUDOWOODO_SHAKE
	applymovement Johto_Route36_LOCALID_ROUTE36_SUDOWOODO, Johto_Route36_Route36_Movement_SudoWoodo
	waitmovement 0
	faceplayer
	msgbox Johto_Route36_Route36_Text_SudowoodoAttacked
	closemessage
	waitse
	playmoncry SPECIES_SUDOWOODO, CRY_MODE_ENCOUNTER
	delay 40
	waitmoncry
	setvar JOHTO_VAR_LAST_TALKED, Johto_Route36_LOCALID_ROUTE36_SUDOWOODO
	setwildbattle SPECIES_SUDOWOODO, 20
	@setflag FLAG_SYS_CTRL_OBJ_DELETE
	dowildbattle
	@clearflag FLAG_SYS_CTRL_OBJ_DELETE
	specialvar JOHTO_VAR_RESULT, GetBattleOutcome
	goto_if_eq JOHTO_VAR_RESULT, B_OUTCOME_WON, Johto_Route36_Route36_EventScript_Defeated_Sudowoodo
	goto_if_eq JOHTO_VAR_RESULT, B_OUTCOME_RAN, Johto_Route36_Route36_EventScript_RanSudowoodo
	goto_if_eq JOHTO_VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, Johto_Route36_Route36_EventScript_RanSudowoodo
Johto_Route36_Route36_EventScript_Defeated_Sudowoodo::
	setflag JOHTO_FLAG_HIDE_SUDOWOODO
	removeobject Johto_Route36_LOCALID_ROUTE36_SUDOWOODO
	checkitem ITEM_HM_ROCK_SMASH
	call_if_eq JOHTO_VAR_RESULT, FALSE, Johto_Route36_Route36_EventScript_RockSmashGuySudoWoodo
	release
	end

Johto_Route36_Route36_EventScript_RanSudowoodo::
