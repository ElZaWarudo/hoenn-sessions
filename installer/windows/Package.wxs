<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Hoenn Sessions"
      Manufacturer="Hoenn Sessions"
      Version="1.0.0.0"
      UpgradeCode="123F488C-39CB-454D-B12A-A7A4D591C88C"
      Scope="perUser"
      InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer Hoenn Sessions installation is already present." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Programs">
        <Directory Id="PRODUCTFOLDER" Name="Hoenn Sessions">
          <Directory Id="APPFOLDER" Name="app" />
          <Directory Id="NOTICEFOLDER" Name="notices" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="PROGRAMMENUDIR" Name="Hoenn Sessions" />
    </StandardDirectory>

    <Component Id="StableBootstrap" Directory="APPFOLDER" Guid="*">
      <File Id="BootstrapExe" Name="hoenn-sessions-bootstrapper.exe" Source="$(var.BootstrapExe)" KeyPath="yes" />
    </Component>
    <Component Id="OnboardingFallback" Directory="APPFOLDER" Guid="*">
      <File Id="OnboardingExe" Name="hoenn-sessions-onboarding.exe" Source="$(var.OnboardingExe)" KeyPath="yes" />
    </Component>
    <Component Id="PrivatePilotConfig" Directory="PRODUCTFOLDER" Guid="*">
      <File Id="BootstrapConfig" Name="bootstrap-config.private-pilot.json" Source="$(var.ConfigFile)" KeyPath="yes" />
    </Component>
    <Component Id="ThirdPartyNotices" Directory="NOTICEFOLDER" Guid="*">
      <File Id="NoticesFile" Name="THIRD_PARTY_NOTICES.txt" Source="$(var.NoticesFile)" KeyPath="yes" />
    </Component>
    <Component Id="StartMenuShortcut" Directory="PROGRAMMENUDIR" Guid="*">
      <Shortcut Id="HoennSessionsShortcut"
                Name="Hoenn Sessions"
                Description="Play Hoenn Sessions"
                Target="[APPFOLDER]hoenn-sessions-bootstrapper.exe"
                WorkingDirectory="APPFOLDER" />
      <RemoveFolder Id="RemoveProgramMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Hoenn Sessions" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="MainFeature" Title="Hoenn Sessions" Level="1">
      <ComponentRef Id="StableBootstrap" />
      <ComponentRef Id="OnboardingFallback" />
      <ComponentRef Id="PrivatePilotConfig" />
      <ComponentRef Id="ThirdPartyNotices" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
