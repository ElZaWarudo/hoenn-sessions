    <Platform>x64</Platform>
    <DefineConstants>BootstrapExe=$(BootstrapExe);OnboardingExe=$(OnboardingExe);ConfigFile=$(ConfigFile);NoticesFile=$(NoticesFile)</DefineConstants>
