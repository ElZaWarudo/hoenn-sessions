COOP_DOMAIN=coop.example.com
COOP_FIREBASE_BUCKET=your-project.firebasestorage.app
# Pin each release to an immutable digest; retain the previous image locally.
# Production releases set this to ghcr.io/<owner>/hoenn-sessions-server@sha256:<digest>
# via deploy-release.sh (digest recorded in the release's release.json).
# Never deploy a mutable tag such as :latest: GHCR tags can be overwritten.
COOP_IMAGE=ghcr.io/<owner>/hoenn-sessions-server@sha256:<digest>
# Required trusted server build catalog (server refuses to start without both).
# This is the schema-3 server-build-catalog.json promoted by
# promote-server-catalog.sh into a directory named by its own digest; the
# pinned worlds/<N>/arrival.sav files are read from the same directory. It is
# NOT the client region catalog (release_catalog.json). deploy-release.sh
# rewrites these two lines (and COOP_IMAGE) on every rollout.
COOP_PHASE2_RELEASE_CATALOG_PATH=/srv/hoenn/server-catalog/<sha256>/server-build-catalog.json
COOP_PHASE2_RELEASE_CATALOG_SHA256=<sha256>
# --- Optional private client downloads (see RELEASES.md) ---
# Uncomment to serve /srv/hoenn/current over HTTPS with basic auth.
# COOP_DOWNLOAD_USER=player
# COOP_DOWNLOAD_HASH=<caddy hash-password output with each $ doubled as $$>
