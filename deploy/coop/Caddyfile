{
	servers {
		timeouts {
			read_header 10s
			read_body 180s
			idle 2m
		}
	}
	log default {
		format filter {
			wrap json
			fields {
				request delete
			}
		}
	}
}

{$COOP_DOMAIN} {
	# Access logs intentionally disabled: upload paths carry short-lived tokens.
	request_body {
		max_size 42MB
	}
	reverse_proxy server:3000
}
