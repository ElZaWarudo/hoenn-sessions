+                            DespawnReason::Hidden,
+                        )
+                        .unwrap(),
+                    )
+                )
+                .is_err()
+        );
+        assert!(
+            !server.await.unwrap(),
+            "stale lifecycle must not be emitted"
+        );
+    }
