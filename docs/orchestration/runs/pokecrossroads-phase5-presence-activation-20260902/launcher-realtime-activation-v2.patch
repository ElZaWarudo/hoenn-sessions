+        }
+        let Some(latest) = children.control.latest_presence_state() else {
+            return Err(SessionError::Realtime);
+        };
+        if latest.0 != generation {
+            return Err(SessionError::Realtime);
+        }
+        freshest = latest;
+        let mut coordinator = Some(
