+                            result = Err(SessionError::Realtime);
+                        }
+                    }
+                    Ok(RawSupervisorEvent::Control(ControlEvent::InteractRemotePlayer(interaction))) => {
+                        if children.control.reset_latched()
+                            || children.control.lifecycle_generation() != generation
+                            || realtime.interact(interaction).is_err()
+                        {
+                            result = Err(SessionError::Realtime);
+                        }
+                    }
+                    Ok(RawSupervisorEvent::Control(ready @ ControlEvent::CheckpointReady { .. })) => {
+                        if let Err(error) = self
+                            .checkpoint_with_realtime(api, &mut children.control, ready, realtime)
+                            .await
