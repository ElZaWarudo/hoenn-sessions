+                    }
+                }
+            }
+        }
+
+        if let Some(coordinator) = coordinator.take() {
+            children.control.disable_lifecycle();
+            if coordinator.stop_and_join().await.is_err() && result.is_ok() {
+                result = Err(SessionError::Realtime);
+            }
+        }
+        result
+    }
