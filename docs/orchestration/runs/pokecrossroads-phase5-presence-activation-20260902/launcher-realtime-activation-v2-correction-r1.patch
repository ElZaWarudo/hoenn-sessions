+    async fn establish_realtime_cutover(
+        control: &mut ControlChannel,
+        realtime: &mut RealtimeCoordinator,
+        mut ready_seen: bool,
+        buffered: &mut Vec<ControlCommand>,
+    ) -> Result<(), SessionError> {
+        loop {
+            tokio::select! {
+                biased;
+                observation = control.receive() => {
+                    Self::drop_pre_ready_control(observation, control, realtime)?;
+                },
+                event = realtime.next_event() => match event {
+                    Ok(RealtimeCoordinatorEvent::Ready) if !ready_seen => {
+                        ready_seen = true;
+                    }
+                    Ok(RealtimeCoordinatorEvent::Lifecycle(command)) if ready_seen => {
+                        if buffered.len() == coop_sidecar::MAX_OWNER_EVENT_QUEUE {
+                            return Err(SessionError::Realtime);
+                        }
+                        buffered.push(command);
+                    }
+                    Ok(RealtimeCoordinatorEvent::Ready | RealtimeCoordinatorEvent::Lifecycle(_) | RealtimeCoordinatorEvent::Terminal)
+                    | Err(_) => return Err(SessionError::Realtime),
