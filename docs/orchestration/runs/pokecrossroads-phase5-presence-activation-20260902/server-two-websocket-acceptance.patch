+type RealtimeSocket =
+    tokio_tungstenite::WebSocketStream<tokio_tungstenite::MaybeTlsStream<TcpStream>>;
+
+struct InProcessServer {
+    address: SocketAddr,
+    shutdown: Option<oneshot::Sender<()>>,
+    task: Option<JoinHandle<Result<(), std::io::Error>>>,
+}
+
+impl InProcessServer {
+    async fn shutdown(mut self) -> TestResult<()> {
+        let shutdown = self
+            .shutdown
+            .take()
+            .ok_or("in-process server shutdown was already requested")?;
+        shutdown
+            .send(())
+            .map_err(|()| "in-process server stopped before shutdown")?;
+        let task = self
+            .task
+            .take()
+            .ok_or("in-process server task was already taken")?;
+        match timeout(SHUTDOWN_TIMEOUT, task).await {
+            Ok(Ok(Ok(()))) => Ok(()),
+            Ok(Ok(Err(error))) => Err(error.into()),
+            Ok(Err(error)) => Err(error.into()),
+            Err(_) => Err("in-process server did not shut down within the bound".into()),
+        }
+    }
+}
+
+impl Drop for InProcessServer {
+    fn drop(&mut self) {
+        if let Some(task) = self.task.take() {
+            task.abort();
+        }
+    }
+}
+
+async fn start_in_process_presence_server() -> TestResult<InProcessServer> {
+    let listener = TcpListener::bind(("127.0.0.1", 0)).await?;
+    let address = listener.local_addr()?;
+    let config = Phase2Config::local(
+        vec![0x07; 32],
+        SigningPrivateKey::from_bytes([7; 32]),
+        SIGNING_KEY_ID,
+    )?;
+    let app = Phase2App::new(config)?;
+    app.add_invitation("two-websocket-invite-a")?;
+    app.add_invitation("two-websocket-invite-b")?;
+    let (shutdown, signal) = oneshot::channel();
+    let task = tokio::spawn(async move {
+        axum::serve(listener, app.router())
+            .with_graceful_shutdown(async move {
+                let _ = signal.await;
+            })
+            .await
+    });
+    Ok(InProcessServer {
+        address,
+        shutdown: Some(shutdown),
+        task: Some(task),
+    })
+}
