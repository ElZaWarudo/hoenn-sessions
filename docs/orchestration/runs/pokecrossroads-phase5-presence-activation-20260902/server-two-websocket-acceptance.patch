+async fn connect_realtime_socket(address: SocketAddr, ticket: &str) -> TestResult<RealtimeSocket> {
+    let mut request = format!("ws://{address}/v1/realtime").into_client_request()?;
+    request.headers_mut().insert(
+        "authorization",
+        HeaderValue::from_str(&format!("Bearer {ticket}"))?,
+    );
+    let (socket, response) = timeout(HTTP_TIMEOUT, connect_async(request)).await??;
+    assert_eq!(response.status().as_u16(), 101);
+    assert_eq!(
+        response
+            .headers()
+            .get("cache-control")
+            .and_then(|value| value.to_str().ok()),
+        Some("no-store")
+    );
+    Ok(socket)
+}
+
+async fn next_realtime_frame<S>(
+    socket: &mut tokio_tungstenite::WebSocketStream<S>,
+) -> TestResult<ServerRealtimeFrameV1>
+where
+    S: AsyncRead + AsyncWrite + Unpin,
+{
+    let message = timeout(HTTP_TIMEOUT, socket.next())
+        .await?
+        .ok_or("WebSocket closed before the expected realtime frame")??;
+    match message {
+        WsMessage::Text(text) => Ok(coop_cloud::decode_server_realtime_frame(text.as_bytes())?),
+        other => Err(format!("unexpected non-text realtime message: {other:?}").into()),
+    }
+}
+
+async fn expect_realtime_ready_handle<S>(
+    socket: &mut tokio_tungstenite::WebSocketStream<S>,
+) -> TestResult<PresenceHandle>
+where
+    S: AsyncRead + AsyncWrite + Unpin,
+{
+    match next_realtime_frame(socket).await? {
+        ServerRealtimeFrameV1::PresenceReady(readiness) => Ok(readiness.self_handle()),
+        other => Err(format!("expected PRESENCE_READY, received {other:?}").into()),
+    }
+}
+
+async fn assert_no_realtime_frame<S>(
+    socket: &mut tokio_tungstenite::WebSocketStream<S>,
+    wait: Duration,
+) -> TestResult<()>
+where
+    S: AsyncRead + AsyncWrite + Unpin,
+{
+    match timeout(wait, socket.next()).await {
+        Err(_) => Ok(()),
+        Ok(Some(Ok(message))) => Err(format!("unexpected self realtime frame: {message:?}").into()),
+        Ok(Some(Err(error))) => Err(error.into()),
+        Ok(None) => Err("WebSocket closed while checking for self events".into()),
+    }
+}
