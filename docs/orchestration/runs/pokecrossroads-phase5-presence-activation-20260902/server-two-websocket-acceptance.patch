+#[tokio::test]
+async fn realtime_two_authenticated_clients_share_littleroot() -> TestResult<()> {
+    if !cfg!(any(target_os = "linux", target_os = "windows")) {
+        return Err("realtime presence acceptance requires Linux or Windows".into());
+    }
+    let _test_guard = BLACK_BOX_TEST_GATE.lock().await;
+    let server = start_in_process_presence_server().await?;
+    let address = server.address;
+    let flow = timeout(
+        HTTP_FLOW_TIMEOUT,
+        realtime_two_authenticated_clients_flow(address),
+    )
+    .await
+    .map_err(|_| "two-client realtime acceptance exceeded its bound")?;
+    let shutdown = server.shutdown().await;
+    flow?;
+    shutdown
+}
+
+async fn realtime_two_authenticated_clients_flow(address: SocketAddr) -> TestResult<()> {
+    let (access_a, mut lease_a) = establish_in_process_realtime_user(
+        address,
+        "presencealice",
+        "two-websocket-invite-a",
+        0x5a00,
+    )
+    .await?;
+    let (access_b, mut lease_b) = establish_in_process_realtime_user(
+        address,
+        "presencebob",
+        "two-websocket-invite-b",
+        0x5b00,
+    )
+    .await?;
+    let ticket_a = mint_fresh_realtime_ticket(address, &access_a, &mut lease_a).await?;
+    let ticket_b = mint_fresh_realtime_ticket(address, &access_b, &mut lease_b).await?;
+
+    let mut socket_a = connect_realtime_socket(address, &ticket_a).await?;
+    let state_a = realtime_state_at(1, 1, 7, PlayerState::Overworld);
+    timeout(HTTP_TIMEOUT, send_player_state(&mut socket_a, &state_a)).await??;
+    let handle_a = expect_realtime_ready_handle(&mut socket_a).await?;
+    assert_no_realtime_frame(&mut socket_a, Duration::from_millis(150)).await?;
+
+    let mut socket_b = connect_realtime_socket(address, &ticket_b).await?;
+    let state_b = realtime_state_at(2, 1, 41, PlayerState::Overworld);
+    timeout(HTTP_TIMEOUT, send_player_state(&mut socket_b, &state_b)).await??;
+    let handle_b = expect_realtime_ready_handle(&mut socket_b).await?;
+    assert_ne!(handle_a, handle_b);
+    assert_ne!(handle_a.as_u64(), 0);
+    assert_ne!(handle_b.as_u64(), 0);
+
+    let spawn_a_on_b = match next_realtime_frame(&mut socket_b).await? {
+        ServerRealtimeFrameV1::RemotePlayerSpawn(spawn) => {
+            assert_eq!(spawn.handle(), handle_a);
+            assert_eq!(spawn.username().as_str(), "presencealice");
+            assert_eq!(spawn.state(), &state_a);
+            assert_eq!(spawn.state().pose().warp_sequence(), 7);
+            spawn.server_sequence()
+        }
+        other => return Err(format!("expected Alice spawn on Bob, received {other:?}").into()),
+    };
+    let spawn_b_on_a = match next_realtime_frame(&mut socket_a).await? {
+        ServerRealtimeFrameV1::RemotePlayerSpawn(spawn) => {
+            assert_eq!(spawn.handle(), handle_b);
+            assert_eq!(spawn.username().as_str(), "presencebob");
+            assert_eq!(spawn.state(), &state_b);
+            assert_eq!(spawn.state().pose().warp_sequence(), 41);
+            spawn.server_sequence()
+        }
+        other => return Err(format!("expected Bob spawn on Alice, received {other:?}").into()),
+    };
+    assert_no_realtime_frame(&mut socket_a, Duration::from_millis(150)).await?;
+    assert_no_realtime_frame(&mut socket_b, Duration::from_millis(150)).await?;
+
+    let moved_a = realtime_state_with_warp(3, 1, 8, 7, PlayerState::Overworld);
+    timeout(HTTP_TIMEOUT, send_player_state(&mut socket_a, &moved_a)).await??;
+    let update_server_sequence = match next_realtime_frame(&mut socket_b).await? {
+        ServerRealtimeFrameV1::RemotePlayerUpdate(update) => {
+            assert_eq!(update.handle(), handle_a);
+            assert_eq!(update.state(), &moved_a);
+            assert!(update.server_sequence() > spawn_a_on_b);
+            update.server_sequence()
+        }
+        other => return Err(format!("expected Alice movement on Bob, received {other:?}").into()),
+    };
+    assert_no_realtime_frame(&mut socket_a, Duration::from_millis(150)).await?;
+
+    timeout(HTTP_TIMEOUT, socket_a.close(None)).await??;
+    match next_realtime_frame(&mut socket_b).await? {
+        ServerRealtimeFrameV1::RemotePlayerDespawn(despawn) => {
+            assert_eq!(despawn.handle(), handle_a);
+            assert_eq!(despawn.reason(), DespawnReason::Disconnected);
+            assert!(despawn.server_sequence() > update_server_sequence);
+        }
+        other => {
+            return Err(format!("expected Alice disconnect on Bob, received {other:?}").into());
+        }
+    }
+    assert_ne!(spawn_b_on_a, 0);
+    timeout(HTTP_TIMEOUT, socket_b.close(None)).await??;
+    Ok(())
+}
