+        )
+        .is_ok()
+    );
+    let ticket = RealtimeTicket::from_bytes([4; 32]).unwrap();
+    let endpoint = RealtimeEndpoint::new("ws://127.0.0.1:3000/v1/realtime").unwrap();
+    assert_eq!(
+        RealtimeGrant::with_now(
+            ticket,
