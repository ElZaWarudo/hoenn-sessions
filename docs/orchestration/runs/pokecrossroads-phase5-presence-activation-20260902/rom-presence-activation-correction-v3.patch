+static bool8 IsOwnedRendererEffectivelyVisible(const struct CoopPresenceRemote *remote)
+{
+    struct ObjectEvent *object_event;
+    struct Sprite *sprite;
+    s16 map_x;
+    s16 map_y;
+    u8 object_id;
+    u16 graphics_id;
