+    impl super::super::super::phase2::Repository for ToggleRepository {
+        fn read_transaction(
+            &self,
+            operation: &mut dyn FnMut(
+                &super::super::super::phase2::storage::State,
+            ) -> Result<
+                (),
+                super::super::super::phase2::storage::StorageError,
