diff --git a/include/coop/net_bridge.h b/include/coop/net_bridge.h
new file mode 100644
index 0000000000000000000000000000000000000000..ca03f031db120ad732d3f088a24695d8206c55d7
--- /dev/null
+++ b/include/coop/net_bridge.h
@@ -0,0 +1,132 @@
+#ifndef GUARD_COOP_NET_BRIDGE_H
+#define GUARD_COOP_NET_BRIDGE_H
+
+#include <stddef.h>
+
+#include "gba/defines.h"
+#include "gba/types.h"
+#include "coop/region.h"
+
+#define COOP_NET_BRIDGE_MAGIC 0x504B434Fu
+#define COOP_NET_BRIDGE_ABI_VERSION 1
+#define COOP_NET_BRIDGE_PAYLOAD_SIZE 128
+#define COOP_NET_BRIDGE_QUEUE_CAPACITY 32
+
+enum CoopBridgeMessageType
+{
+    COOP_BRIDGE_MESSAGE_NONE = 0,
+    COOP_BRIDGE_MESSAGE_ROM_READY = 1,
+    COOP_BRIDGE_MESSAGE_SESSION_READY = 2,
+    COOP_BRIDGE_MESSAGE_HEARTBEAT = 3,
+    COOP_BRIDGE_MESSAGE_WORLD_SNAPSHOT = 4,
+};
+
+enum CoopBridgeStatus
+{
+    COOP_BRIDGE_STATUS_INITIALIZED = (1 << 0),
+    COOP_BRIDGE_STATUS_ROM_READY_SENT = (1 << 1),
+    COOP_BRIDGE_STATUS_SESSION_READY = (1 << 2),
+    COOP_BRIDGE_STATUS_HEARTBEAT_SENT = (1 << 3),
+    COOP_BRIDGE_STATUS_WORLD_SNAPSHOT_SENT = (1 << 4),
+    COOP_BRIDGE_STATUS_QUEUE_ERROR = (1 << 5),
+    COOP_BRIDGE_STATUS_CRC_ERROR = (1 << 6),
+};
+
+#define COOP_NET_BRIDGE_HEARTBEAT_INTERVAL 60
+#define COOP_NET_BRIDGE_SNAPSHOT_INTERVAL 15
+
+/* The message header and payload are stable even when the engine changes. */
+struct CoopBridgeMessage
+{
+    /* 0x00 */ u32 magic;
+    /* 0x04 */ u16 abi_version;
+    /* 0x06 */ u8 type;
+    /* 0x07 */ u8 flags;
+    /* 0x08 */ u32 sequence;
+    /* 0x0C */ u32 session_epoch;
+    /* 0x10 */ u16 payload_size;
+    /* 0x12 */ u16 reserved;
+    /* 0x14 */ u32 crc32;
+    /* 0x18 */ u8 payload[COOP_NET_BRIDGE_PAYLOAD_SIZE];
+} PACKED;
+
+struct CoopBridgeQueue
+{
+    /* Monotonic counters distinguish full from empty without a count field. */
+    /* 0x0000 */ u32 read_index;
+    /* 0x0004 */ u32 write_index;
+    /* 0x0008 */ struct CoopBridgeMessage entries[COOP_NET_BRIDGE_QUEUE_CAPACITY];
+} PACKED;
+
+struct CoopNetBridge
+{
+    /* 0x0000 */ u32 magic;
+    /* 0x0004 */ u16 abi_version;
+    /* 0x0006 */ u16 status;
+    /* 0x0008 */ u32 session_epoch;
+    /* 0x000C */ u32 tx_sequence;
+    /* 0x0010 */ u32 rx_sequence;
+    /* 0x0014 */ u32 frame_counter;
+    /* 0x0018 */ u32 last_heartbeat_frame;
+    /* 0x001C */ u32 last_snapshot_frame;
+    /* 0x0020 */ struct CoopBridgeQueue game_to_network;
+    /* ...   */ struct CoopBridgeQueue network_to_game;
+} PACKED;
+
+struct CoopBridgeHeartbeat
+{
+    u32 frame_counter;
+    u32 received_sequence;
+} PACKED;
+
+struct CoopBridgeWorldSnapshot
+{
+    struct WorldLocation location;
+    u8 reserved[2];
+    u32 frame_counter;
+} PACKED;
+
+_Static_assert(sizeof(struct CoopBridgeMessage) == 152, "CoopBridgeMessage ABI size");
+_Static_assert(offsetof(struct CoopBridgeMessage, magic) == 0, "CoopBridgeMessage magic offset");
+_Static_assert(offsetof(struct CoopBridgeMessage, sequence) == 8, "CoopBridgeMessage sequence offset");
+_Static_assert(offsetof(struct CoopBridgeMessage, session_epoch) == 12, "CoopBridgeMessage session offset");
+_Static_assert(offsetof(struct CoopBridgeMessage, payload_size) == 16, "CoopBridgeMessage payload size offset");
+_Static_assert(offsetof(struct CoopBridgeMessage, crc32) == 20, "CoopBridgeMessage crc offset");
+_Static_assert(offsetof(struct CoopBridgeMessage, payload) == 24, "CoopBridgeMessage payload offset");
+_Static_assert(sizeof(struct CoopBridgeQueue) == 8 + 152 * 32, "CoopBridgeQueue ABI size");
+_Static_assert(offsetof(struct CoopBridgeQueue, entries) == 8, "CoopBridgeQueue entries offset");
+_Static_assert(sizeof(struct CoopBridgeHeartbeat) == 8, "CoopBridgeHeartbeat ABI size");
+_Static_assert(sizeof(struct CoopBridgeWorldSnapshot) == 16, "CoopBridgeWorldSnapshot ABI size");
+_Static_assert(offsetof(struct CoopNetBridge, game_to_network) == 32, "CoopNetBridge tx queue offset");
+_Static_assert(offsetof(struct CoopNetBridge, network_to_game) == 32 + sizeof(struct CoopBridgeQueue), "CoopNetBridge rx queue offset");
+_Static_assert(sizeof(struct CoopNetBridge) == 32 + sizeof(struct CoopBridgeQueue) * 2, "CoopNetBridge ABI size");
+
+extern EWRAM_DATA struct CoopNetBridge gCoopNetBridge;
+
+u32 CoopBridge_Crc32(const void *data, u32 length);
+u32 CoopBridgeMessage_ComputeCrc(const struct CoopBridgeMessage *message);
+bool8 CoopBridgeMessage_Seal(struct CoopBridgeMessage *message, u8 type, u8 flags,
+                             u32 sequence, u32 session_epoch,
+                             const void *payload, u16 payload_size);
+bool8 CoopBridgeMessage_Validate(const struct CoopBridgeMessage *message);
+
+void CoopBridgeQueue_Init(struct CoopBridgeQueue *queue);
+bool8 CoopBridgeQueue_IsEmpty(const struct CoopBridgeQueue *queue);
+bool8 CoopBridgeQueue_IsFull(const struct CoopBridgeQueue *queue);
+bool8 CoopBridgeQueue_Push(struct CoopBridgeQueue *queue, const struct CoopBridgeMessage *message);
+bool8 CoopBridgeQueue_Pop(struct CoopBridgeQueue *queue, struct CoopBridgeMessage *message);
+
+void CoopNetBridge_Init(void);
+void CoopNetBridge_Poll(void);
+bool8 CoopNetBridge_EnqueueGameToNetwork(u8 type, u8 flags, const void *payload, u16 payload_size);
+bool8 CoopNetBridge_DequeueGameToNetwork(struct CoopBridgeMessage *message);
+bool8 CoopNetBridge_EnqueueNetworkToGame(const struct CoopBridgeMessage *message);
+bool8 CoopNetBridge_DequeueNetworkToGame(struct CoopBridgeMessage *message);
+
+/* Explicit names are useful to host tooling and avoid queue-direction ambiguity. */
+#define CoopNetBridge_PushTx CoopNetBridge_EnqueueGameToNetwork
+#define CoopNetBridge_PopTx CoopNetBridge_DequeueGameToNetwork
+#define CoopNetBridge_PushRx CoopNetBridge_EnqueueNetworkToGame
+#define CoopNetBridge_PopRx CoopNetBridge_DequeueNetworkToGame
+
+#endif /* GUARD_COOP_NET_BRIDGE_H */
diff --git a/include/coop/progress.h b/include/coop/progress.h
new file mode 100644
index 0000000000000000000000000000000000000000..72c96e9b69325dd497c2f1353775badd34076306
--- /dev/null
+++ b/include/coop/progress.h
@@ -0,0 +1,59 @@
+#ifndef GUARD_COOP_PROGRESS_H
+#define GUARD_COOP_PROGRESS_H
+
+#include <stddef.h>
+
+#include "gba/defines.h"
+#include "gba/types.h"
+#include "coop/region.h"
+
+#define COOP_PROGRESS_BADGE_COUNT 8
+#define COOP_PROGRESS_BADGE_MASK ((1u << COOP_PROGRESS_BADGE_COUNT) - 1u)
+#define COOP_PROGRESS_MAX_PARTICIPANTS 2
+
+/*
+ * This is an in-memory bridge record, not a SaveBlock extension.  The two
+ * masks intentionally have no dependency on legacy global flags: the server
+ * can exchange each region independently and persistent save integration can
+ * be added later without changing the ABI.
+ */
+struct RegionalProgress
+{
+    /* 0x00 */ u16 badge_mask;
+    /* 0x02 */ u16 story_checkpoint;
+    /* 0x04 */ u32 defeated_trainer_mask;
+    /* 0x08 */ u32 unlocked_fly_point_mask;
+} PACKED;
+
+struct CoopProgress
+{
+    /* Slots are ordered HOENN, KANTO, JOHTO, SEVII. */
+    /* 0x00 */ struct RegionalProgress regions[COOP_PROGRESS_REGION_COUNT];
+} PACKED;
+
+typedef struct RegionalProgress RegionalProgress;
+typedef struct CoopProgress CoopProgress;
+
+_Static_assert(sizeof(struct RegionalProgress) == 12, "RegionalProgress ABI size");
+_Static_assert(offsetof(struct RegionalProgress, badge_mask) == 0, "RegionalProgress badges offset");
+_Static_assert(offsetof(struct RegionalProgress, story_checkpoint) == 2, "RegionalProgress story offset");
+_Static_assert(offsetof(struct RegionalProgress, defeated_trainer_mask) == 4, "RegionalProgress trainers offset");
+_Static_assert(offsetof(struct RegionalProgress, unlocked_fly_point_mask) == 8, "RegionalProgress fly points offset");
+_Static_assert(sizeof(struct CoopProgress) == 48, "CoopProgress ABI size");
+
+/* Runtime state is EWRAM-only and is initialized separately from SaveBlock. */
+extern EWRAM_DATA struct CoopProgress gCoopProgress;
+
+void CoopProgress_Init(struct CoopProgress *progress);
+struct RegionalProgress *CoopProgress_GetRegion(struct CoopProgress *progress, enum CoopRegion region);
+const struct RegionalProgress *CoopProgress_GetRegionConst(const struct CoopProgress *progress, enum CoopRegion region);
+u8 CoopProgress_GetBadgeTier(const struct RegionalProgress *progress);
+u8 CoopProgress_GetMinimumTier(enum CoopRegion battle_region,
+                               const struct CoopProgress *participants,
+                               u8 participant_count);
+
+/* Descriptive aliases used by battle and host-facing callers. */
+#define CoopProgress_MinimumBadgeTier CoopProgress_GetMinimumTier
+#define CoopProgress_BadgeTier CoopProgress_GetBadgeTier
+
+#endif /* GUARD_COOP_PROGRESS_H */
diff --git a/include/coop/region.h b/include/coop/region.h
new file mode 100644
index 0000000000000000000000000000000000000000..d99ffc26ebc5114e0573a58459fc250b935fe288
--- /dev/null
+++ b/include/coop/region.h
@@ -0,0 +1,69 @@
+#ifndef GUARD_COOP_REGION_H
+#define GUARD_COOP_REGION_H
+
+#include "gba/defines.h"
+#include "gba/types.h"
+#include "constants/regions.h"
+
+/*
+ * These values are part of the co-op ABI.  They intentionally do not share
+ * the values of enum Region: the engine's enum is allowed to grow and its
+ * ordinal values are not serialized across the bridge.
+ */
+enum CoopRegion
+{
+    COOP_REGION_UNSPECIFIED = 0,
+    COOP_REGION_HOENN = 1,
+    COOP_REGION_KANTO = 2,
+    COOP_REGION_JOHTO = 3,
+    COOP_REGION_SEVII = 4,
+    COOP_REGION_COUNT = 5,
+};
+
+#define COOP_PROGRESS_REGION_COUNT 4
+
+/*
+ * The bridge boundary deliberately contains only fixed-width scalar fields.
+ * In particular, no MapHeader, WarpData, or ObjectEvent is serialized.
+ */
+struct WorldLocation
+{
+    /* 0x00 */ u8 region;
+    /* 0x01 */ u8 reserved;
+    /* 0x02 */ u16 map_group;
+    /* 0x04 */ u16 map_number;
+    /* 0x06 */ s16 x;
+    /* 0x08 */ s16 y;
+} PACKED;
+
+typedef struct WorldLocation WorldLocation;
+
+_Static_assert(sizeof(struct WorldLocation) == 10, "WorldLocation ABI size");
+_Static_assert(offsetof(struct WorldLocation, region) == 0, "WorldLocation region offset");
+_Static_assert(offsetof(struct WorldLocation, map_group) == 2, "WorldLocation map group offset");
+_Static_assert(offsetof(struct WorldLocation, map_number) == 4, "WorldLocation map number offset");
+_Static_assert(offsetof(struct WorldLocation, x) == 6, "WorldLocation x offset");
+_Static_assert(offsetof(struct WorldLocation, y) == 8, "WorldLocation y offset");
+
+/* Return UNSPECIFIED for an engine region that is not represented by the ABI. */
+enum CoopRegion CoopRegion_FromEngineRegion(enum Region region);
+
+/* Return UNSPECIFIED for a map section outside the generated map-section set. */
+enum CoopRegion CoopRegion_FromSectionId(u32 section_id);
+
+/*
+ * Normalize an engine region plus its active map section.  A Kanto engine
+ * region may normalize to Sevii.  Unknown combinations are rejected and do
+ * not silently become Hoenn.
+ */
+bool8 CoopRegion_Normalize(enum CoopRegion *out, enum Region engine_region, u32 section_id);
+bool8 CoopRegion_TryFromSectionId(enum CoopRegion *out, u32 section_id);
+bool8 CoopRegion_IsValid(enum CoopRegion region);
+
+/* Export the active map identity and player coordinates at the ABI boundary. */
+bool8 CoopWorldLocation_Export(struct WorldLocation *out);
+
+/* Compatibility spelling for callers that use the shorter adapter name. */
+#define WorldLocation_Export CoopWorldLocation_Export
+
+#endif /* GUARD_COOP_REGION_H */
diff --git a/src/coop/net_bridge.c b/src/coop/net_bridge.c
new file mode 100644
index 0000000000000000000000000000000000000000..55b68cc58c422a09f1ef3d7f8538b5088c3b9bda
--- /dev/null
+++ b/src/coop/net_bridge.c
@@ -0,0 +1,299 @@
+#include "global.h"
+#include "coop/net_bridge.h"
+#include "coop/progress.h"
+
+EWRAM_DATA struct CoopNetBridge gCoopNetBridge = {0};
+
+static u32 Crc32Update(u32 crc, const u8 *bytes, u32 length)
+{
+    u32 i;
+
+    for (i = 0; i < length; i++)
+    {
+        u32 bit;
+
+        crc ^= bytes[i];
+        for (bit = 0; bit < 8; bit++)
+        {
+            if (crc & 1)
+                crc = (crc >> 1) ^ 0xEDB88320;
+            else
+                crc >>= 1;
+        }
+    }
+    return crc;
+}
+
+u32 CoopBridge_Crc32(const void *data, u32 length)
+{
+    if (data == NULL && length != 0)
+        return 0;
+    return ~Crc32Update(0xFFFFFFFF, data, length);
+}
+
+u32 CoopBridgeMessage_ComputeCrc(const struct CoopBridgeMessage *message)
+{
+    u32 crc;
+
+    if (message == NULL)
+        return 0;
+
+    /* crc32 itself occupies bytes 20..23 and is excluded from the digest. */
+    crc = Crc32Update(0xFFFFFFFF, (const u8 *)message, offsetof(struct CoopBridgeMessage, crc32));
+    crc = Crc32Update(crc, message->payload, sizeof(message->payload));
+    return ~crc;
+}
+
+bool8 CoopBridgeMessage_Seal(struct CoopBridgeMessage *message, u8 type, u8 flags,
+                             u32 sequence, u32 session_epoch,
+                             const void *payload, u16 payload_size)
+{
+    if (message == NULL
+     || payload_size > COOP_NET_BRIDGE_PAYLOAD_SIZE
+     || (payload_size != 0 && payload == NULL)
+     || sequence == 0)
+        return FALSE;
+
+    memset(message, 0, sizeof(*message));
+    message->magic = COOP_NET_BRIDGE_MAGIC;
+    message->abi_version = COOP_NET_BRIDGE_ABI_VERSION;
+    message->type = type;
+    message->flags = flags;
+    message->sequence = sequence;
+    message->session_epoch = session_epoch;
+    message->payload_size = payload_size;
+    if (payload_size != 0)
+        memcpy(message->payload, payload, payload_size);
+    message->crc32 = CoopBridgeMessage_ComputeCrc(message);
+    return TRUE;
+}
+
+bool8 CoopBridgeMessage_Validate(const struct CoopBridgeMessage *message)
+{
+    if (message == NULL
+     || message->magic != COOP_NET_BRIDGE_MAGIC
+     || message->abi_version != COOP_NET_BRIDGE_ABI_VERSION
+     || message->type == COOP_BRIDGE_MESSAGE_NONE
+     || message->sequence == 0
+     || message->payload_size > COOP_NET_BRIDGE_PAYLOAD_SIZE)
+        return FALSE;
+
+    return message->crc32 == CoopBridgeMessage_ComputeCrc(message);
+}
+
+void CoopBridgeQueue_Init(struct CoopBridgeQueue *queue)
+{
+    if (queue == NULL)
+        return;
+
+    queue->read_index = 0;
+    queue->write_index = 0;
+    memset(queue->entries, 0, sizeof(queue->entries));
+}
+
+bool8 CoopBridgeQueue_IsEmpty(const struct CoopBridgeQueue *queue)
+{
+    return queue == NULL || queue->read_index == queue->write_index;
+}
+
+bool8 CoopBridgeQueue_IsFull(const struct CoopBridgeQueue *queue)
+{
+    if (queue == NULL)
+        return TRUE;
+    return (u32)(queue->write_index - queue->read_index) >= COOP_NET_BRIDGE_QUEUE_CAPACITY;
+}
+
+bool8 CoopBridgeQueue_Push(struct CoopBridgeQueue *queue, const struct CoopBridgeMessage *message)
+{
+    u32 index;
+
+    if (queue == NULL || message == NULL || !CoopBridgeMessage_Validate(message)
+     || CoopBridgeQueue_IsFull(queue))
+        return FALSE;
+
+    index = queue->write_index & (COOP_NET_BRIDGE_QUEUE_CAPACITY - 1);
+    queue->entries[index] = *message;
+    queue->write_index++;
+    return TRUE;
+}
+
+static bool8 CoopBridgeQueue_PopUnchecked(struct CoopBridgeQueue *queue, struct CoopBridgeMessage *message)
+{
+    u32 index;
+
+    if (queue == NULL || message == NULL || CoopBridgeQueue_IsEmpty(queue))
+        return FALSE;
+
+    index = queue->read_index & (COOP_NET_BRIDGE_QUEUE_CAPACITY - 1);
+    *message = queue->entries[index];
+    queue->read_index++;
+    return TRUE;
+}
+
+bool8 CoopBridgeQueue_Pop(struct CoopBridgeQueue *queue, struct CoopBridgeMessage *message)
+{
+    if (!CoopBridgeQueue_PopUnchecked(queue, message))
+        return FALSE;
+    return CoopBridgeMessage_Validate(message);
+}
+
+static bool8 IsSequenceNewer(u32 sequence, u32 previous)
+{
+    if (sequence == 0)
+        return FALSE;
+    if (previous == 0)
+        return TRUE;
+    return (s32)(sequence - previous) > 0;
+}
+
+bool8 CoopNetBridge_EnqueueGameToNetwork(u8 type, u8 flags, const void *payload, u16 payload_size)
+{
+    struct CoopBridgeMessage message;
+
+    if ((gCoopNetBridge.status & COOP_BRIDGE_STATUS_INITIALIZED) == 0
+     || gCoopNetBridge.tx_sequence == 0
+     || gCoopNetBridge.tx_sequence == 0xFFFFFFFF)
+        return FALSE;
+
+    if (!CoopBridgeMessage_Seal(&message, type, flags, gCoopNetBridge.tx_sequence,
+                                gCoopNetBridge.session_epoch, payload, payload_size))
+        return FALSE;
+
+    if (!CoopBridgeQueue_Push(&gCoopNetBridge.game_to_network, &message))
+    {
+        gCoopNetBridge.status |= COOP_BRIDGE_STATUS_QUEUE_ERROR;
+        return FALSE;
+    }
+
+    gCoopNetBridge.tx_sequence++;
+    return TRUE;
+}
+
+bool8 CoopNetBridge_DequeueGameToNetwork(struct CoopBridgeMessage *message)
+{
+    return CoopBridgeQueue_Pop(&gCoopNetBridge.game_to_network, message);
+}
+
+bool8 CoopNetBridge_EnqueueNetworkToGame(const struct CoopBridgeMessage *message)
+{
+    if ((gCoopNetBridge.status & COOP_BRIDGE_STATUS_INITIALIZED) == 0)
+        return FALSE;
+    if (!CoopBridgeQueue_Push(&gCoopNetBridge.network_to_game, message))
+    {
+        gCoopNetBridge.status |= COOP_BRIDGE_STATUS_QUEUE_ERROR;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+bool8 CoopNetBridge_DequeueNetworkToGame(struct CoopBridgeMessage *message)
+{
+    return CoopBridgeQueue_Pop(&gCoopNetBridge.network_to_game, message);
+}
+
+static bool8 SendHeartbeat(void)
+{
+    struct CoopBridgeHeartbeat heartbeat = {
+        .frame_counter = gCoopNetBridge.frame_counter,
+        .received_sequence = gCoopNetBridge.rx_sequence,
+    };
+
+    if (!CoopNetBridge_EnqueueGameToNetwork(COOP_BRIDGE_MESSAGE_HEARTBEAT, 0,
+                                            &heartbeat, sizeof(heartbeat)))
+        return FALSE;
+    gCoopNetBridge.last_heartbeat_frame = gCoopNetBridge.frame_counter;
+    gCoopNetBridge.status |= COOP_BRIDGE_STATUS_HEARTBEAT_SENT;
+    return TRUE;
+}
+
+static bool8 SendWorldSnapshot(void)
+{
+    struct CoopBridgeWorldSnapshot snapshot;
+
+    memset(&snapshot, 0, sizeof(snapshot));
+    if (!CoopWorldLocation_Export(&snapshot.location))
+        return FALSE;
+    snapshot.frame_counter = gCoopNetBridge.frame_counter;
+    if (!CoopNetBridge_EnqueueGameToNetwork(COOP_BRIDGE_MESSAGE_WORLD_SNAPSHOT, 0,
+                                            &snapshot, sizeof(snapshot)))
+        return FALSE;
+    gCoopNetBridge.last_snapshot_frame = gCoopNetBridge.frame_counter;
+    gCoopNetBridge.status |= COOP_BRIDGE_STATUS_WORLD_SNAPSHOT_SENT;
+    return TRUE;
+}
+
+static void ProcessInboundMessage(const struct CoopBridgeMessage *message)
+{
+    if (!CoopBridgeMessage_Validate(message))
+    {
+        gCoopNetBridge.status |= COOP_BRIDGE_STATUS_CRC_ERROR;
+        return;
+    }
+
+    if (message->type == COOP_BRIDGE_MESSAGE_SESSION_READY)
+    {
+        if (message->session_epoch == 0
+         || (gCoopNetBridge.session_epoch != 0
+          && !IsSequenceNewer(message->session_epoch, gCoopNetBridge.session_epoch)))
+            return;
+
+        /* A fresh session may restart its per-session message sequence. */
+        gCoopNetBridge.session_epoch = message->session_epoch;
+        gCoopNetBridge.rx_sequence = message->sequence;
+        gCoopNetBridge.status |= COOP_BRIDGE_STATUS_SESSION_READY;
+        gCoopNetBridge.last_heartbeat_frame = 0;
+        gCoopNetBridge.last_snapshot_frame = 0;
+        return;
+    }
+
+    if ((gCoopNetBridge.status & COOP_BRIDGE_STATUS_SESSION_READY) == 0
+     || message->session_epoch != gCoopNetBridge.session_epoch
+     || !IsSequenceNewer(message->sequence, gCoopNetBridge.rx_sequence))
+        return;
+
+    gCoopNetBridge.rx_sequence = message->sequence;
+}
+
+void CoopNetBridge_Init(void)
+{
+    memset(&gCoopNetBridge, 0, sizeof(gCoopNetBridge));
+    CoopProgress_Init(&gCoopProgress);
+    CoopBridgeQueue_Init(&gCoopNetBridge.game_to_network);
+    CoopBridgeQueue_Init(&gCoopNetBridge.network_to_game);
+    gCoopNetBridge.magic = COOP_NET_BRIDGE_MAGIC;
+    gCoopNetBridge.abi_version = COOP_NET_BRIDGE_ABI_VERSION;
+    gCoopNetBridge.tx_sequence = 1;
+    gCoopNetBridge.status = COOP_BRIDGE_STATUS_INITIALIZED;
+
+    if (CoopNetBridge_EnqueueGameToNetwork(COOP_BRIDGE_MESSAGE_ROM_READY, 0, NULL, 0))
+        gCoopNetBridge.status |= COOP_BRIDGE_STATUS_ROM_READY_SENT;
+}
+
+void CoopNetBridge_Poll(void)
+{
+    struct CoopBridgeMessage message;
+
+    if ((gCoopNetBridge.status & COOP_BRIDGE_STATUS_INITIALIZED) == 0)
+        return;
+
+    gCoopNetBridge.frame_counter++;
+    while (CoopBridgeQueue_PopUnchecked(&gCoopNetBridge.network_to_game, &message))
+        ProcessInboundMessage(&message);
+
+    if ((gCoopNetBridge.status & COOP_BRIDGE_STATUS_SESSION_READY) == 0)
+        return;
+
+    if (gCoopNetBridge.last_heartbeat_frame == 0
+     || gCoopNetBridge.frame_counter - gCoopNetBridge.last_heartbeat_frame >= COOP_NET_BRIDGE_HEARTBEAT_INTERVAL)
+    {
+        if (!SendHeartbeat())
+            gCoopNetBridge.status |= COOP_BRIDGE_STATUS_QUEUE_ERROR;
+    }
+
+    if (gCoopNetBridge.last_snapshot_frame == 0
+     || gCoopNetBridge.frame_counter - gCoopNetBridge.last_snapshot_frame >= COOP_NET_BRIDGE_SNAPSHOT_INTERVAL)
+    {
+        if (!SendWorldSnapshot())
+            gCoopNetBridge.status |= COOP_BRIDGE_STATUS_QUEUE_ERROR;
+    }
+}
diff --git a/src/coop/progress.c b/src/coop/progress.c
new file mode 100644
index 0000000000000000000000000000000000000000..afcc625654372db05af5d7b19e47cd51a8c815af
--- /dev/null
+++ b/src/coop/progress.c
@@ -0,0 +1,108 @@
+#include "global.h"
+#include "coop/progress.h"
+
+EWRAM_DATA struct CoopProgress gCoopProgress = {0};
+
+static s32 GetRegionSlot(enum CoopRegion region)
+{
+    switch (region)
+    {
+    case COOP_REGION_HOENN:
+        return 0;
+    case COOP_REGION_KANTO:
+        return 1;
+    case COOP_REGION_JOHTO:
+        return 2;
+    case COOP_REGION_SEVII:
+        return 3;
+    default:
+        return -1;
+    }
+}
+
+void CoopProgress_Init(struct CoopProgress *progress)
+{
+    u32 i;
+
+    if (progress == NULL)
+        return;
+
+    for (i = 0; i < COOP_PROGRESS_REGION_COUNT; i++)
+    {
+        progress->regions[i].badge_mask = 0;
+        progress->regions[i].story_checkpoint = 0;
+        progress->regions[i].defeated_trainer_mask = 0;
+        progress->regions[i].unlocked_fly_point_mask = 0;
+    }
+}
+
+struct RegionalProgress *CoopProgress_GetRegion(struct CoopProgress *progress, enum CoopRegion region)
+{
+    s32 slot;
+
+    if (progress == NULL)
+        return NULL;
+
+    slot = GetRegionSlot(region);
+    if (slot < 0)
+        return NULL;
+    return &progress->regions[slot];
+}
+
+const struct RegionalProgress *CoopProgress_GetRegionConst(const struct CoopProgress *progress, enum CoopRegion region)
+{
+    s32 slot;
+
+    if (progress == NULL)
+        return NULL;
+
+    slot = GetRegionSlot(region);
+    if (slot < 0)
+        return NULL;
+    return &progress->regions[slot];
+}
+
+u8 CoopProgress_GetBadgeTier(const struct RegionalProgress *progress)
+{
+    u16 badges;
+    u8 tier = 0;
+
+    if (progress == NULL)
+        return 0;
+
+    badges = progress->badge_mask & COOP_PROGRESS_BADGE_MASK;
+    while (badges != 0)
+    {
+        tier += (u8)(badges & 1);
+        badges >>= 1;
+    }
+    return tier;
+}
+
+u8 CoopProgress_GetMinimumTier(enum CoopRegion battle_region,
+                               const struct CoopProgress *participants,
+                               u8 participant_count)
+{
+    u8 i;
+    u8 minimum = COOP_PROGRESS_BADGE_COUNT;
+
+    if (!CoopRegion_IsValid(battle_region)
+     || participants == NULL
+     || participant_count == 0
+     || participant_count > COOP_PROGRESS_MAX_PARTICIPANTS)
+        return 0;
+
+    for (i = 0; i < participant_count; i++)
+    {
+        const struct RegionalProgress *progress = CoopProgress_GetRegionConst(&participants[i], battle_region);
+        u8 tier;
+
+        if (progress == NULL)
+            return 0;
+
+        tier = CoopProgress_GetBadgeTier(progress);
+        if (tier < minimum)
+            minimum = tier;
+    }
+    return minimum;
+}
diff --git a/src/coop/region.c b/src/coop/region.c
new file mode 100644
index 0000000000000000000000000000000000000000..bf75989c6c24f6bd80f54695b783dd5713002d1d
--- /dev/null
+++ b/src/coop/region.c
@@ -0,0 +1,128 @@
+#include "global.h"
+#include "coop/region.h"
+#include "constants/region_map_sections.h"
+#include "field_player_avatar.h"
+#include "regions.h"
+
+static bool8 IsKnownMapSection(u32 section_id)
+{
+    /* MAPSEC_NONE is the generated sentinel, not a valid location. */
+    return section_id < MAPSEC_NONE;
+}
+
+enum CoopRegion CoopRegion_FromEngineRegion(enum Region region)
+{
+    switch (region)
+    {
+    case REGION_HOENN:
+        return COOP_REGION_HOENN;
+    case REGION_KANTO:
+        return COOP_REGION_KANTO;
+    case REGION_JOHTO:
+        return COOP_REGION_JOHTO;
+    default:
+        return COOP_REGION_UNSPECIFIED;
+    }
+}
+
+enum CoopRegion CoopRegion_FromSectionId(u32 section_id)
+{
+    if (!IsKnownMapSection(section_id))
+        return COOP_REGION_UNSPECIFIED;
+
+    if (section_id >= KANTO_MAPSEC_START && section_id < MAPSEC_SPECIAL_AREA)
+    {
+        if (GetKantoSubregion(section_id) != KANTO_SUBREGION_KANTO)
+            return COOP_REGION_SEVII;
+        return COOP_REGION_KANTO;
+    }
+
+    /* All remaining generated sections are Hoenn, including special areas. */
+    return COOP_REGION_HOENN;
+}
+
+bool8 CoopRegion_Normalize(enum CoopRegion *out, enum Region engine_region, u32 section_id)
+{
+    enum CoopRegion section_region;
+
+    if (out == NULL)
+        return FALSE;
+
+    switch (engine_region)
+    {
+    case REGION_JOHTO:
+        /* Johto has no map sections in this engine yet. */
+        *out = COOP_REGION_JOHTO;
+        return TRUE;
+    case REGION_HOENN:
+        section_region = CoopRegion_FromSectionId(section_id);
+        if (section_region != COOP_REGION_HOENN)
+            return FALSE;
+        *out = section_region;
+        return TRUE;
+    case REGION_KANTO:
+        section_region = CoopRegion_FromSectionId(section_id);
+        if (section_region != COOP_REGION_KANTO && section_region != COOP_REGION_SEVII)
+            return FALSE;
+        *out = section_region;
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+bool8 CoopRegion_TryFromSectionId(enum CoopRegion *out, u32 section_id)
+{
+    enum CoopRegion region;
+
+    if (out == NULL)
+        return FALSE;
+
+    region = CoopRegion_FromSectionId(section_id);
+    if (region == COOP_REGION_UNSPECIFIED)
+        return FALSE;
+
+    *out = region;
+    return TRUE;
+}
+
+bool8 CoopRegion_IsValid(enum CoopRegion region)
+{
+    return region >= COOP_REGION_HOENN && region < COOP_REGION_COUNT;
+}
+
+bool8 CoopWorldLocation_Export(struct WorldLocation *out)
+{
+    enum CoopRegion region;
+    s32 map_group;
+    s32 map_number;
+    s16 x;
+    s16 y;
+
+    if (out == NULL || gSaveBlock1Ptr == NULL)
+        return FALSE;
+
+    if (gPlayerAvatar.objectEventId >= OBJECT_EVENTS_COUNT)
+        return FALSE;
+
+    region = CoopRegion_FromSectionId(gMapHeader.regionMapSectionId);
+    if (!CoopRegion_IsValid(region))
+        return FALSE;
+
+    /* SaveBlock's map components are signed engine fields; reject sentinels
+     * before widening them into the unsigned bridge representation. */
+    map_group = gSaveBlock1Ptr->location.mapGroup;
+    map_number = gSaveBlock1Ptr->location.mapNum;
+    if (map_group < 0 || map_group > 0xFFFF || map_number < 0 || map_number > 0xFFFF)
+        return FALSE;
+
+    PlayerGetDestCoords(&x, &y);
+
+    out->region = (u8)region;
+    out->reserved = 0;
+    out->map_group = (u16)map_group;
+    out->map_number = (u16)map_number;
+    out->x = x;
+    out->y = y;
+    return TRUE;
+}
