+    ///
+    /// # Errors
+    ///
+    /// Returns an error when `value` is zero.
+    pub fn new(value: u16) -> Result<Self, IdError> {
+        if value == 1 {
+            Ok(Self(value))
+        } else {
+            Err(IdError::UnsupportedVersion(value))
+        }
+    }
