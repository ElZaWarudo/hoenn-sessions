+/// A content-addressed file in a snapshot.
+#[derive(Clone, Debug, Eq, PartialEq, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct SnapshotFile {
+    pub artifact: ArtifactIdentity,
+    pub sha256: Sha256Digest,
+    pub size_bytes: u64,
+}
