+#[tokio::test]
+async fn cancellation_drop_kills_delayed_descendant_before_marker() {
+    let directory = tempfile::tempdir().expect("temporary directory");
+    let (marker, args) = delayed_descendant(&directory, true);
+    let supervisor = MgbaSupervisor::spawn(&command_path(), &args).expect("contained root starts");
+    let task = tokio::spawn(async move { supervisor.wait().await });
+    tokio::task::yield_now().await;
+    task.abort();
+    let _ = task.await;
+    tokio::time::sleep(Duration::from_secs(2)).await;
+    assert!(!marker.exists());
+}
