+#[test]
+fn probe_timeout_kills_delayed_descendant_before_marker() {
+    let directory = tempfile::tempdir().expect("temporary directory");
+    let (marker, args) = delayed_descendant(&directory, true);
+    let error = probe(&command_path(), &args, Duration::from_millis(150))
+        .expect_err("held root exceeds probe deadline");
+    assert!(matches!(
+        error,
+        coop_launcher::windows_mgba_supervisor::ProbeFailure::Timeout
+    ));
+    thread::sleep(Duration::from_secs(2));
+    assert!(!marker.exists());
+}
