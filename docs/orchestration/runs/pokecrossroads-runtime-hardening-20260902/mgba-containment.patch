+#![cfg(windows)]
+
+use std::{fs, path::PathBuf, process::Stdio, thread, time::Duration};
+
+use coop_launcher::windows_mgba_supervisor::{MgbaSupervisor, ProbeOutput, probe};
+use tempfile::TempDir;
+
+fn command_path() -> PathBuf {
+    PathBuf::from(std::env::var_os("SystemRoot").unwrap_or_else(|| "C:\\Windows".into()))
+        .join("System32")
+        .join("cmd.exe")
+}
+
+fn delayed_descendant(directory: &TempDir, hold_root: bool) -> (PathBuf, Vec<String>) {
+    let marker = directory.path().join("descendant-marker");
+    let marker_text = marker.to_str().expect("temporary path is valid");
+    let child_script = directory.path().join("descendant.cmd");
+    fs::write(
+        &child_script,
+        format!("@echo off\r\nping -n 2 127.0.0.1 >nul\r\necho descendant>{marker_text}\r\n"),
+    )
+    .expect("delayed descendant script is writable");
+    let child_script = child_script
+        .to_str()
+        .expect("temporary script path is valid");
+    let script = if hold_root {
+        format!("start /B cmd.exe /D /C {child_script} & ping -n 30 127.0.0.1 >nul")
+    } else {
+        format!("start /B cmd.exe /D /C {child_script}")
+    };
+    (marker, vec!["/D".into(), "/C".into(), script])
+}
+
+#[tokio::test]
+async fn contained_process_waits_and_reaps() {
+    let supervisor = MgbaSupervisor::spawn(&command_path(), &["/C".into(), "exit 0".into()])
+        .expect("contained command starts");
+    let status = supervisor.wait().await.expect("contained command reaps");
+    assert!(status.success());
+    assert!(supervisor.try_wait().expect("status snapshot").is_some());
+}
+
+#[test]
+fn probe_captures_bounded_output_inside_job() {
+    let output = probe(
+        &command_path(),
+        &["/C".into(), "echo mGBA 0.10.5".into()],
+        Duration::from_secs(2),
+    )
+    .expect("contained probe completes");
+    let ProbeOutput { status, stdout, .. } = output;
+    assert!(status.success());
+    assert!(String::from_utf8_lossy(&stdout).contains("mGBA 0.10.5"));
+}
