+    let mut root = std::process::Command::new(command_path())
+        .args(args)
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()
+        .expect("fixture root starts");
+    root.wait().expect("fixture root reaps");
+    thread::sleep(Duration::from_secs(2));
+    assert!(marker.exists());
