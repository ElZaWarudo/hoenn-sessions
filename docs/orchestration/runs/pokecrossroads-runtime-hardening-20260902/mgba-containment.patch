+++ b/coop/crates/coop-launcher/src/windows_mgba_supervisor.rs
@@ -0,0 +1,623 @@
+//! Windows-only mGBA process containment.
+//!
+//! `windows-spawn` owns the `CreateProcessW` transaction and attaches the
+//! caller-provided Job through `PROC_THREAD_ATTRIBUTE_JOB_LIST`.  This module
+//! keeps that crate's blocking `Child` and `Job` values on one dedicated
+//! thread.  Tokio sees only a bounded command channel and one-shot replies;
+//! dropping the boundary synchronously asks that thread to terminate the Job
+//! and joins it before ownership is released.
+
+use std::{
+    io::{self, Read},
+    path::Path,
+    process::ExitStatus,
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicBool, Ordering},
+        mpsc as std_mpsc,
+    },
+    thread,
+    time::{Duration, Instant},
+};
+
+use tokio::sync::{mpsc, oneshot};
+use windows_spawn::{
+    Child, ChildStderr, ChildStdout, Command, DropPolicy, Job, SpawnOptions, Stdio,
+};
+
+const COMMAND_CAPACITY: usize = 8;
+const POLL_INTERVAL: Duration = Duration::from_millis(10);
+const STARTUP_TIMEOUT: Duration = Duration::from_secs(5);
+const TERMINATION_TIMEOUT: Duration = Duration::from_secs(5);
+const PROBE_OUTPUT_BYTES: usize = 64 * 1024;
+
+#[derive(Debug)]
+pub struct MgbaSupervisor {
+    commands: mpsc::Sender<SupervisorCommand>,
+    state: Arc<Mutex<Option<ExitStatus>>>,
+    shutdown: Arc<AtomicBool>,
+    join: Option<thread::JoinHandle<()>>,
+}
+
+enum SupervisorCommand {
+    Wait {
+        reply: oneshot::Sender<io::Result<ExitStatus>>,
+    },
+    Stop {
+        reply: oneshot::Sender<io::Result<()>>,
+    },
+    Shutdown,
+}
+
+#[derive(Debug)]
+pub struct ProbeOutput {
+    pub status: ExitStatus,
+    pub stdout: Vec<u8>,
+    pub stderr: Vec<u8>,
+}
+
+#[derive(Debug)]
+pub enum ProbeFailure {
+    Spawn(io::Error),
+    Output(io::Error),
+    OutputTooLarge,
+    Timeout,
+    Cleanup(io::Error),
+}
+
+impl MgbaSupervisor {
+    /// Creates one contained, long-lived mGBA process.
+    ///
+    /// The process is not returned until its Job has been created, configured
+    /// kill-on-close, and attached to the creation transaction.  The caller
+    /// therefore cannot observe an uncontained process handle.
+    ///
+    /// # Errors
+    ///
+    /// Returns an I/O error when the supervisor thread or contained process
+    /// cannot be created.
+    pub fn spawn(path: &Path, args: &[String]) -> io::Result<Self> {
+        let path = path.to_owned();
+        let args = args.to_vec();
+        let (commands, mut command_receiver) = mpsc::channel(COMMAND_CAPACITY);
+        let (ready_sender, ready_receiver) = std_mpsc::sync_channel(1);
+        let state = Arc::new(Mutex::new(None));
+        let thread_state = Arc::clone(&state);
+        let shutdown = Arc::new(AtomicBool::new(false));
+        let thread_shutdown = Arc::clone(&shutdown);
+        let join = thread::Builder::new()
+            .name("coop-mgba-supervisor".to_owned())
+            .spawn(move || {
+                supervisor_thread(
+                    &path,
+                    &args,
+                    &mut command_receiver,
+                    &ready_sender,
+                    &thread_state,
+                    &thread_shutdown,
+                );
+            })
+            .map_err(io::Error::other)?;
+
+        match ready_receiver.recv_timeout(STARTUP_TIMEOUT) {
+            Ok(Ok(())) => Ok(Self {
+                commands,
+                state,
+                shutdown,
+                join: Some(join),
+            }),
+            Ok(Err(error)) => {
+                let _ = join.join();
+                Err(error)
+            }
+            Err(error) => {
+                let _ = commands.try_send(SupervisorCommand::Shutdown);
+                let _ = join.join();
+                Err(io::Error::new(io::ErrorKind::TimedOut, error.to_string()))
+            }
+        }
+    }
+
+    /// Waits for the contained root and asks Windows to terminate all Job
+    /// descendants before returning.
+    ///
+    /// `windows-spawn` exposes no descendant-count wait primitive. The root
+    /// handle is reaped with `Child::try_wait`, while `Job::terminate` uses
+    /// Windows' `TerminateJobObject` contract to terminate every process in
+    /// that Job. The retained-descendant marker tests exercise this complete
+    /// tree guarantee after the root has exited.
+    ///
+    /// # Errors
+    ///
+    /// Returns an I/O error when the supervisor boundary closes unexpectedly
+    /// or the root process cannot be reaped.
+    pub async fn wait(&self) -> io::Result<ExitStatus> {
+        let (reply, receiver) = oneshot::channel();
+        self.commands
+            .send(SupervisorCommand::Wait { reply })
+            .await
+            .map_err(|_| io::Error::new(io::ErrorKind::BrokenPipe, "mGBA supervisor closed"))?;
+        receiver
+            .await
+            .map_err(|_| io::Error::new(io::ErrorKind::BrokenPipe, "mGBA supervisor dropped"))?
+    }
+
+    /// Requests bounded Job termination and joins the supervisor thread.
+    ///
+    /// # Errors
+    ///
+    /// Returns an I/O error when the supervisor boundary closes unexpectedly
+    /// or Job termination cannot be confirmed.
+    pub async fn stop(&mut self) -> io::Result<()> {
+        let (reply, receiver) = oneshot::channel();
+        self.commands
+            .send(SupervisorCommand::Stop { reply })
+            .await
+            .map_err(|_| io::Error::new(io::ErrorKind::BrokenPipe, "mGBA supervisor closed"))?;
+        let result = receiver
+            .await
+            .map_err(|_| io::Error::new(io::ErrorKind::BrokenPipe, "mGBA supervisor dropped"))?;
+        self.join_thread();
+        result
+    }
+
+    /// Synchronously terminates the Job and joins the owner thread.  This is
+    /// used only from cancellation/drop paths where awaiting is impossible.
+    pub fn shutdown_sync(&mut self) {
+        self.shutdown.store(true, Ordering::Release);
+        let _ = self.commands.try_send(SupervisorCommand::Shutdown);
+        self.join_thread();
+    }
+
+    /// A nonblocking status snapshot retained for test and event diagnostics.
+    ///
+    /// # Errors
+    ///
+    /// Returns an I/O error when the supervisor state lock is poisoned.
+    pub fn try_wait(&self) -> io::Result<Option<ExitStatus>> {
+        self.state
+            .lock()
+            .map(|state| *state)
+            .map_err(|_| io::Error::other("mGBA supervisor state poisoned"))
+    }
+
+    fn join_thread(&mut self) {
+        if let Some(join) = self.join.take() {
+            let _ = join.join();
+        }
+    }
+}
+
+impl Drop for MgbaSupervisor {
+    fn drop(&mut self) {
+        // The command is bounded and the join is mandatory: a supervisor may
+        // not outlive the launcher that owns its process and Job handles.
+        self.shutdown.store(true, Ordering::Release);
+        let _ = self.commands.try_send(SupervisorCommand::Shutdown);
+        self.join_thread();
+    }
+}
+
+fn supervisor_thread(
+    path: &Path,
+    args: &[String],
+    commands: &mut mpsc::Receiver<SupervisorCommand>,
+    ready: &std_mpsc::SyncSender<io::Result<()>>,
+    state: &Arc<Mutex<Option<ExitStatus>>>,
+    shutdown: &Arc<AtomicBool>,
+) {
+    let job = match Job::create().and_then(|job| {
+        job.set_kill_on_close(true)?;
+        Ok(job)
+    }) {
+        Ok(job) => job,
+        Err(error) => {
+            let _ = ready.send(Err(error));
+            return;
+        }
+    };
+    let mut command = Command::new(path);
+    configure_command(&mut command, args, false);
+    let mut child = match command.spawn_with(
+        SpawnOptions::new()
+            .job(&job)
+            .drop_policy(DropPolicy::KillTree),
+    ) {
+        Ok(child) => child,
+        Err(error) => {
+            let _ = ready.send(Err(error));
+            return;
+        }
+    };
+    let _ = ready.send(Ok(()));
+    let mut pending_waits: Vec<oneshot::Sender<io::Result<ExitStatus>>> =
+        Vec::with_capacity(COMMAND_CAPACITY);
+    let mut finished = None;
+
+    loop {
+        if shutdown.load(Ordering::Acquire) {
+            if finished.is_none() {
+                let _ = terminate_job(&mut child, &job);
+            }
+            return;
+        }
+        if finished.is_none() {
+            match child.try_wait() {
+                Ok(Some(status)) => {
+                    let result = terminate_job(&mut child, &job).map(|_| status);
+                    if let Ok(status) = result.as_ref()
+                        && let Ok(mut current) = state.lock()
+                    {
+                        *current = Some(*status);
+                    }
+                    for reply in pending_waits.drain(..) {
+                        let _ = reply.send(result.clone_result());
+                    }
+                    finished = Some(result);
+                }
+                Ok(None) => {}
+                Err(error) => {
+                    let result = Err(error);
+                    for reply in pending_waits.drain(..) {
+                        let _ = reply.send(result.clone_result());
+                    }
+                    finished = Some(result);
+                }
+            }
+        }
+
+        if process_supervisor_commands(
+            commands,
+            &mut finished,
+            &mut child,
+            &job,
+            &mut pending_waits,
+        ) {
+            return;
+        }
+        if commands.is_closed() && finished.is_none() {
+            let _ = terminate_job(&mut child, &job);
+            return;
+        }
+        thread::sleep(POLL_INTERVAL);
+    }
+}
+
+fn process_supervisor_commands(
+    commands: &mut mpsc::Receiver<SupervisorCommand>,
+    finished: &mut Option<io::Result<ExitStatus>>,
+    child: &mut Child,
+    job: &Job,
+    pending_waits: &mut Vec<oneshot::Sender<io::Result<ExitStatus>>>,
+) -> bool {
+    while let Ok(command) = commands.try_recv() {
+        match command {
+            SupervisorCommand::Wait { reply } => {
+                if let Some(result) = finished {
+                    let _ = reply.send(result.clone_result());
+                } else if pending_waits.len() < COMMAND_CAPACITY {
+                    pending_waits.push(reply);
+                } else {
+                    let _ = reply.send(Err(io::Error::new(
+                        io::ErrorKind::WouldBlock,
+                        "mGBA wait queue is full",
+                    )));
+                }
+            }
+            SupervisorCommand::Stop { reply } => {
+                let result = if let Some(result) = finished {
+                    result.clone_result().map(|_| ())
+                } else {
+                    terminate_job(child, job).map(|_| ())
+                };
+                let _ = reply.send(result.clone_result());
+                for reply in pending_waits.drain(..) {
+                    let _ = reply.send(Err(io::Error::new(
+                        io::ErrorKind::Interrupted,
+                        "mGBA stopped before wait completed",
+                    )));
+                }
+                return true;
+            }
+            SupervisorCommand::Shutdown => {
+                if finished.is_none() {
+                    let _ = terminate_job(child, job);
+                }
+                return true;
+            }
+        }
+    }
+    false
+}
+
+fn configure_command(command: &mut Command, args: &[String], capture: bool) {
+    command.env_clear();
+    if let Some(path) = std::env::var_os("PATH") {
+        command.env("PATH", path);
+    }
+    command.args(args);
+    if capture {
+        command
+            .stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped());
+    } else {
+        command
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null());
+    }
+}
+
+fn terminate_job(child: &mut Child, job: &Job) -> io::Result<ExitStatus> {
+    // TerminateJobObject applies to every process currently in the Job; the
+    // polling loop only reaps the root because windows-spawn has no safe
+    // descendant wait/count API. KillTree's private Job is also closed by
+    // Child::drop after this bounded root reap.
+    job.terminate(1)?;
+    let deadline = Instant::now() + TERMINATION_TIMEOUT;
+    loop {
+        match child.try_wait() {
+            Ok(Some(status)) => break Ok(status),
+            Ok(None) if Instant::now() >= deadline => {
+                break Err(io::Error::new(
+                    io::ErrorKind::TimedOut,
+                    "mGBA Job termination timed out",
+                ));
+            }
+            Ok(None) => thread::sleep(POLL_INTERVAL),
+            Err(error) => break Err(error),
+        }
+    }
+}
+
+trait CloneResult<T> {
+    fn clone_result(&self) -> io::Result<T>;
+}
+
+impl CloneResult<()> for io::Result<()> {
+    fn clone_result(&self) -> io::Result<()> {
+        match self {
+            Ok(()) => Ok(()),
+            Err(error) => Err(io::Error::new(error.kind(), error.to_string())),
+        }
+    }
+}
+
+impl CloneResult<ExitStatus> for io::Result<ExitStatus> {
+    fn clone_result(&self) -> io::Result<ExitStatus> {
+        match self {
+            Ok(status) => Ok(*status),
+            Err(error) => Err(io::Error::new(error.kind(), error.to_string())),
+        }
+    }
+}
+
+/// Runs the short `--version` command in its own contained supervisor thread.
+/// The same Job boundary as gameplay is used, including for output overflow,
+/// timeout, and a root that leaves a pipe-owning descendant behind.
+///
+/// # Errors
+///
+/// Returns a [`ProbeFailure`] when process creation, bounded output capture,
+/// timeout handling, or contained cleanup fails.
+pub fn probe(path: &Path, args: &[String], timeout: Duration) -> Result<ProbeOutput, ProbeFailure> {
+    let path = path.to_owned();
+    let args = args.to_vec();
+    let (result_sender, result_receiver) = std_mpsc::sync_channel(1);
+    let (abort_sender, abort_receiver) = std_mpsc::sync_channel(1);
+    let join = thread::Builder::new()
+        .name("coop-mgba-probe-supervisor".to_owned())
+        .spawn(move || {
+            probe_thread(&path, &args, timeout, &abort_receiver, &result_sender);
+        })
+        .map_err(ProbeFailure::Spawn)?;
+    if let Ok(result) = result_receiver.recv_timeout(timeout + Duration::from_secs(1)) {
+        let _ = join.join();
+        result
+    } else {
+        let _ = abort_sender.send(());
+        let _ = join.join();
+        Err(ProbeFailure::Timeout)
+    }
+}
+
+struct ReaderResult {
+    stderr: bool,
+    bytes: Vec<u8>,
+    oversized: bool,
+    error: Option<io::Error>,
+}
+
+fn probe_thread(
+    path: &Path,
+    args: &[String],
+    timeout: Duration,
+    abort: &std_mpsc::Receiver<()>,
+    result_sender: &std_mpsc::SyncSender<Result<ProbeOutput, ProbeFailure>>,
+) {
+    let (mut child, job, stdout, stderr) = match spawn_probe_child(path, args) {
+        Ok(value) => value,
+        Err(error) => {
+            let _ = result_sender.send(Err(error));
+            return;
+        }
+    };
+    let (reader_sender, reader_receiver) = std_mpsc::sync_channel(2);
+    let stdout_join = spawn_reader(stdout, false, reader_sender.clone());
+    let stderr_join = spawn_reader(stderr, true, reader_sender);
+    let (status, mut outputs, failure) = poll_probe(&mut child, timeout, abort, &reader_receiver);
+
+    // The root is either still live or has exited.  Terminating the Job in
+    // both cases handles retained pipe handles without any PID-based helper.
+    let termination = terminate_job(&mut child, &job);
+    // Closing the Child's private kill-on-close Job before joining readers is
+    // the final bounded cleanup barrier. TerminateJobObject terminates every
+    // process in the supplied Job; DropPolicy::KillTree supplies an
+    // independent kill-on-close Job if that explicit call reports an error.
+    drop(child);
+    drop(job);
+    let _ = stdout_join.join();
+    let _ = stderr_join.join();
+    while let Ok(output) = reader_receiver.try_recv() {
+        outputs.push(output);
+    }
+    let _ = result_sender.send(finish_probe(status, termination, outputs, failure));
+}
+
+fn spawn_probe_child(
+    path: &Path,
+    args: &[String],
+) -> Result<(Child, Job, ChildStdout, ChildStderr), ProbeFailure> {
+    let job = Job::create()
+        .and_then(|job| {
+            job.set_kill_on_close(true)?;
+            Ok(job)
+        })
+        .map_err(ProbeFailure::Spawn)?;
+    let mut command = Command::new(path);
+    configure_command(&mut command, args, true);
+    let mut child = command
+        .spawn_with(
+            SpawnOptions::new()
+                .job(&job)
+                .drop_policy(DropPolicy::KillTree),
+        )
+        .map_err(ProbeFailure::Spawn)?;
+    let Some(stdout) = child.stdout.take() else {
+        let _ = terminate_job(&mut child, &job);
+        return Err(ProbeFailure::Output(io::Error::other(
+            "mGBA stdout pipe unavailable",
+        )));
+    };
+    let Some(stderr) = child.stderr.take() else {
+        let _ = terminate_job(&mut child, &job);
+        return Err(ProbeFailure::Output(io::Error::other(
+            "mGBA stderr pipe unavailable",
+        )));
+    };
+    Ok((child, job, stdout, stderr))
+}
+
+fn poll_probe(
+    child: &mut Child,
+    timeout: Duration,
+    abort: &std_mpsc::Receiver<()>,
+    reader_receiver: &std_mpsc::Receiver<ReaderResult>,
+) -> (Option<ExitStatus>, Vec<ReaderResult>, Option<ProbeFailure>) {
+    let deadline = Instant::now() + timeout;
+    let mut status = None;
+    let mut outputs = Vec::with_capacity(2);
+    let mut failure = None;
+    loop {
+        if abort.try_recv().is_ok() {
+            failure = Some(ProbeFailure::Timeout);
+            break;
+        }
+        while let Ok(output) = reader_receiver.try_recv() {
+            if output.oversized {
+                failure = Some(ProbeFailure::OutputTooLarge);
+                break;
+            }
+            if let Some(error) = output.error {
+                failure = Some(ProbeFailure::Output(error));
+                break;
+            }
+            outputs.push(output);
+        }
+        if failure.is_some() {
+            break;
+        }
+        match child.try_wait() {
+            Ok(Some(root_status)) => {
+                status = Some(root_status);
+                break;
+            }
+            Ok(None) if Instant::now() >= deadline => {
+                failure = Some(ProbeFailure::Timeout);
+                break;
+            }
+            Ok(None) => thread::sleep(POLL_INTERVAL),
+            Err(error) => {
+                failure = Some(ProbeFailure::Cleanup(error));
+                break;
+            }
+        }
+    }
+    (status, outputs, failure)
+}
+
+fn finish_probe(
+    status: Option<ExitStatus>,
+    termination: io::Result<ExitStatus>,
+    outputs: Vec<ReaderResult>,
+    failure: Option<ProbeFailure>,
+) -> Result<ProbeOutput, ProbeFailure> {
+    if let Some(failure) = failure {
+        return Err(failure);
+    }
+    let Some(status) = status else {
+        return Err(ProbeFailure::Cleanup(io::Error::other(
+            "mGBA probe status unavailable",
+        )));
+    };
+    termination.map_err(ProbeFailure::Cleanup)?;
+    let mut stdout = None;
+    let mut stderr = None;
+    for output in outputs {
+        let destination = if output.stderr {
+            &mut stderr
+        } else {
+            &mut stdout
+        };
+        if destination.replace(output.bytes).is_some() {
+            return Err(ProbeFailure::Output(io::Error::other(
+                "duplicate mGBA output stream",
+            )));
+        }
+    }
+    let stdout = stdout
+        .ok_or_else(|| ProbeFailure::Output(io::Error::other("mGBA stdout output unavailable")))?;
+    let stderr = stderr
+        .ok_or_else(|| ProbeFailure::Output(io::Error::other("mGBA stderr output unavailable")))?;
+    Ok(ProbeOutput {
+        status,
+        stdout,
+        stderr,
+    })
+}
+
+fn spawn_reader<R: Read + Send + 'static>(
+    mut reader: R,
+    stderr: bool,
+    sender: std_mpsc::SyncSender<ReaderResult>,
+) -> thread::JoinHandle<()> {
+    thread::spawn(move || {
+        let mut bytes = Vec::with_capacity(PROBE_OUTPUT_BYTES);
+        let mut buffer = [0_u8; 4096];
+        let mut oversized = false;
+        let mut error = None;
+        loop {
+            match reader.read(&mut buffer) {
+                Ok(0) => break,
+                Ok(count) => {
+                    if bytes.len().saturating_add(count) > PROBE_OUTPUT_BYTES {
+                        oversized = true;
+                        break;
+                    }
+                    bytes.extend_from_slice(&buffer[..count]);
+                }
+                Err(read_error) => {
+                    error = Some(read_error);
+                    break;
+                }
+            }
+        }
+        let _ = sender.send(ReaderResult {
+            stderr,
+            bytes,
+            oversized,
+            error,
+        });
+    })
+}
